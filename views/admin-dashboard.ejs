                            <div id="heroPreview" class="img-preview-strip"></div>
                            <input type="text" name="hero_image" value="<%= settings.hero_image || '' %>" placeholder="Or paste Hero Image URL">
                        </div>

                        <h3 style="margin-top:28px;">2. Brand Identity, Logo & Footer Editor</h3>
                        <div class="form-row">
                            <div class="form-group"><label>Brand Name Part 1</label><input type="text" name="brand_name_first" value="<%= settings.brand_name_first %>"></div>
                            <div class="form-group"><label>Brand Name Part 2 (Accent)</label><input type="text" name="brand_name_second" value="<%= settings.brand_name_second %>"></div>
                            <div class="form-group"><label>Slogan (EN)</label><input type="text" name="tagline_en" value="<%= settings.tagline_en %>"></div>
                            <div class="form-group"><label>Slogan (বাংলা)</label><input type="text" name="tagline_bn" value="<%= settings.tagline_bn %>"></div>
                        </div>
                        <div class="upload-box">
                            <label>🖼️ Upload Brand Logo (PNG/SVG/JPG)</label>
                            <input type="file" name="logo_file" accept="image/*" onchange="previewUploadedFiles(this, 'logoPreview')">
                            <div id="logoPreview" class="img-preview-strip"></div>
                            <input type="text" name="logo_light" value="<%= settings.logo_light || '' %>" placeholder="Or paste Logo URL">
                        </div>
                        <div class="form-row">
                            <div class="form-group"><label>Footer About Summary</label><input type="text" name="footer_about_en" value="<%= settings.footer_about_en %>"></div>
                            <div class="form-group"><label>Footer Copyright Notice</label><input type="text" name="footer_copyright" value="<%= settings.footer_copyright %>"></div>
                        </div>

                        <h3 style="margin-top:28px;">3. Preserved FAQ Editor (4 Questions & Answers)</h3>
                        <div class="form-row">
                            <div class="form-group"><label>FAQ 1 Question</label><input type="text" name="faq_1_q" value="<%= settings.faq_1_q %>"></div>
                            <div class="form-group"><label>FAQ 1 Answer</label><input type="text" name="faq_1_a" value="<%= settings.faq_1_a %>"></div>
                        </div>
                        <div class="form-row">
                            <div class="form-group"><label>FAQ 2 Question</label><input type="text" name="faq_2_q" value="<%= settings.faq_2_q %>"></div>
                            <div class="form-group"><label>FAQ 2 Answer</label><input type="text" name="faq_2_a" value="<%= settings.faq_2_a %>"></div>
                        </div>
                        <div class="form-row">
                            <div class="form-group"><label>FAQ 3 Question</label><input type="text" name="faq_3_q" value="<%= settings.faq_3_q %>"></div>
                            <div class="form-group"><label>FAQ 3 Answer</label><input type="text" name="faq_3_a" value="<%= settings.faq_3_a %>"></div>
                        </div>
                        <div class="form-row">
                            <div class="form-group"><label>FAQ 4 Question</label><input type="text" name="faq_4_q" value="<%= settings.faq_4_q %>"></div>
                            <div class="form-group"><label>FAQ 4 Answer</label><input type="text" name="faq_4_a" value="<%= settings.faq_4_a %>"></div>
                        </div>

                        <h3 style="margin-top:28px;">4. Legal Policies Editor (Privacy, Returns & Terms)</h3>
                        <div class="form-group"><label>🔒 Privacy Policy</label><textarea name="privacy_policy" rows="3"><%= settings.privacy_policy %></textarea></div>
                        <div class="form-group"><label>🔄 Return & Replacement Policy</label><textarea name="return_policy" rows="3"><%= settings.return_policy %></textarea></div>
                        <div class="form-group"><label>📜 Terms & Conditions</label><textarea name="terms_conditions" rows="3"><%= settings.terms_conditions %></textarea></div>

                        <div class="form-actions-bar">
                            <button type="submit" class="btn-primary-lg">💾 Save All CMS, FAQ & Policy Settings</button>
                            <button type="reset" class="btn-outline-sm">Reset Form</button>
                        </div>
