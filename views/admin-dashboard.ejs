<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - TrendzzNow</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .action-btn-group { display: flex; gap: 6px; flex-wrap: wrap; }
        .print-btn { background-color: #0984e3; color: #fff; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .copy-btn { background-color: #00b894; color: #fff; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .edit-btn { background-color: #fdcb6e; color: #222; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .export-btn { background-color: #6c5ce7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; }
    </style>
</head>
<body class="admin-body">
    <header class="admin-header">
        <div class="admin-brand">
            <h2>⚡ TrendzzNow Master Dashboard</h2>
            <span class="live-badge">● Live Connected</span>
        </div>
        <div class="admin-header-actions">
            <a href="/" target="_blank" class="view-site-btn">🌐 View Website</a>
            <a href="/admin/logout" class="logout-btn">Logout</a>
        </div>
    </header>

    <div class="admin-container">
        <% if (msg) { %>
            <div class="success-banner">
                <span>✅ <%= msg %></span>
                <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;color:#155724;font-weight:bold;cursor:pointer;">&times;</button>
            </div>
        <% } %>

        <%
            let totalRevenue = 0;
            let pendingCount = 0;
            orders.forEach(o => {
                if (o.status !== 'Cancelled') totalRevenue += (parseFloat(o.price) || 0);
                if (!o.status || o.status === 'Pending') pendingCount++;
            });
        %>

        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-title">Total Orders</span>
                <span class="stat-num"><%= orders.length %> <small style="font-size:14px; color:#e17055;">(<%= pendingCount %> pending)</small></span>
            </div>
            <div class="stat-card">
                <span class="stat-title">Total Sales Value</span>
                <span class="stat-num" style="color:#00b894;">৳ <%= totalRevenue %></span>
            </div>
            <div class="stat-card">
                <span class="stat-title">Total Products</span>
                <span class="stat-num"><%= products.length %></span>
            </div>
            <div class="stat-card">
                <span class="stat-title">WhatsApp Hotline</span>
                <span class="stat-num" style="font-size: 18px;"><%= settings.whatsapp_number || '01731763504' %></span>
            </div>
        </div>

        <section class="admin-section">
            <div class="sec-head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:10px;">
                <h3 style="margin:0; border:none;">📦 Customer Orders (<%= orders.length %>)</h3>
                <div style="display:flex; gap:10px;">
                    <button onclick="exportOrdersCSV()" class="export-btn">📥 Export CSV (Excel)</button>
                    <button onclick="window.print()" class="print-btn" style="padding: 8px 14px; font-size: 13px;">🖨️ Print List</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="data-table" id="ordersTable">
                    <thead>
                        <tr>
                            <th>ID & Date</th>
                            <th>Customer & Phone</th>
                            <th>Product</th>
                            <th>Total</th>
                            <th>Address & Payment</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length > 0) { %>
                            <% orders.forEach(o => { 
                                const dateFormatted = o.created_at ? new Date(o.created_at).toLocaleDateString() : '-';
                            %>
                                <tr>
                                    <td><strong>#<%= o.id %></strong><br><small><%= dateFormatted %></small></td>
                                    <td>
                                        <strong><%= o.customer_name %></strong><br>
                                        <a href="tel:<%= o.phone %>" style="color:#9c1448;font-weight:600;"><%= o.phone %></a><br>
                                        <a href="https://wa.me/88<%= (o.phone || '').replace(/^\+?88/, '') %>" target="_blank" style="font-size:12px;color:#25D366;font-weight:bold;">💬 WhatsApp</a>
                                    </td>
                                    <td><strong><%= o.product_title %></strong></td>
                                    <td><span class="price-pill">৳ <%= o.price %></span></td>
                                    <td style="max-width: 240px; font-size: 13px;"><%= o.address %></td>
                                    <td>
                                        <form action="/admin/orders/status/<%= o.id %>" method="POST" style="display:flex; gap:5px;">
                                            <select name="status" class="status-select">
                                                <option value="Pending" <%= o.status === 'Pending' ? 'selected' : '' %>>⏳ Pending</option>
                                                <option value="Confirmed" <%= o.status === 'Confirmed' ? 'selected' : '' %>>✅ Confirmed</option>
                                                <option value="Sent to SteadFast" <%= o.status === 'Sent to SteadFast' ? 'selected' : '' %>>🚚 SteadFast</option>
                                                <option value="Sent to Pathao" <%= o.status === 'Sent to Pathao' ? 'selected' : '' %>>🛵 Pathao</option>
                                                <option value="Delivered" <%= o.status === 'Delivered' ? 'selected' : '' %>>🎉 Delivered</option>
                                                <option value="Cancelled" <%= o.status === 'Cancelled' ? 'selected' : '' %>>❌ Cancelled</option>
                                            </select>
                                            <button type="submit" class="mini-save-btn">Save</button>
                                        </form>
                                    </td>
                                    <td>
                                        <div class="action-btn-group">
                                            <button type="button" class="print-btn" 
                                                data-id="<%= o.id %>" data-name="<%= o.customer_name || '' %>" data-phone="<%= o.phone || '' %>"
                                                data-address="<%= o.address || '' %>" data-product="<%= o.product_title || '' %>" data-price="<%= o.price %>"
                                                onclick="printInvoiceBtn(this)">🖨️ Slip</button>
                                            <button type="button" class="copy-btn" 
                                                data-name="<%= o.customer_name || '' %>" data-phone="<%= o.phone || '' %>"
                                                data-address="<%= o.address || '' %>" data-product="<%= o.product_title || '' %>" data-price="<%= o.price %>"
                                                onclick="copyCustomerBtn(this)">📋 Copy</button>
                                            <form action="/admin/orders/delete/<%= o.id %>" method="POST" onsubmit="return confirm('Delete order?');" style="display:inline;">
                                                <button type="submit" class="delete-btn">Del</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" style="text-align: center; padding: 20px;">No orders yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="two-col-grid">
            <section class="admin-section">
                <h3>➕ Add New Product</h3>
                <form action="/admin/products/add" method="POST">
                    <div class="form-group"><label>Product Title *</label><input type="text" name="title" required placeholder="e.g. Dynamic Leaf Table Lamp"></div>
                    <div class="form-row">
                        <div class="form-group"><label>Selling Price (BDT) *</label><input type="number" name="price" required placeholder="950"></div>
                        <div class="form-group"><label>Regular Price</label><input type="number" name="regular_price" placeholder="1250"></div>
                    </div>
                    <div class="form-group"><label>Image Direct URL</label><input type="text" name="image" placeholder="https://..."></div>
                    <div class="form-group"><label>Variants (comma separated)</label><input type="text" name="variant_options" placeholder="Cream, Black, Wood"></div>
                    <div class="form-group"><label>Description</label><textarea name="description" rows="3"></textarea></div>
                    <button type="submit" class="add-product-btn">➕ Add Product</button>
                </form>
            </section>

            <section class="admin-section">
                <h3>🛍️ Existing Products (<%= products.length %>)</h3>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="data-table">
                        <thead><tr><th>Image</th><th>Name & Price</th><th>Action</th></tr></thead>
                        <tbody>
                            <% products.forEach(p => { %>
                                <tr>
                                    <td><% if (p.image) { %><img src="<%= p.image %>" width="40" height="40" style="object-fit:cover;border-radius:4px;"><% } %></td>
                                    <td><strong><%= p.title %></strong><br><span class="price-pill">৳ <%= p.price %></span></td>
                                    <td>
                                        <div style="display:flex; gap:5px;">
                                            <button type="button" class="edit-btn" data-id="<%= p.id %>" data-title="<%= p.title || '' %>" data-price="<%= p.price %>" data-regprice="<%= p.regular_price || '' %>" data-image="<%= p.image || '' %>" data-variants="<%= p.variant_options || '' %>" data-desc="<%= p.description || '' %>" onclick="populateEditBtn(this)">Edit</button>
                                            <form action="/admin/products/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete product?');"><button type="submit" class="delete-btn">Del</button></form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <section class="admin-section" id="editSection" style="display:none; background:#fff8e5; border:1px solid #ffd166;">
            <h3>✏️ Edit Product (<span id="editProductIdTitle"></span>)</h3>
            <form id="editProductForm" method="POST">
                <div class="form-group"><label>Product Title *</label><input type="text" id="editTitle" name="title" required></div>
                <div class="form-row">
                    <div class="form-group"><label>Selling Price *</label><input type="number" id="editPrice" name="price" required></div>
                    <div class="form-group"><label>Regular Price</label><input type="number" id="editRegularPrice" name="regular_price"></div>
                </div>
                <div class="form-group"><label>Image URL</label><input type="text" id="editImage" name="image"></div>
                <div class="form-group"><label>Variants</label><input type="text" id="editVariants" name="variant_options"></div>
                <div class="form-group"><label>Description</label><textarea id="editDesc" name="description" rows="2"></textarea></div>
                <div style="display:flex; gap:10px;">
                    <button type="submit" class="save-settings-btn" style="flex:1;">💾 Save Changes</button>
                    <button type="button" onclick="document.getElementById('editSection').style.display='none'" style="background:#666;color:#fff;border:none;padding:10px;border-radius:6px;cursor:pointer;">Cancel</button>
                </div>
            </form>
        </section>

        <section class="admin-section">
            <h3>⚙️ Store, Payment & Promo Settings</h3>
            <form action="/admin/settings/update" method="POST">
                <div class="form-row">
                    <div class="form-group"><label>📞 WhatsApp Number</label><input type="text" name="whatsapp_number" value="<%= settings.whatsapp_number || '01731763504' %>"></div>
                    <div class="form-group"><label>📲 bKash Number</label><input type="text" name="bkash_number" value="<%= settings.bkash_number || '01731763504' %>"></div>
                    <div class="form-group"><label>📲 Nagad Number</label><input type="text" name="nagad_number" value="<%= settings.nagad_number || '01731763504' %>"></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>🚚 Inside Dhaka (৳)</label><input type="number" name="delivery_inside_dhaka" value="<%= settings.delivery_inside_dhaka || '70' %>"></div>
                    <div class="form-group"><label>🚚 Outside Dhaka (৳)</label><input type="number" name="delivery_outside_dhaka" value="<%= settings.delivery_outside_dhaka || '130' %>"></div>
                    <div class="form-group"><label>🎟️ Promo Code</label><input type="text" name="promo_code" value="<%= settings.promo_code || 'TREND50' %>"></div>
                    <div class="form-group"><label>💰 Promo Discount (৳)</label><input type="number" name="promo_discount" value="<%= settings.promo_discount || '50' %>"></div>
                </div>
                <button type="submit" class="save-settings-btn">💾 Save All Settings</button>
            </form>
        </section>

        <section class="admin-section password-box">
            <h3>🔐 Change Admin Password Anytime</h3>
            <form action="/admin/password/change" method="POST">
                <div class="form-row">
                    <div class="form-group"><label>New Password *</label><input type="password" name="new_password" required></div>
                    <div class="form-group"><label>Confirm Password *</label><input type="password" name="confirm_password" required></div>
                </div>
                <button type="submit" class="change-pass-btn">🔑 Update Password</button>
            </form>
        </section>
    </div>

    <script>
        function populateEditBtn(btn) {
            const d = btn.dataset;
            document.getElementById('editSection').style.display = 'block';
            document.getElementById('editProductForm').action = '/admin/products/edit/' + d.id;
            document.getElementById('editProductIdTitle').innerText = '#' + d.id;
            document.getElementById('editTitle').value = d.title;
            document.getElementById('editPrice').value = d.price;
            document.getElementById('editRegularPrice').value = d.regprice;
            document.getElementById('editImage').value = d.image;
            document.getElementById('editVariants').value = d.variants;
            document.getElementById('editDesc').value = d.desc;
            window.scrollTo({ top: document.getElementById('editSection').offsetTop - 50, behavior: 'smooth' });
        }
        function printInvoiceBtn(btn) {
            const d = btn.dataset;
            const win = window.open('', '_blank', 'width=650,height=600');
            win.document.write(`<html><body style="font-family:Arial;padding:20px;"><div style="border:2px dashed #222;padding:20px;"><h2>TrendzzNow Invoice #${d.id}</h2><p><strong>Name:</strong> ${d.name}</p><p><strong>Phone:</strong> ${d.phone}</p><p><strong>Address:</strong> ${d.address}</p><p><strong>Product:</strong> ${d.product}</p><h3>Total COD: ৳${d.price}</h3></div><script>window.print();<\/script></body></html>`);
            win.document.close();
        }
        function copyCustomerBtn(btn) {
            const d = btn.dataset;
            navigator.clipboard.writeText(`Name: ${d.name}\nPhone: ${d.phone}\nAddress: ${d.address}\nProduct: ${d.product}\nTotal: ৳${d.price}`).then(() => alert('Copied!'));
        }
        function exportOrdersCSV() {
            const table = document.getElementById('ordersTable');
            let csv = [];
            for (let i = 0; i < table.rows.length; i++) {
                let row = [], cols = table.rows[i].querySelectorAll('td, th');
                for (let j = 0; j < cols.length - 1; j++) row.push('"' + cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ") + '"');
                csv.push(row.join(','));
            }
            let link = document.createElement('a');
            link.download = 'trendzznow_orders.csv';
            link.href = window.URL.createObjectURL(new Blob(["\uFEFF" + csv.join("\n")], { type: 'text/csv;charset=utf-8;' }));
            link.click();
        }
    </script>
</body>
</html>
