                                <label>Human Handoff Message (WhatsApp Escalation)</label>
                                <input type="text" name="ai_handoff_msg" value="<%= settings.ai_handoff_msg %>">
                            </div>

                            <button type="submit" class="btn-primary-lg">💾 Save AI Support Settings</button>
                        </form>

                        <div class="saas-card">
                            <h3>💬 Recent AI Customer Conversations (<%= aiConversations.length %>)</h3>
                            <div class="table-responsive" style="max-height:420px; overflow-y:auto;">
                                <table class="saas-table">
                                    <thead><tr><th>Time</th><th>Customer Query</th><th>Bot Response</th></tr></thead>
                                    <tbody>
                                        <% if (aiConversations.length > 0) { %>
                                            <% aiConversations.forEach(c => { %>
                                                <tr>
                                                    <td><small><%= c.time ? new Date(c.time).toLocaleTimeString() : '-' %></small></td>
                                                    <td><strong><%= c.query %></strong></td>
                                                    <td><small><%= c.reply %></small></td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr><td colspan="3" class="muted-empty">No customer AI chats recorded yet.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 9. SECURITY, ROLES & AUDIT LOGS PANE -->
                <section id="pane-security" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Security, Role Permissions & Administrative Audit Trail</h2>
                            <p>Manage master credentials, role-based staff accounts, and review all administrative actions</p>
                        </div>
                    </div>

                    <div class="dashboard-2col">
                        <div>
                            <div class="saas-card" style="margin-bottom:20px;">
                                <h3>🔑 Change Master Administrator Password</h3>
                                <form action="/secret-admin-panel-2026/password/change" method="POST">
                                    <div class="form-row">
                                        <div class="form-group"><label>New Password (min 6 chars) *</label><input type="password" name="new_password" required minlength="6"></div>
                                        <div class="form-group"><label>Confirm Password *</label><input type="password" name="confirm_password" required minlength="6"></div>
                                    </div>
                                    <button type="submit" class="btn-primary-sm">Update Master Password</button>
                                </form>
                            </div>

                            <div class="saas-card">
                                <h3>👥 Role-Based Staff Accounts (<%= subAdmins.length %>)</h3>
                                <form action="/secret-admin-panel-2026/subadmin/add" method="POST" style="margin-bottom:16px;">
                                    <div class="form-row">
                                        <div class="form-group"><label>Staff Name *</label><input type="text" name="sub_name" required placeholder="e.g. Rahim"></div>
                                        <div class="form-group"><label>Access Password *</label><input type="password" name="sub_pass" required></div>
                                        <div class="form-group">
                                            <label>Assigned Role</label>
                                            <select name="sub_role">
                                                <option value="OrderManager">Order Manager (No Delete)</option>
                                                <option value="InventoryStaff">Inventory & Packing Staff</option>
                                            </select>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn-primary-sm">➕ Add Staff Account</button>
                                </form>

                                <% if (subAdmins.length > 0) { %>
                                    <table class="saas-table">
                                        <thead><tr><th>Name</th><th>Role</th><th>Action</th></tr></thead>
                                        <tbody>
                                            <% subAdmins.forEach(sa => { %>
                                                <tr>
                                                    <td><strong><%= sa.name %></strong></td>
                                                    <td><span class="status-tag-sm"><%= sa.role || 'Staff' %></span></td>
                                                    <td>
                                                        <form action="/secret-admin-panel-2026/subadmin/delete" method="POST" onsubmit="return confirm('Remove staff account?');">
                                                            <input type="hidden" name="sub_name" value="<%= sa.name %>">
                                                            <button type="submit" class="btn-danger-sm">Revoke</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                <% } %>
                            </div>
                        </div>

                        <div class="saas-card">
                            <h3>🛡️ Administrative Audit Logs (<%= auditLogs.length %>)</h3>
                            <div class="table-responsive" style="max-height:540px; overflow-y:auto;">
                                <table class="saas-table">
                                    <thead><tr><th>Timestamp</th><th>Actor</th><th>Action</th><th>Details</th></tr></thead>
                                    <tbody>
                                        <% if (auditLogs.length > 0) { %>
                                            <% auditLogs.forEach(al => { %>
                                                <tr>
                                                    <td><small><%= al.timestamp ? new Date(al.timestamp).toLocaleString() : '-' %></small></td>
                                                    <td><strong><%= al.actor %></strong></td>
                                                    <td><span class="status-tag-sm"><%= al.action %></span></td>
                                                    <td><small><%= al.details %></small></td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr><td colspan="4" class="muted-empty">No administrative actions logged yet.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- Edit Product Modal -->
    <div id="editProductModal" class="modal glass-modal-backdrop">
        <div class="modal-content glass-modal" style="max-width:680px;">
            <span class="close" onclick="document.getElementById('editProductModal').style.display='none'">&times;</span>
            <h3 style="margin-top:0; color:#1e293b;">✏️ Edit Product (<span id="editProductIdTitle"></span>)</h3>
            <form id="editProductForm" method="POST" enctype="multipart/form-data">
                <div class="form-row">
                    <div class="form-group" style="flex:2;"><label>Product Title *</label><input type="text" id="editTitle" name="title" required></div>
                    <div class="form-group" style="flex:1;"><label>SKU</label><input type="text" id="editSku" name="sku"></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Category *</label><input type="text" id="editCategory" name="category" required></div>
                    <div class="form-group"><label>Subcategory</label><input type="text" id="editSubcategory" name="subcategory"></div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Selling Price (৳) *</label><input type="number" id="editPrice" name="price" required min="0"></div>
                    <div class="form-group"><label>Regular Price (৳)</label><input type="number" id="editRegularPrice" name="regular_price" min="0"></div>
                    <div class="form-group"><label>Cost Price (৳)</label><input type="number" id="editCostPrice" name="cost_price" min="0"></div>
                    <div class="form-group"><label>Stock Qty *</label><input type="number" id="editStockQty" name="stock_quantity" required min="0"></div>
                </div>
                <div class="upload-box">
                    <label>📸 Upload Additional / Replacement Images</label>
                    <input type="file" name="image_files" accept="image/*" multiple>
                    <label style="margin-top:6px;">Image URL(s)</label>
                    <input type="text" id="editImage" name="image">
                </div>
                <div class="form-row">
                    <div class="form-group"><label>Variants</label><input type="text" id="editVariants" name="variant_options"></div>
                    <div class="form-group">
                        <label>Visibility Status</label>
                        <select id="editArchived" name="is_archived">
                            <option value="false">✅ Published</option>
                            <option value="true">📁 Archived (Hidden)</option>
                        </select>
                    </div>
                </div>
                <div class="form-group"><label>Description</label><textarea id="editDesc" name="description" rows="3"></textarea></div>
                <div class="form-row">
                    <div class="form-group"><label>SEO Title</label><input type="text" id="editSeoTitle" name="seo_title"></div>
                    <div class="form-group"><label>SEO Description</label><input type="text" id="editSeoDesc" name="seo_description"></div>
                </div>
                <div style="display:flex; gap:10px;">
                    <button type="submit" class="btn-primary-lg" style="flex:1;">💾 Save Product Changes</button>
                    <button type="button" class="btn-outline-sm" onclick="document.getElementById('editProductModal').style.display='none'">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Order Details & Audit Trail Modal -->
    <div id="orderDetailModal" class="modal glass-modal-backdrop">
        <div class="modal-content glass-modal" style="max-width:600px;">
            <span class="close" onclick="document.getElementById('orderDetailModal').style.display='none'">&times;</span>
            <h3 id="odModalTitle" style="margin-top:0; color:#1e293b;">Order Details</h3>
            <div id="odModalBody" style="font-size:14px; line-height:1.6;"></div>
        </div>
    </div>

    <script>
        const CSRF_TOKEN = <%- safeJson(csrfToken || '') %>;
        function esc(s) {
            return String(s === undefined || s === null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        // Every admin form gets the CSRF token, and every admin fetch() sends it as a header.
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('form[method="POST"], form[method="post"]').forEach(function (f) {
                if (f.querySelector('input[name="_csrf"]')) return;
                var i = document.createElement('input');
                i.type = 'hidden'; i.name = '_csrf'; i.value = CSRF_TOKEN;
                f.appendChild(i);
            });
        });
        (function () {
            var nativeFetch = window.fetch;
            window.fetch = function (url, opts) {
                if (typeof url === 'string' && url.indexOf('/secret-admin-panel-2026') === 0) {
                    opts = opts || {};
                    opts.headers = Object.assign({}, opts.headers || {}, { 'x-csrf-token': CSRF_TOKEN });
                }
                return nativeFetch.call(this, url, opts);
            };
        })();
        const allProductsMap =<%- safeJson(products.reduce((acc, item) => { acc[item.id] = item; return acc; }, {})) %>;
        const allOrdersMap = <%- safeJson(orders.reduce((acc, item) => { acc[item.id] = item; return acc; }, {})) %>;
        const allOrdersArray = <%- safeJson(orders) %>;

        function switchAdminPane(paneId, btn) {
            document.querySelectorAll('.admin-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.s-nav-item').forEach(b => b.classList.remove('active'));
            const target = document.getElementById(paneId);
            if (target) target.classList.add('active');
            if (btn) {
                btn.classList.add('active');
                document.getElementById('activePaneTitle').innerText = btn.querySelector('.s-label').innerText;
            }
            if (window.innerWidth <= 900) {
                document.getElementById('saasSidebar').classList.remove('mobile-open');
            }
        }

        function toggleSidebarCollapse() {
            if (window.innerWidth <= 900) {
                document.getElementById('saasSidebar').classList.toggle('mobile-open');
            } else {
                document.getElementById('saasLayout').classList.toggle('sidebar-collapsed');
            }
        }

        function toggleMobileSidebar() {
            document.getElementById('saasSidebar').classList.remove('mobile-open');
        }

        // Unsaved Changes Detector
        document.querySelectorAll('.tracked-form').forEach(form => {
            form.addEventListener('input', () => {
                document.getElementById('unsavedBanner').style.display = 'flex';
            });
            form.addEventListener('submit', () => {
                document.getElementById('unsavedBanner').style.display = 'none';
            });
        });

        function discardUnsavedChanges() {
            document.querySelectorAll('.tracked-form').forEach(f => f.reset());
            document.getElementById('unsavedBanner').style.display = 'none';
        }

        function previewUploadedFiles(input, containerId) {
            const box = document.getElementById(containerId);
            box.innerHTML = '';
            if (!input.files) return;
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'preview-thumb-sm';
                    box.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        }

        function togglePhoneReveal(btn) {
            const codeEl = btn.parentElement.querySelector('.phone-display');
            const isMasked = codeEl.innerText.includes('*');
            codeEl.innerText = isMasked ? codeEl.getAttribute('data-raw') : codeEl.getAttribute('data-masked');
        }

        function filterDashboardByRange(days) {
            if (days === 'all') {
                document.getElementById('kpiOrders').innerText = allOrdersArray.length;
                const rev = allOrdersArray.filter(o => o.status !== 'Cancelled' && o.status !== 'Return').reduce((s, o) => s + (Number(o.price)||0), 0);
                document.getElementById('kpiRevenue').innerText = '৳ ' + rev;
                return;
            }
            const cutoff = Date.now() - (parseInt(days, 10) * 24 * 60 * 60 * 1000);
            const filtered = allOrdersArray.filter(o => o.created_at && new Date(o.created_at).getTime() >= cutoff);
            document.getElementById('kpiOrders').innerText = filtered.length;
            const rev = filtered.filter(o => o.status !== 'Cancelled' && o.status !== 'Return').reduce((s, o) => s + (Number(o.price)||0), 0);
            document.getElementById('kpiRevenue').innerText = '৳ ' + rev;
        }

        function filterOrderRows() {
            const q = (document.getElementById('orderSearchInput').value || '').toLowerCase().trim();
            const st = document.getElementById('orderStatusFilter').value;
            const pay = document.getElementById('orderPaymentFilter').value;
            const dt = document.getElementById('orderDateFilter').value;

            document.querySelectorAll('.order-tr').forEach(row => {
                const matchQ = !q || row.getAttribute('data-search').includes(q);
                const matchSt = st === 'all' || row.getAttribute('data-status') === st;
                const matchPay = pay === 'all' || row.getAttribute('data-pay') === pay;
                const matchDt = !dt || row.getAttribute('data-date') === dt;
                row.style.display = (matchQ && matchSt && matchPay && matchDt) ? '' : 'none';
            });
        }

        function toggleSelectAllOrders(master) {
            document.querySelectorAll('.order-chk').forEach(chk => {
                const tr = chk.closest('tr');
                if (tr && tr.style.display !== 'none') chk.checked = master.checked;
            });
        }

        function openOrderDetailModal(id) {
            const o = allOrdersMap[id];
            if (!o) return;
            document.getElementById('odModalTitle').innerText = `📦 Order #${esc(o.id)} — Full Details & Audit Trail`;
            let historyHtml = '';
            if (o.audit_history && o.audit_history.length > 0) {
                historyHtml = '<ul style="padding-left:18px; margin-top:8px;">' + o.audit_history.map(h => `<li><strong>${esc(h.status)}</strong> by ${esc(h.actor)} <small>(${new Date(h.time).toLocaleString()})</small> ${h.note ? '— ' + esc(h.note) : ''}</li>`).join('') + '</ul>';
            } else {
                historyHtml = '<p style="color:#64748b;">No status changes logged yet.</p>';
            }
            document.getElementById('odModalBody').innerHTML = `
                <div style="background:#f8fafc; padding:14px; border-radius:10px; border:1px solid #e2e8f0; margin-bottom:14px;">
                    <p style="margin:4px 0;"><strong>Customer Name:</strong> ${esc(o.customer_name)}</p>
                    <p style="margin:4px 0;"><strong>Phone Number:</strong> ${esc(o.phone)}</p>
                    <p style="margin:4px 0;"><strong>Items Ordered:</strong> ${esc(o.product_title)} (Qty: ${esc(o.quantity)})</p>
                    <p style="margin:4px 0;"><strong>Total Payable:</strong> ৳ ${esc(o.price)}</p>
                    <p style="margin:4px 0;"><strong>Full Address & Meta:</strong> ${esc(o.address)}</p>
                    <p style="margin:4px 0;"><strong>Consignment ID:</strong> ${esc(o.consignment_id) || 'Not assigned'}</p>
                </div>
                <h4 style="margin:0 0 6px 0;">📜 Order Audit History</h4>
                ${historyHtml}
            `;
            document.getElementById('orderDetailModal').style.display = 'block';
        }

        function openEditProductModal(id) {
            const p = allProductsMap[id];
            if (!p) return;
            document.getElementById('editProductForm').action = '/secret-admin-panel-2026/products/edit/' + p.id;
            document.getElementById('editProductIdTitle').innerText = '#' + p.id + ' ' + p.title;
            document.getElementById('editTitle').value = p.title || '';
            document.getElementById('editSku').value = p.sku || '';
            document.getElementById('editCategory').value = p.category || 'Trending';
            document.getElementById('editSubcategory').value = p.subcategory || '';
            document.getElementById('editPrice').value = p.price || 0;
            document.getElementById('editRegularPrice').value = p.regular_price || 0;
            document.getElementById('editCostPrice').value = p.cost_price || 0;
            document.getElementById('editStockQty').value = p.stock_quantity ?? 50;
            document.getElementById('editImage').value = (p.gallery_images && p.gallery_images.length > 0) ? p.gallery_images.join(', ') : (p.image || '');
            document.getElementById('editVariants').value = p.variant_options || '';
            document.getElementById('editArchived').value = p.is_archived ? 'true' : 'false';
            document.getElementById('editDesc').value = p.description || '';
            document.getElementById('editSeoTitle').value = p.seo_title || '';
            document.getElementById('editSeoDesc').value = p.seo_description || '';
            document.getElementById('editProductModal').style.display = 'block';
        }

        async function extractOgMetadata() {
            const url = document.getElementById('ogInspectUrl').value.trim();
            if (!url) return alert('Enter a URL first');
            const box = document.getElementById('ogPreviewResult');
            box.style.display = 'block';
            box.innerHTML = 'Extracting Open Graph tags...';
            try {
                const res = await fetch('/secret-admin-panel-2026/social/extract-og', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ target_url: url })
                });
                const data = await res.json();
                if (data.success) {
                    box.innerHTML = `
                        ${data.og.image && /^https?:\/\//i.test(data.og.image) ? `<img src="${esc(data.og.image)}" style="width:100%; max-height:150px; object-fit:cover; border-radius:8px; margin-bottom:8px;">` : ''}
                        <strong style="display:block;">${esc(data.og.title) || 'No OG Title'}</strong>
                        <small style="color:#475569; display:block; margin-top:4px;">${esc(data.og.description) || 'No OG Description'}</small>
                    `;
                } else {
                    box.innerHTML = `<span style="color:#dc2626;">${esc(data.message)}</span>`;
                }
            } catch (e) {
                box.innerHTML = 'Error extracting metadata.';
            }
        }

        function exportProductsCSV() {
            const rows = [['id', 'title', 'sku', 'category', 'price', 'regular_price', 'cost_price', 'stock_quantity', 'image']];
            Object.values(allProductsMap).forEach(p => {
                rows.push([p.id, `"${(p.title||'').replace(/"/g, '""')}"`, p.sku, p.category, p.price, p.regular_price, p.cost_price, p.stock_quantity, `"${p.image||''}"`]);
            });
            const csv = rows.map(r => r.join(',')).join('\n');
            const link = document.createElement('a');
            link.download = 'trendzznow_products_catalog.csv';
            link.href = window.URL.createObjectURL(new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' }));
            link.click();
        }

        function processProductCSVImport() {
            const fileInput = document.getElementById('csvFileInput');
            if (!fileInput.files || !fileInput.files[0]) return alert('Select a CSV file first');
            const reader = new FileReader();
            reader.onload = async (e) => {
                const lines = e.target.result.split(/\r?\n/).filter(Boolean);
                if (lines.length < 2) return alert('CSV has no data rows');
                const headers = lines[0].split(',').map(h => h.trim().toLowerCase());
                const payload = [];
                for (let i = 1; i < lines.length; i++) {
                    const cols = lines[i].split(',');
                    const obj = {};
                    headers.forEach((h, idx) => { obj[h] = (cols[idx] || '').replace(/^"|"$/g, '').trim(); });
                    if (obj.title) payload.push(obj);
                }
                const res = await fetch('/secret-admin-panel-2026/products/import-csv', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ csv_rows: JSON.stringify(payload) })
                });
                const result = await res.json();
                if (result.success) {
                    alert(`Successfully imported ${result.imported} products!`);
                    window.location.reload();
                } else {
                    alert('Import error: ' + result.message);
                }
            };
            reader.readAsText(fileInput.files[0]);
        }

        function printShippingLabel(id) {
            const d = allOrdersMap[id];
            if (!d) return;
            const win = window.open('', '_blank', 'width=500,height=600');
            win.document.write(`<html><body style="font-family:Arial;padding:25px;border:3px solid #000;"><h2 style="text-align:center;margin-top:0;">SHIPPING LABEL</h2><hr><p><strong>Order ID:</strong> #${esc(d.id)} ${d.consignment_id ? ' | Consignment: ' + esc(d.consignment_id) : ''}</p><p><strong>Customer Name:</strong> ${esc(d.customer_name)}</p><p><strong>Phone:</strong> ${esc(d.phone)}</p><p><strong>Delivery Address:</strong> ${esc(d.address)}</p><hr><p><strong>Product:</strong> ${esc(d.product_title)}</p><h3>COD Amount: ৳${esc(d.price)}</h3><p style="text-align:center;font-size:12px;margin-top:30px;">TrendzzNow Official Courier Dispatch Label</p><script>window.print();<\/script></body></html>`);
            win.document.close();
        }

        function printInvoiceById(id) {
            const d = allOrdersMap[id];
            if (!d) return;
            const win = window.open('', '_blank', 'width=650,height=600');
            win.document.write(`<html><body style="font-family:Arial;padding:20px;"><div style="border:2px dashed #222;padding:20px;"><h2>TrendzzNow Invoice #${esc(d.id)}</h2><p><strong>Name:</strong> ${esc(d.customer_name)}</p><p><strong>Phone:</strong> ${esc(d.phone)}</p><p><strong>Address:</strong> ${esc(d.address)}</p><p><strong>Product:</strong> ${esc(d.product_title)}</p><h3>Total Payable: ৳${esc(d.price)}</h3></div><script>window.print();<\/script></body></html>`);
            win.document.close();
        }

        function exportOrdersCSV() {
            const table = document.getElementById('ordersTable');
            let csv = [];
            for (let i = 0; i < table.rows.length; i++) {
                let row = [], cols = table.rows[i].querySelectorAll('td, th');
                for (let j = 1; j < cols.length - 1; j++) row.push('"' + cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ") + '"');
                csv.push(row.join(','));
            }
            let link = document.createElement('a');
            link.download = 'trendzznow_orders.csv';
            link.href = window.URL.createObjectURL(new Blob(["\uFEFF" + csv.join("\n")], { type: 'text/csv;charset=utf-8;' }));
            link.click();
        }
    </script>
</body>
</html>
