                            <div class="form-group"><label>SteadFast Secret Key</label><input type="password" name="steadfast_secret_key" value="<%= settings.steadfast_secret_key || '' %>" placeholder="Optional SteadFast Secret"></div>
                        </div>

                        <div class="form-actions-bar">
                            <button type="submit" class="btn-primary-lg">💾 Save Commerce & Courier Settings</button>
                            <button type="reset" class="btn-outline-sm">Reset</button>
                        </div>
                    </form>
                </section>

                <!-- 7. SOCIAL MEDIA MANAGEMENT & OG TOOLS PANE -->
                <section id="pane-social" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Social Media Links, OG Preview & Share Analytics</h2>
                            <p>Manage official social profiles, extract Open Graph metadata from URLs, and track customer shares</p>
                        </div>
                    </div>

                    <div class="dashboard-2col">
                        <form action="/secret-admin-panel-2026/settings/update" method="POST" class="saas-card tracked-form">
                            <h3>🌐 Official Social Media URLs & Pixel</h3>
                            <div class="form-group"><label>📘 Facebook Page URL</label><input type="url" name="social_facebook" value="<%= settings.social_facebook || '' %>" placeholder="https://facebook.com/trendzznow"></div>
                            <div class="form-group"><label>📸 Instagram Profile URL</label><input type="url" name="social_instagram" value="<%= settings.social_instagram || '' %>" placeholder="https://instagram.com/trendzznow"></div>
