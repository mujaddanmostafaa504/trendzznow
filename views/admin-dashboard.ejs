<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrendzzNow Enterprise Admin Suite</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="saas-admin-body">
    <div id="unsavedBanner" class="unsaved-warning-bar" style="display:none;">
        <span>⚠️ You have unsaved changes in this section.</span>
        <div>
            <button type="button" onclick="discardUnsavedChanges()" class="btn-outline-sm">Reset / Discard</button>
        </div>
    </div>

    <div class="saas-layout" id="saasLayout">
        <!-- Collapsible Enterprise Sidebar Navigation -->
        <aside class="saas-sidebar" id="saasSidebar">
            <div class="sidebar-brand">
                <div class="brand-logo-icon">⚡</div>
                <div class="sidebar-brand-text">
                    <strong><%= (settings.brand_name_first || 'Trendzz') + (settings.brand_name_second || 'Now') %></strong>
                    <span>Enterprise Suite v22</span>
                </div>
                <button type="button" class="sidebar-close-mobile" onclick="toggleMobileSidebar()">&times;</button>
            </div>

            <nav class="sidebar-nav">
                <button type="button" class="s-nav-item active" data-pane="pane-overview" onclick="switchAdminPane('pane-overview', this)">
                    <span class="s-icon">📊</span><span class="s-label">Overview & Analytics</span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-orders" onclick="switchAdminPane('pane-orders', this)">
                    <span class="s-icon">📦</span><span class="s-label">Order Management</span>
                    <span class="s-badge"><%= analytics.pendingCount %></span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-products" onclick="switchAdminPane('pane-products', this)">
                    <span class="s-icon">🛍️</span><span class="s-label">Products & Catalog</span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-inventory" onclick="switchAdminPane('pane-inventory', this)">
                    <span class="s-icon">🏭</span><span class="s-label">Inventory & Stock</span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-reviews" onclick="switchAdminPane('pane-reviews', this)">
                    <span class="s-icon">⭐</span><span class="s-label">Customer Reviews</span>
                    <% const pendingReviews = (reviewsList || []).filter(r => r.status !== 'approved').length; %>
                    <% if (pendingReviews) { %><span class="s-badge"><%= pendingReviews %></span><% } %>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-cms" onclick="switchAdminPane('pane-cms', this)">
                    <span class="s-icon">🎨</span><span class="s-label">Website CMS & FAQ</span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-commerce" onclick="switchAdminPane('pane-commerce', this)">
                    <span class="s-icon">🚚</span><span class="s-label">Commerce & Courier</span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-social" onclick="switchAdminPane('pane-social', this)">
                    <span class="s-icon">📣</span><span class="s-label">Social & OG Tools</span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-ai" onclick="switchAdminPane('pane-ai', this)">
                    <span class="s-icon">🤖</span><span class="s-label">AI Customer Support</span>
                </button>
                <button type="button" class="s-nav-item" data-pane="pane-security" onclick="switchAdminPane('pane-security', this)">
                    <span class="s-icon">🔐</span><span class="s-label">Security & Audit Logs</span>
                </button>
            </nav>

            <div class="sidebar-footer">
                <div class="role-badge-box">
                    <small>Signed in as</small>
                    <strong><%= adminName %> (<%= adminRole %>)</strong>
                </div>
                <a href="/secret-admin-panel-2026/logout" class="s-logout-btn">Sign Out</a>
            </div>
        </aside>

        <!-- Main Workspace Area -->
        <div class="saas-main">
            <!-- Top Navigation Bar -->
            <header class="saas-topbar">
                <div style="display:flex; align-items:center; gap:12px;">
                    <button type="button" class="topbar-toggle-btn" onclick="toggleSidebarCollapse()" title="Toggle Sidebar">☰</button>
                    <h1 id="activePaneTitle" class="topbar-title">Dashboard Overview</h1>
                </div>
                <div class="topbar-actions">
                    <span class="status-dot-pill">● DB Connected</span>
                    <a href="/" target="_blank" class="btn-secondary-sm">🌐 Live Storefront ↗</a>
                </div>
            </header>

            <div class="saas-content-wrap">
                <% if (msg) { %>
                    <div class="saas-alert <%= msg.startsWith('Error') || msg.startsWith('Update Error') ? 'alert-error' : 'alert-success' %>">
                        <span><%= msg.startsWith('Error') || msg.startsWith('Update Error') ? '⚠️' : '✅' %> <%= msg %></span>
                        <button type="button" onclick="this.parentElement.remove()">&times;</button>
                    </div>
                <% } %>

                <!-- CUSTOMER REVIEWS PANE -->
                <section id="pane-reviews" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Customer Reviews</h2>
                            <p>New reviews wait here. Approve to publish them on the product page, or delete spam.</p>
                        </div>
                    </div>
                    <div class="saas-card">
                        <% if (!(reviewsList || []).length) { %>
                            <p style="color:#64748b;">No reviews yet.</p>
                        <% } else { %>
                        <div style="overflow-x:auto;">
                            <table class="saas-table">
                                <thead><tr><th>Product</th><th>Customer</th><th>Rating</th><th>Review</th><th>Status</th><th>Action</th></tr></thead>
                                <tbody>
                                <% reviewsList.forEach(function (r) { const prod = products.find(function (x) { return String(x.id) === String(r.product_id); }); %>
                                    <tr>
                                        <td><a href="/product/<%= r.product_id %>" target="_blank">#<%= r.product_id %></a> <%= prod ? prod.title : '' %></td>
                                        <td><%= r.name %><% if (r.verified) { %> <span title="Matched a delivered order">✔</span><% } %></td>
                                        <td><%= '★'.repeat(Number(r.rating) || 0) %></td>
                                        <td style="max-width:320px;"><%= r.comment %></td>
                                        <td><%= r.status === 'approved' ? '✅ Published' : '⏳ Pending' %></td>
                                        <td style="white-space:nowrap;">
                                            <form method="POST" action="/secret-admin-panel-2026/reviews/<%= r.id %>/status" style="display:inline;">
                                                <input type="hidden" name="status" value="<%= r.status === 'approved' ? 'pending' : 'approved' %>">
                                                <button type="submit" class="btn-primary-sm"><%= r.status === 'approved' ? 'Hide' : 'Approve' %></button>
                                            </form>
                                            <form method="POST" action="/secret-admin-panel-2026/reviews/<%= r.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this review?');">
                                                <button type="submit" class="btn-secondary-sm">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <% } %>
                    </div>
                </section>

                <!-- 1. MAIN DASHBOARD OVERVIEW PANE -->
                <section id="pane-overview" class="admin-pane active">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Real-Time Performance Metrics</h2>
                            <p>Live database-driven revenue, orders, customer activity, and stock health</p>
                        </div>
                        <div class="date-filter-bar">
                            <label>Date Range:</label>
                            <select id="dashDateRange" onchange="filterDashboardByRange(this.value)">
                                <option value="all">All Time</option>
                                <option value="7">Last 7 Days</option>
                                <option value="30">Last 30 Days</option>
                            </select>
                        </div>
                    </div>

                    <div class="kpi-grid-5">
                        <div class="kpi-card">
                            <span class="kpi-label">Gross Revenue</span>
                            <strong class="kpi-val" style="color:#059669;" id="kpiRevenue">৳ <%= analytics.totalRevenue %></strong>
                            <small class="kpi-sub">Net Est. Profit: ৳ <%= analytics.netProfit %></small>
                        </div>
                        <div class="kpi-card">
                            <span class="kpi-label">Total Orders</span>
                            <strong class="kpi-val" id="kpiOrders"><%= orders.length %></strong>
                            <small class="kpi-sub" style="color:#d97706;">⏳ <%= analytics.pendingCount %> Pending</small>
                        </div>
                        <div class="kpi-card">
                            <span class="kpi-label">Delivered Orders</span>
                            <strong class="kpi-val" style="color:#2563eb;"><%= analytics.deliveredCount %></strong>
                            <small class="kpi-sub">Confirmed/Transit: <%= analytics.confirmedCount %></small>
                        </div>
                        <div class="kpi-card">
                            <span class="kpi-label">Verified Customers</span>
                            <strong class="kpi-val"><%= analytics.totalCustomers %></strong>
                            <small class="kpi-sub">Unique buyer numbers</small>
                        </div>
                        <div class="kpi-card">
                            <span class="kpi-label">Active Catalog</span>
                            <strong class="kpi-val"><%= products.length %> SKU</strong>
                            <small class="kpi-sub" style="color:#dc2626;"><%= products.filter(p => p.stock_quantity <= 5).length %> Low Stock Alerts</small>
                        </div>
                    </div>

                    <div class="dashboard-2col">
                        <!-- Visual Revenue & Order Status Chart Card -->
                        <div class="saas-card">
                            <h3>📈 Revenue & Order Fulfillment Breakdown</h3>
                            <% 
                                const totalOrd = Math.max(1, orders.length);
                                const pendPct = Math.round((analytics.pendingCount / totalOrd) * 100);
                                const confPct = Math.round((analytics.confirmedCount / totalOrd) * 100);
                                const delivPct = Math.round((analytics.deliveredCount / totalOrd) * 100);
                                const retPct = Math.round((analytics.returnCount / totalOrd) * 100);
                            %>
                            <div class="chart-bars-box">
                                <div class="c-bar-row">
                                    <div class="c-bar-label"><span>Pending Orders (<%= analytics.pendingCount %>)</span><strong><%= pendPct %>%</strong></div>
                                    <div class="c-bar-track"><div class="c-bar-fill" style="width:<%= pendPct %>%; background:#f59e0b;"></div></div>
                                </div>
                                <div class="c-bar-row">
                                    <div class="c-bar-label"><span>Confirmed / In Transit (<%= analytics.confirmedCount %>)</span><strong><%= confPct %>%</strong></div>
                                    <div class="c-bar-track"><div class="c-bar-fill" style="width:<%= confPct %>%; background:#3b82f6;"></div></div>
                                </div>
                                <div class="c-bar-row">
                                    <div class="c-bar-label"><span>Delivered Successfully (<%= analytics.deliveredCount %>)</span><strong><%= delivPct %>%</strong></div>
                                    <div class="c-bar-track"><div class="c-bar-fill" style="width:<%= delivPct %>%; background:#10b981;"></div></div>
                                </div>
                                <div class="c-bar-row">
                                    <div class="c-bar-label"><span>Returned / Cancelled (<%= analytics.returnCount %>)</span><strong><%= retPct %>%</strong></div>
                                    <div class="c-bar-track"><div class="c-bar-fill" style="width:<%= retPct %>%; background:#ef4444;"></div></div>
                                </div>
                            </div>

                            <h4 style="margin:22px 0 10px 0; font-size:14px; color:#475569;">Recent Daily Sales Ledger</h4>
                            <div class="daily-ledger-list">
                                <% const dateKeys = Object.keys(dailyRevenue).sort().reverse().slice(0, 6); %>
                                <% if (dateKeys.length > 0) { %>
                                    <% dateKeys.forEach(dk => { %>
                                        <div class="ledger-item">
                                            <span>📅 <%= dk %></span>
                                            <strong>৳ <%= dailyRevenue[dk] %></strong>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="muted-empty">No sales recorded yet.</p>
                                <% } %>
                            </div>
                        </div>

                        <!-- Low Stock Alerts & Recent Orders Quick View -->
                        <div class="saas-card">
                            <h3>🚨 Low-Stock Inventory Alerts (≤ 5 Units)</h3>
                            <% const lowStockItems = products.filter(p => p.stock_quantity <= 5); %>
                            <% if (lowStockItems.length > 0) { %>
                                <div class="alert-list-stack">
                                    <% lowStockItems.forEach(lp => { %>
                                        <div class="low-stock-row">
                                            <div>
                                                <strong><%= lp.title %></strong>
                                                <small>SKU: <%= lp.sku %> • Category: <%= lp.category %></small>
                                            </div>
                                            <span class="danger-pill"><%= lp.stock_quantity %> left</span>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="healthy-stock-banner">✅ All products have healthy stock levels (&gt; 5 units).</div>
                            <% } %>

                            <h3 style="margin-top:24px;">🕒 Recent Orders</h3>
                            <div class="recent-orders-mini">
                                <% orders.slice(0, 5).forEach(ro => { %>
                                    <div class="ro-row">
                                        <div>
                                            <strong>#<%= ro.id %> — <%= ro.customer_name %></strong>
                                            <small><%= ro.product_title %></small>
                                        </div>
                                        <div style="text-align:right;">
                                            <strong style="color:#9c1448;">৳ <%= ro.price %></strong>
                                            <span class="status-tag-sm"><%= ro.status %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 2. ORDER MANAGEMENT PANE -->
                <section id="pane-orders" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Order Management & Fulfillment</h2>
                            <p>Search, filter, update status with audit history, print courier labels, or export CSV</p>
                        </div>
                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            <button type="button" onclick="exportOrdersCSV()" class="btn-primary-sm">📥 Export CSV</button>
                            <button type="button" onclick="window.print()" class="btn-secondary-sm">🖨️ Print Table</button>
                        </div>
                    </div>

                    <div class="saas-card">
                        <div class="order-filters-grid">
                            <input type="text" id="orderSearchInput" placeholder="🔍 Search Order ID, Customer Name, or Phone..." oninput="filterOrderRows()">
                            <select id="orderStatusFilter" onchange="filterOrderRows()">
                                <option value="all">All Order Statuses</option>
                                <option value="Pending">⏳ Pending</option>
                                <option value="Confirmed">✅ Confirmed</option>
                                <option value="Sent to SteadFast">🚚 Sent to SteadFast</option>
                                <option value="Sent to Pathao">🛵 Sent to Pathao</option>
                                <option value="Delivered">🎉 Delivered</option>
                                <option value="Cancelled">❌ Cancelled</option>
                            </select>
                            <select id="orderPaymentFilter" onchange="filterOrderRows()">
                                <option value="all">All Payment Types</option>
                                <option value="COD">Cash on Delivery (COD)</option>
                                <option value="Paid">bKash / Nagad (TrxID)</option>
                            </select>
                            <input type="date" id="orderDateFilter" onchange="filterOrderRows()">
                        </div>

                        <form action="/secret-admin-panel-2026/orders/bulk-action" method="POST" id="bulkForm" class="bulk-action-strip">
                            <label style="display:flex; align-items:center; gap:8px; font-weight:700;">
                                <input type="checkbox" id="selectAllOrders" onclick="toggleSelectAllOrders(this)"> Select Visible
                            </label>
                            <select name="bulk_status" required>
                                <option value="">-- Apply Bulk Status to Selected --</option>
                                <option value="Confirmed">✅ Mark Confirmed</option>
                                <option value="Sent to SteadFast">🚚 Mark Sent to SteadFast</option>
                                <option value="Sent to Pathao">🛵 Mark Sent to Pathao</option>
                                <option value="Delivered">🎉 Mark Delivered</option>
                                <option value="Cancelled">❌ Mark Cancelled</option>
                            </select>
                            <button type="submit" class="btn-primary-sm">Apply Bulk Update</button>
                        </form>

                        <div class="table-responsive">
                            <table class="saas-table" id="ordersTable">
                                <thead>
                                    <tr>
                                        <th style="width:36px;"></th>
                                        <th>Order ID & Date</th>
                                        <th>Customer & Masked Phone</th>
                                        <th>Items & Qty</th>
                                        <th>Total & Payment</th>
                                        <th>Status, Consignment & Notes</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (orders.length > 0) { %>
                                        <% orders.forEach(o => { 
                                            const isoDate = o.created_at ? o.created_at.substring(0, 10) : '';
                                            const rawPhone = String(o.phone || '');
                                            const maskedPhone = rawPhone.length >= 7 ? rawPhone.slice(0, 3) + '****' + rawPhone.slice(-3) : rawPhone;
                                            const isDigitalPay = (o.address || '').includes('TrxID:');
                                        %>
                                            <tr class="order-tr" 
                                                data-search="<%= (`#${o.id} ${o.customer_name} ${rawPhone} ${o.product_title}`).toLowerCase() %>"
                                                data-status="<%= o.status || 'Pending' %>"
                                                data-pay="<%= isDigitalPay ? 'Paid' : 'COD' %>"
                                                data-date="<%= isoDate %>">
                                                <td><input type="checkbox" name="selected_orders" value="<%= o.id %>" form="bulkForm" class="order-chk"></td>
                                                <td>
                                                    <strong style="font-size:15px; color:#1e293b;">#<%= o.id %></strong><br>
                                                    <small style="color:#64748b;"><%= isoDate || 'Today' %></small>
                                                </td>
                                                <td>
                                                    <strong><%= o.customer_name %></strong><br>
                                                    <span class="phone-mask-wrap">
                                                        <code class="phone-display" data-raw="<%= rawPhone %>" data-masked="<%= maskedPhone %>"><%= maskedPhone %></code>
                                                        <button type="button" class="btn-tiny-reveal" onclick="togglePhoneReveal(this)" title="Reveal/Mask Phone">👁️</button>
                                                    </span><br>
                                                    <a href="https://wa.me/88<%= rawPhone.replace(/^\+?88/, '') %>?text=<%= encodeURIComponent('Hello ' + o.customer_name + ', regarding your TrendzzNow Order #' + o.id + ' (' + o.product_title + ')') %>" target="_blank" class="wa-inline-link">💬 WhatsApp Customer</a>
                                                </td>
                                                <td style="max-width:220px;">
                                                    <div style="font-weight:600; color:#1e293b;"><%= o.product_title %></div>
                                                    <small style="color:#64748b;">Qty: <%= o.quantity %></small>
                                                </td>
                                                <td>
                                                    <span class="price-pill">৳ <%= o.price %></span><br>
                                                    <small class="pay-badge <%= isDigitalPay ? 'pay-digital' : 'pay-cod' %>"><%= isDigitalPay ? '📲 TrxID' : '💵 COD' %></small>
                                                </td>
                                                <td style="min-width:230px;">
                                                    <form action="/secret-admin-panel-2026/orders/status/<%= o.id %>" method="POST" class="inline-status-form">
                                                        <select name="status">
                                                            <option value="Pending" <%= o.status === 'Pending' ? 'selected' : '' %>>⏳ Pending</option>
                                                            <option value="Confirmed" <%= o.status === 'Confirmed' ? 'selected' : '' %>>✅ Confirmed</option>
                                                            <option value="Sent to SteadFast" <%= o.status === 'Sent to SteadFast' ? 'selected' : '' %>>🚚 SteadFast</option>
                                                            <option value="Sent to Pathao" <%= o.status === 'Sent to Pathao' ? 'selected' : '' %>>🛵 Pathao</option>
                                                            <option value="Delivered" <%= o.status === 'Delivered' ? 'selected' : '' %>>🎉 Delivered</option>
                                                            <option value="Cancelled" <%= o.status === 'Cancelled' ? 'selected' : '' %>>❌ Cancelled</option>
                                                        </select>
                                                        <input type="text" name="consignment_id" value="<%= o.consignment_id || '' %>" placeholder="Consignment / Tracking ID">
                                                        <input type="text" name="admin_notes" value="<%= o.admin_notes || '' %>" placeholder="Internal remarks...">
                                                        <button type="submit" class="btn-primary-sm" style="width:100%;">Update & Log</button>
                                                    </form>
                                                </td>
                                                <td>
                                                    <div class="action-stack">
                                                        <button type="button" class="btn-secondary-sm" onclick="openOrderDetailModal('<%= o.id %>')">🔍 Details / Audit</button>
                                                        <button type="button" class="btn-secondary-sm" onclick="printShippingLabel('<%= o.id %>')">🏷️ Label</button>
                                                        <button type="button" class="btn-secondary-sm" onclick="printInvoiceById('<%= o.id %>')">🖨️ Invoice</button>
                                                        <% if (adminRole === 'SuperAdmin') { %>
                                                        <form action="/secret-admin-panel-2026/orders/delete/<%= o.id %>" method="POST" onsubmit="return confirm('Permanently delete Order #<%= o.id %>?');">
                                                            <button type="submit" class="btn-danger-sm" style="width:100%;">🗑️ Delete</button>
                                                        </form>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr><td colspan="7" class="muted-empty">No customer orders recorded yet.</td></tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 3. PRODUCT MANAGEMENT PANE -->
                <section id="pane-products" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Product Catalog & SKU Management</h2>
                            <p>Add, edit, archive, manage categories/subcategories, multiple gallery images, and SEO</p>
                        </div>
                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            <button type="button" onclick="exportProductsCSV()" class="btn-secondary-sm">📤 Export Products CSV</button>
                            <button type="button" onclick="document.getElementById('csvImportBox').style.display='block'" class="btn-secondary-sm">📥 Import CSV</button>
                        </div>
                    </div>

                    <!-- CSV Import Box -->
                    <div id="csvImportBox" class="saas-card" style="display:none; margin-bottom:20px; border:2px dashed #3b82f6;">
                        <h4>📥 Bulk CSV Product Import</h4>
                        <p style="font-size:13px; color:#475569;">Select a CSV file with headers: <code>title,sku,category,price,regular_price,cost_price,stock_quantity,description,image</code></p>
                        <input type="file" id="csvFileInput" accept=".csv" style="margin-bottom:10px;">
                        <div style="display:flex; gap:10px;">
                            <button type="button" class="btn-primary-sm" onclick="processProductCSVImport()">Upload & Import</button>
                            <button type="button" class="btn-outline-sm" onclick="document.getElementById('csvImportBox').style.display='none'">Cancel</button>
                        </div>
                    </div>

                    <div class="dashboard-2col">
                        <!-- Add New Product Form -->
                        <div class="saas-card">
                            <h3>➕ Add New Product</h3>
                            <form action="/secret-admin-panel-2026/products/add" method="POST" enctype="multipart/form-data" class="tracked-form">
                                <div class="form-row">
                                    <div class="form-group" style="flex:2;">
                                        <label>Product Title *</label>
                                        <input type="text" name="title" required placeholder="e.g. Dynamic Leaf Table Lamp">
                                    </div>
                                    <div class="form-group" style="flex:1;">
                                        <label>SKU Code</label>
                                        <input type="text" name="sku" placeholder="TN-101">
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Category *</label>
                                        <input type="text" name="category" required placeholder="e.g. Home Decor, Gadgets">
                                    </div>
                                    <div class="form-group">
                                        <label>Subcategory</label>
                                        <input type="text" name="subcategory" placeholder="e.g. Table Lamps">
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Selling Price (৳) *</label>
                                        <input type="number" name="price" required min="0" step="1" placeholder="950">
                                    </div>
                                    <div class="form-group">
                                        <label>Regular Price (৳)</label>
                                        <input type="number" name="regular_price" min="0" step="1" placeholder="1250">
                                    </div>
                                    <div class="form-group">
                                        <label>Cost Price (৳)</label>
                                        <input type="number" name="cost_price" min="0" step="1" placeholder="550">
                                    </div>
                                    <div class="form-group">
                                        <label>Initial Stock *</label>
                                        <input type="number" name="stock_quantity" required min="0" step="1" value="50">
                                    </div>
                                </div>

                                <div class="upload-box">
                                    <label>📸 Upload Product Images (Multiple Allowed — Max 5)</label>
                                    <input type="file" name="image_files" accept="image/*" multiple onchange="previewUploadedFiles(this, 'addImgPreview')">
                                    <div id="addImgPreview" class="img-preview-strip"></div>
                                    <small style="display:block; color:#64748b; margin-top:6px;">OR paste comma-separated Image URLs:</small>
                                    <input type="text" name="image" placeholder="https://example.com/img1.jpg, https://...">
                                </div>

                                <div class="form-group">
                                    <label>Variants (comma separated)</label>
                                    <input type="text" name="variant_options" placeholder="Cream, Black, Wood">
                                </div>

                                <div class="form-group">
                                    <label>Product Description</label>
                                    <textarea name="description" rows="3" placeholder="Detailed specifications and features..."></textarea>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label>SEO Meta Title</label>
                                        <input type="text" name="seo_title" placeholder="Custom title for Google & Social">
                                    </div>
                                    <div class="form-group">
                                        <label>SEO Meta Description</label>
                                        <input type="text" name="seo_description" placeholder="Brief summary for search engines">
                                    </div>
                                </div>

                                <div class="form-actions-bar">
                                    <button type="submit" class="btn-primary-lg">💾 Publish Product</button>
                                    <button type="reset" class="btn-outline-sm">Reset</button>
                                </div>
                            </form>
                        </div>

                        <!-- Existing Product Catalog List -->
                        <div class="saas-card">
                            <h3>🗂️ Product Catalog (<%= products.length %>)</h3>
                            <div class="table-responsive" style="max-height:680px; overflow-y:auto;">
                                <table class="saas-table" id="productsCatalogTable">
                                    <thead>
                                        <tr>
                                            <th>Thumb</th>
                                            <th>Product, SKU & Category</th>
                                            <th>Pricing & Stock</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% products.forEach(p => { %>
                                            <tr style="<%= p.is_archived ? 'opacity:0.55; background:#f8fafc;' : '' %>">
                                                <td>
                                                    <% if (p.image) { %>
                                                        <img src="<%= p.image %>" width="52" height="52" style="object-fit:cover; border-radius:8px; border:1px solid #e2e8f0;">
                                                    <% } else { %>
                                                        <div style="width:52px; height:52px; background:#f1f5f9; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:11px; color:#64748b;">No Img</div>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <strong><%= p.title %></strong>
                                                    <% if (p.is_archived) { %><span class="danger-pill">Archived</span><% } %><br>
                                                    <small style="color:#64748b;">SKU: <%= p.sku %> • <%= p.category %><%= p.subcategory ? ' / ' + p.subcategory : '' %></small>
                                                </td>
                                                <td>
                                                    <strong style="color:#9c1448;">৳ <%= p.price %></strong>
                                                    <% if (p.regular_price > p.price) { %><small style="text-decoration:line-through; color:#94a3b8;">৳<%= p.regular_price %></small><% } %><br>
                                                    <small style="color:#475569;">Cost: ৳<%= p.cost_price %> • Stock: <strong><%= p.stock_quantity %></strong></small>
                                                </td>
                                                <td>
                                                    <div class="action-stack">
                                                        <button type="button" class="btn-secondary-sm" onclick="openEditProductModal('<%= p.id %>')">✏️ Edit</button>
                                                        <form action="/secret-admin-panel-2026/products/archive/<%= p.id %>" method="POST">
                                                            <input type="hidden" name="archive" value="<%= !p.is_archived %>">
                                                            <button type="submit" class="btn-outline-sm" style="width:100%;"><%= p.is_archived ? '♻️ Restore' : '📁 Archive' %></button>
                                                        </form>
                                                        <% if (adminRole === 'SuperAdmin') { %>
                                                        <form action="/secret-admin-panel-2026/products/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Permanently delete <%= p.title.replace(/'/g, '') %>?');">
                                                            <button type="submit" class="btn-danger-sm" style="width:100%;">🗑️ Delete</button>
                                                        </form>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 4. INVENTORY MANAGEMENT PANE -->
                <section id="pane-inventory" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Real-Time Inventory & Stock Control</h2>
                            <p>Adjust stock quantities, monitor low-stock alerts, and audit stock adjustment history</p>
                        </div>
                    </div>

                    <div class="dashboard-2col">
                        <div class="saas-card">
                            <h3>⚖️ Record Stock Adjustment</h3>
                            <form action="/secret-admin-panel-2026/inventory/adjust" method="POST">
                                <div class="form-group">
                                    <label>Select Product *</label>
                                    <select name="product_id" required>
                                        <% products.forEach(p => { %>
                                            <option value="<%= p.id %>"><%= p.title %> (SKU: <%= p.sku %> — Current Stock: <%= p.stock_quantity %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Adjustment Action *</label>
                                        <select name="adjustment_type">
                                            <option value="add">➕ Add Stock (Restock)</option>
                                            <option value="subtract">➖ Subtract Stock (Damage/Manual)</option>
                                            <option value="set">🎯 Set Exact Stock Count</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Quantity *</label>
                                        <input type="number" name="quantity" required min="1" value="10">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Reason / Reference Note *</label>
                                    <input type="text" name="reason" required placeholder="e.g. New shipment received from supplier">
                                </div>
                                <button type="submit" class="btn-primary-lg">✅ Apply Stock Adjustment</button>
                            </form>
                        </div>

                        <div class="saas-card">
                            <h3>📜 Stock Adjustment History Log</h3>
                            <div class="table-responsive" style="max-height:360px; overflow-y:auto;">
                                <table class="saas-table">
                                    <thead>
                                        <tr><th>Date</th><th>Product</th><th>Change</th><th>Reason & Actor</th></tr>
                                    </thead>
                                    <tbody>
                                        <% if (stockLogs && stockLogs.length > 0) { %>
                                            <% stockLogs.forEach(sl => { %>
                                                <tr>
                                                    <td><small><%= sl.time ? new Date(sl.time).toLocaleString() : '-' %></small></td>
                                                    <td><strong><%= sl.product %></strong></td>
                                                    <td><%= sl.oldStock %> &rarr; <strong><%= sl.newStock %></strong></td>
                                                    <td><small><%= sl.reason %> (<%= sl.actor %>)</small></td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr><td colspan="4" class="muted-empty">No manual stock adjustments logged yet.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 5. WEBSITE CONTENT MANAGEMENT (CMS & FAQ) PANE -->
                <section id="pane-cms" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
