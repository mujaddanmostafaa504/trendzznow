                            </div>
                            <div class="form-group">
                                <label>Welcome Greeting (বাংলা)</label>
                                <input type="text" name="ai_welcome_bn" value="<%= settings.ai_welcome_bn %>">
                            </div>
                            <div class="form-group">
                                <label>Store Knowledge Base (Used to answer customer questions)</label>
