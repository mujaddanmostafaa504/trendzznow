                            <div class="form-group"><label>Inside Dhaka Charge (৳)</label><input type="number" name="delivery_inside_dhaka" value="<%= settings.delivery_inside_dhaka || 70 %>"></div>
                            <div class="form-group"><label>Outside Dhaka Charge (৳)</label><input type="number" name="delivery_outside_dhaka" value="<%= settings.delivery_outside_dhaka || 130 %>"></div>
                            <div class="form-group"><label>Free Shipping Minimum Order (৳, 0=Disabled)</label><input type="number" name="free_shipping_threshold" value="<%= settings.free_shipping_threshold || 0 %>"></div>
                            <div class="form-group"><label>Tax / VAT Percentage (%)</label><input type="number" name="tax_percentage" value="<%= settings.tax_percentage || 0 %>"></div>
                        </div>

                        <h3 style="margin-top:24px;">💳 Payment Numbers & Promo Coupons</h3>
                        <div class="form-row">
                            <div class="form-group"><label>📞 WhatsApp Order & Support Hotline</label><input type="text" name="whatsapp_number" value="<%= settings.whatsapp_number || '01731763504' %>"></div>
                            <div class="form-group"><label>📲 bKash Merchant/Personal Number</label><input type="text" name="bkash_number" value="<%= settings.bkash_number || '01731763504' %>"></div>
