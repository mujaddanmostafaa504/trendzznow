                            <h4>📈 Tracked Share Clicks (Total: <%= shareAnalytics.total_shares || 0 %>)</h4>
                            <div class="share-product-links-list" style="max-height:240px; overflow-y:auto;">
                                <% products.forEach(p => { %>
                                    <div class="ro-row">
