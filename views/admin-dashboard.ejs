          </tbody></table></div>
        </section>

        <section class="admin-section admin-panel-view" id="adminAnalyticsPanel" data-admin-panel="analytics">
          <div class="admin-section-heading"><div><span class="admin-eyebrow">STORE PERFORMANCE</span><h3>Analytics & reports</h3><p>Figures are derived from current product and order records. Delivered sales are shown separately from open order value.</p></div></div>
          <div class="stats-grid admin-analytics-grid">
            <div class="stat-card"><span class="stat-title">Delivered revenue</span><span class="stat-num">৳ <%= Number(analytics.deliveredRevenue||0).toLocaleString('en-BD') %></span></div>
            <div class="stat-card"><span class="stat-title">Total order records</span><span class="stat-num"><%= analytics.totalOrders||0 %></span></div>
            <div class="stat-card"><span class="stat-title">Customers</span><span class="stat-num"><%= analytics.totalCustomers||0 %></span></div>
            <div class="stat-card"><span class="stat-title">Inventory cost value</span><span class="stat-num">৳ <%= Number(analytics.totalInventoryCost||0).toLocaleString('en-BD') %></span></div>
          </div>
          <section class="admin-subpanel"><h4>Delivered sales · last 7 days</h4><div class="admin-sales-chart"><% const maxDaySales=Math.max(1,...(analytics.dailySales||[]).map(d=>Number(d.amount)||0)); (analytics.dailySales||[]).forEach(day=>{ %><div class="admin-sales-bar-group"><div class="admin-sales-bar-value">৳<%= Math.round(day.amount).toLocaleString('en-BD') %></div><div class="admin-sales-bar-track"><span style="height:<%= Math.max(2,Math.round((day.amount/maxDaySales)*100)) %>%"></span></div><small><%= new Date(day.date+'T12:00:00').toLocaleDateString('en-US',{weekday:'short'}) %></small></div><% }) %></div></section>
          <section class="admin-subpanel"><h4>Order status breakdown</h4><div class="admin-status-breakdown"><% Object.entries(analytics.statusCounts||{}).sort((a,b)=>b[1]-a[1]).forEach(([status,count])=>{ %><div><span><%= status %></span><strong><%= count %></strong></div><% }) %><% if (!Object.keys(analytics.statusCounts||{}).length) { %><div class="admin-empty-state">No order data yet.</div><% } %></div></section>
        </section>

        <section class="admin-panel-view" id="adminHistoryPanel" data-admin-panel="history">
          <section class="admin-section"><div class="admin-section-heading"><div><span class="admin-eyebrow">STOCK CONTROL</span><h3>Inventory movement history</h3><p>Records are added when initial stock is created, orders reserve stock, or an admin adjusts quantities. Apply the SQL migration to activate persistent history.</p></div></div>
            <div class="table-responsive"><table class="data-table"><thead><tr><th>Date</th><th>Product</th><th>Movement</th><th>Change</th><th>Previous → New</th><th>Reason / Ref</th></tr></thead><tbody>
              <% inventoryMovements.forEach(m=>{ %><tr><td><%= m.created_at ? new Date(m.created_at).toLocaleString() : '—' %></td><td><strong><%= m.product_title %></strong><small class="admin-cell-sub">#<%= m.product_id || 'deleted' %></small></td><td><%= m.movement_type %></td><td><strong><%= Number(m.quantity_change)>0?'+':'' %><%= m.quantity_change %></strong></td><td><%= m.previous_quantity %> → <%= m.new_quantity %></td><td><%= m.reason || '—' %> <small><%= m.reference || '' %></small></td></tr><% }) %>
              <% if (!inventoryMovements.length) { %><tr><td colspan="6"><div class="admin-empty-state">No stock history yet. Apply the V23 migration and future changes will be logged.</div></td></tr><% } %>
            </tbody></table></div>
          </section>
          <section class="admin-section"><div class="admin-section-heading"><div><span class="admin-eyebrow">SECURITY</span><h3>Administrator activity log</h3><p>Recent changes made from this admin panel.</p></div></div>
            <div class="table-responsive"><table class="data-table"><thead><tr><th>Date</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr></thead><tbody>
              <% auditLogs.forEach(a=>{ %><tr><td><%= a.created_at ? new Date(a.created_at).toLocaleString() : '—' %></td><td><strong><%= a.action %></strong></td><td><%= a.entity_type %> <%= a.entity_id %></td><td><%= JSON.stringify(a.details||{}) %></td><td><%= a.ip_address || '—' %></td></tr><% }) %>
              <% if (!auditLogs.length) { %><tr><td colspan="5"><div class="admin-empty-state">No audit activity has been recorded yet.</div></td></tr><% } %>
            </tbody></table></div>
          </section>
        </section>

        <!-- Sub-admin access is intentionally disabled until role-based permissions are implemented. -->
