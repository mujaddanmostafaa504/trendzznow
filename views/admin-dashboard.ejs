                            <div class="form-group"><label>Hero Subtitle (EN)</label><input type="text" name="hero_subtitle_en" value="<%= settings.hero_subtitle_en %>"></div>
                            <div class="form-group"><label>Hero Subtitle (বাংলা)</label><input type="text" name="hero_subtitle_bn" value="<%= settings.hero_subtitle_bn %>"></div>
