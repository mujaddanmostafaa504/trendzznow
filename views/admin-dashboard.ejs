<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enterprise Admin Dashboard - TrendzzNow</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/upgrade.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .action-btn-group { display: flex; gap: 5px; flex-wrap: wrap; align-items: center; }
        .print-btn { background-color: #0984e3; color: #fff; border: none; padding: 5px 9px; border-radius: 4px; cursor: pointer; font-size: 11.5px; font-weight: 600; }
        .copy-btn { background-color: #00b894; color: #fff; border: none; padding: 5px 9px; border-radius: 4px; cursor: pointer; font-size: 11.5px; font-weight: 600; }
        .edit-btn { background-color: #fdcb6e; color: #222; border: none; padding: 5px 9px; border-radius: 4px; cursor: pointer; font-size: 11.5px; font-weight: 600; }
        .export-btn { background-color: #6c5ce7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; }
        .upload-box { background: #f8f9fc; border: 2px dashed #b2bec3; padding: 12px; border-radius: 8px; margin-bottom: 12px; }
        .upload-box label { color: #1F1B5C; font-weight: 700; }
        .badge-low-stock { background: #ff7675; color: #fff; padding: 2px 7px; border-radius: 12px; font-size: 11px; font-weight: 700; margin-left: 6px; }
        .tab-bar { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; flex-wrap: wrap; }
        .tab-btn { background: #e2e8f0; color: #333; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 13px; }
        .tab-btn.active { background: #1F1B5C; color: #fff; }
    .admin-logout-form{margin:0}.admin-logout-form .logout-btn{cursor:pointer;border:0;font:inherit}
</style>
</head>
<body class="admin-body admin-upgraded">
    <div class="admin-app-shell">
      <aside class="admin-sidebar" id="adminSidebar">
        <a class="admin-sidebar-brand" href="/secret-admin-panel-2026/dashboard" aria-label="TrendzzNow dashboard">
          <span class="admin-brand-mark">T</span><span><strong><%= (settings.brand_name_first || 'Trendzz') + (settings.brand_name_second || 'Now') %></strong><small>STORE MANAGEMENT</small></span>
        </a>
        <div class="admin-sidebar-label">WORKSPACE</div>
        <nav class="admin-side-nav" aria-label="Admin navigation">
          <button type="button" class="admin-nav-item active" data-admin-view="overview"><span>▦</span>Overview</button>
          <button type="button" class="admin-nav-item" data-admin-view="orders"><span>▤</span>Orders <em><%= orders.length %></em></button>
          <button type="button" class="admin-nav-item" data-admin-view="products"><span>▣</span>Products & Stock <em><%= products.length %></em></button>
          <button type="button" class="admin-nav-item" data-admin-view="categories"><span>▥</span>Categories <em><%= categories.length %></em></button>
          <button type="button" class="admin-nav-item" data-admin-view="customers"><span>♙</span>Customers <em><%= customers.length %></em></button>
          <button type="button" class="admin-nav-item" data-admin-view="analytics"><span>◫</span>Analytics</button>
          <button type="button" class="admin-nav-item" data-admin-view="history"><span>◷</span>Stock & Audit History</button>
          <button type="button" class="admin-nav-item" data-admin-view="settings"><span>⚙</span>Storefront & Policies</button>
          <button type="button" class="admin-nav-item" data-admin-view="security"><span>♧</span>Security</button>
        </nav>
        <div class="admin-sidebar-bottom"><span class="admin-online-dot"></span> Store control panel <small>Private administrator area</small></div>
      </aside>
      <div class="admin-main-area">
    <header class="admin-header">
        <div class="admin-brand">
            <button type="button" class="admin-mobile-menu" id="adminMobileMenu" aria-label="Open admin navigation">☰</button>
            <div><h2 id="adminHeaderTitle">Overview</h2><span class="admin-header-subtitle">Manage your store operations</span></div>
        </div>
        <div class="admin-header-actions">
            <a href="/" target="_blank" class="view-site-btn">🌐 View Website</a>
            <form action="/secret-admin-panel-2026/logout" method="POST" class="admin-logout-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="logout-btn">Logout</button></form>
        </div>
    </header>

    <main class="admin-container">
        <div class="admin-page-intro">
          <div><span class="admin-eyebrow">TRENDZZNOW CONTROL CENTER</span><h1 id="adminPageTitle">Store overview</h1><p id="adminPageDescription">A live view of your orders, sales and product inventory.</p></div>
          <div class="admin-intro-actions"><a href="/#products" target="_blank" rel="noopener" class="admin-secondary-action">View storefront ↗</a><button type="button" class="admin-primary-action" data-admin-jump="products">＋ Add product</button></div>
        </div>
        <% if (msg) { %>
            <div class="success-banner" style="<%= msg.startsWith('Error') || msg.startsWith('Update Error') ? 'background:#fde8ec;color:#b71540;' : '' %>">
                <span><%= msg.startsWith('Error') || msg.startsWith('Update Error') ? '⚠️' : '✅' %> <%= msg %></span>
                <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;font-weight:bold;cursor:pointer;">&times;</button>
            </div>
        <% } %>

        <!-- Advanced Analytics Cards -->
        <div class="stats-grid admin-panel-view" id="adminOverviewPanel" data-admin-panel="overview">
            <div class="stat-card">
                <span class="stat-title">Open + delivered order value</span>
                <span class="stat-num" style="color:#00b894;">৳ <%= Number(analytics.totalRevenue||0).toLocaleString('en-BD') %></span>
                <small style="color:#666; font-size:11.5px;">Delivered revenue: <strong>৳ <%= Number(analytics.deliveredRevenue||0).toLocaleString('en-BD') %></strong></small>
            </div>
            <div class="stat-card">
                <span class="stat-title">Pending Orders</span>
                <span class="stat-num" style="color:#e17055;"><%= analytics.pendingCount %> <small style="font-size:13px; color:#666;">(Total: <%= orders.length %>)</small></span>
                <small style="color:#0984e3;">Confirmed/Shipped: <%= analytics.confirmedCount %></small>
            </div>
            <div class="stat-card">
                <span class="stat-title">Successful Deliveries</span>
                <span class="stat-num" style="color:#00b894;"><%= analytics.deliveredCount %></span>
                <small style="color:#d63031;">Returns/Cancelled: <%= analytics.returnCount %></small>
            </div>
            <div class="stat-card">
                <span class="stat-title">Active Inventory</span>
                <span class="stat-num" style="color:#1F1B5C;"><%= products.length %> Items</span>
                <small style="color:#666;">WhatsApp Hotline: <%= settings.whatsapp_number || '01731763504' %></small>
            </div>
        </div>

        <div class="admin-overview-lower admin-panel-view" data-admin-panel="overview">
          <section class="admin-section overview-summary-card">
            <div class="admin-section-heading"><div><span class="admin-eyebrow">LATEST ACTIVITY</span><h3>Recent orders</h3><p>The newest orders recorded in your store.</p></div><button type="button" class="admin-text-action" data-admin-jump="orders">View all orders →</button></div>
            <% if (orders.length) { %>
              <div class="overview-order-list">
                <% orders.slice(0, 5).forEach(o => { %>
                  <div class="overview-order-row"><span class="overview-order-id">#<%= o.id %></span><span class="overview-order-customer"><strong><%= o.customer_name %></strong><small><%= o.product_title %></small></span><span class="overview-order-amount">৳ <%= o.price %></span><span class="overview-status"><%= o.status %></span></div>
                <% }) %>
              </div>
            <% } else { %><div class="admin-empty-state">No customer orders have been recorded yet.</div><% } %>
          </section>
          <section class="admin-section overview-summary-card">
            <div class="admin-section-heading"><div><span class="admin-eyebrow">STOCK MONITOR</span><h3>Low-stock products</h3><p>Items with five or fewer units recorded.</p></div><button type="button" class="admin-text-action" data-admin-jump="products">Manage inventory →</button></div>
            <% const lowStockProducts = products.filter(p => p.stock_known && Number(p.stock_quantity) <= 5); %>
            <% if (lowStockProducts.length) { %>
              <div class="overview-stock-list"><% lowStockProducts.slice(0, 6).forEach(p => { %><div class="overview-stock-row"><span><strong><%= p.title %></strong><small><%= p.category %></small></span><b><%= p.stock_quantity %> left</b></div><% }) %></div>
            <% } else { %><div class="admin-empty-state">No low-stock alerts based on recorded stock values.</div><% } %>
          </section>
        </div>

        <!-- Order Filter & Bulk Actions Bar -->
        <section class="admin-section admin-panel-view" id="adminOrdersPanel" data-admin-panel="orders">
            <div class="admin-section-heading">
                <div><span class="admin-eyebrow">FULFILMENT</span><h3>Customer orders</h3><p>Review, update and fulfil customer purchases. Cancelling Pending/Confirmed orders before courier dispatch returns reserved stock; dispatched/returned goods need manual inspection.</p></div>
                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <button onclick="exportOrdersCSV()" class="export-btn">📥 Export CSV (Excel)</button>
                    <button onclick="window.print()" class="print-btn" style="padding: 8px 14px; font-size: 13px;">🖨️ Print Order List</button>
                </div>
            </div>

            <div class="admin-table-tools"><input type="search" id="orderSearch" placeholder="Search order ID, customer, phone or product…" aria-label="Search orders"><span class="admin-muted"><%= orders.length %> total orders</span></div>
            <!-- Tab Filters -->
            <div class="tab-bar">
                <button class="tab-btn active" onclick="filterOrderTab('all', this)">All Orders (<%= orders.length %>)</button>
                <button class="tab-btn" onclick="filterOrderTab('Pending', this)">Pending (<%= analytics.pendingCount %>)</button>
                <button class="tab-btn" onclick="filterOrderTab('Confirmed', this)">Confirmed / Shipped</button>
                <button class="tab-btn" onclick="filterOrderTab('Delivered', this)">Delivered (<%= analytics.deliveredCount %>)</button>
                <button class="tab-btn" onclick="filterOrderTab('Return', this)">Returns / Cancelled</button>
            </div>

            <!-- Bulk Status Update Form -->
            <form action="/secret-admin-panel-2026/orders/bulk-action" method="POST" id="bulkForm" style="background:#f8f9fc; padding:12px; border-radius:8px; margin-bottom:15px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <span style="font-weight:700; font-size:13px; color:#1F1B5C;">⚡ Bulk Action:</span>
                <select name="bulk_status" class="status-select" required style="padding:7px; font-size:13px;">
                    <option value="">-- Select Status to Apply to Checked --</option>
                    <option value="Confirmed">✅ Mark as Confirmed</option>
                    <option value="Sent to SteadFast">🚚 Mark as Sent to SteadFast</option>
                    <option value="Sent to Pathao">🛵 Mark as Sent to Pathao</option>
                    <option value="Delivered">🎉 Mark as Delivered</option>
                    <option value="Cancelled">❌ Mark as Cancelled</option>
                </select>
                <button type="submit" class="mini-save-btn" style="padding:8px 16px; font-size:13px;">Apply to Selected</button>
            </form>

            <div class="table-responsive">
                <table class="data-table" id="ordersTable">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAll" onclick="toggleSelectAll(this)"></th>
                            <th>ID & Date</th>
                            <th>Customer & Phone</th>
                            <th>Product</th>
                            <th>Total & Notes</th>
                            <th>Status & Consignment</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length > 0) { %>
                            <% orders.forEach(o => { 
                                const dateFormatted = o.created_at ? new Date(o.created_at).toLocaleDateString() : '-';
                                let rowCategory = 'Pending';
                                if (o.status === 'Delivered') rowCategory = 'Delivered';
                                else if (o.status === 'Cancelled' || o.status === 'Return') rowCategory = 'Return';
                                else if (o.status !== 'Pending') rowCategory = 'Confirmed';
                            %>
                                <tr class="order-row" data-status="<%= rowCategory %>">
                                    <td><input type="checkbox" name="selected_orders" value="<%= o.id %>" form="bulkForm" class="order-chk"></td>
                                    <td><strong>#<%= o.id %></strong><br><small><%= dateFormatted %></small></td>
                                    <td>
                                        <strong><%= o.customer_name %></strong><br>
                                        <a href="tel:<%= o.phone %>" style="color:#9c1448;font-weight:600;"><%= o.phone %></a><br>
                                        <a href="https://wa.me/88<%= (o.phone || '').replace(/^\+?88/, '') %>" target="_blank" style="font-size:12px;color:#25D366;font-weight:bold;">💬 WhatsApp</a>
                                    </td>
                                    <td><strong><%= o.product_title %></strong></td>
                                    <td>
                                        <span class="price-pill">৳ <%= o.price %></span>
                                        <% if (o.admin_notes) { %><br><small style="color:#d63031; font-weight:700;">📝 <%= o.admin_notes %></small><% } %>
                                    </td>
                                    <td>
                                        <form action="/secret-admin-panel-2026/orders/status/<%= o.id %>" method="POST" style="display:flex; flex-direction:column; gap:5px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <select name="status" class="status-select">
                                                <option value="Pending" <%= o.status === 'Pending' ? 'selected' : '' %>>⏳ Pending</option>
                                                <option value="Confirmed" <%= o.status === 'Confirmed' ? 'selected' : '' %>>✅ Confirmed</option>
                                                <option value="Sent to SteadFast" <%= o.status === 'Sent to SteadFast' ? 'selected' : '' %>>🚚 SteadFast</option>
                                                <option value="Sent to Pathao" <%= o.status === 'Sent to Pathao' ? 'selected' : '' %>>🛵 Pathao</option>
                                                <option value="Delivered" <%= o.status === 'Delivered' ? 'selected' : '' %>>🎉 Delivered</option>
                                                <option value="Cancelled" <%= o.status === 'Cancelled' ? 'selected' : '' %>>❌ Cancelled</option>
                                                <option value="Return" <%= o.status === 'Return' ? 'selected' : '' %>>↩ Return / inspect</option>
                                            </select>
                                            <input type="text" name="consignment_id" value="<%= o.consignment_id || '' %>" placeholder="Tracking / Consignment ID" style="padding:4px; font-size:11px; border:1px solid #ccc; border-radius:4px;">
                                            <input type="text" name="admin_notes" value="<%= o.admin_notes || '' %>" placeholder="Admin note..." style="padding:4px; font-size:11px; border:1px solid #ccc; border-radius:4px;">
                                            <button type="submit" class="mini-save-btn">Save Order</button>
                                        </form>
                                    </td>
                                    <td>
                                        <div class="action-btn-group">
                                            <button type="button" class="print-btn" onclick="printShippingLabel('<%= o.id %>')">🏷️ Label</button>
                                            <button type="button" class="print-btn" style="background:#2d3436;" onclick="printInvoiceById('<%= o.id %>')">🖨️ Slip</button>
                                            <button type="button" class="copy-btn" onclick="copyCustomerById('<%= o.id %>')">📋 Copy</button>
                                            <% if (['Pending','Confirmed'].includes(o.status)) { %>
                                            <form action="/secret-admin-panel-2026/orders/delete/<%= o.id %>" method="POST" onsubmit="return confirm('Delete this Pending/Confirmed order? Its reserved stock will be returned.');" style="display:inline;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="delete-btn">Del</button>
                                            </form>
                                            <% } else { %><span class="admin-muted" title="Fulfilment history is retained">Keep</span><% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" style="text-align: center; padding: 20px;">No orders yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Complete product and inventory workspace -->
        <section class="admin-panel-view" id="adminProductsPanel" data-admin-panel="products">
          <div class="admin-product-layout">
            <section class="admin-section admin-product-form-card">
              <div class="admin-section-heading"><div><span class="admin-eyebrow">CATALOG</span><h3>＋ Add product</h3><p>Create a product with pricing, stock and category details.</p></div></div>
              <form action="/secret-admin-panel-2026/products/add" method="POST" enctype="multipart/form-data" class="admin-product-form"><input type="hidden" name="is_active_present" value="1"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group"><label>Product title *</label><input type="text" name="title" required maxlength="180" placeholder="e.g. Dynamic Leaf Table Lamp"></div>
                <div class="form-row">
                  <div class="form-group"><label>Category *</label><input type="text" name="category" required list="trendzzCategoryOptions" maxlength="80" placeholder="Choose or type category"><datalist id="trendzzCategoryOptions"><% categories.forEach(cat => { %><option value="<%= cat %>"></option><% }) %></datalist></div>
                  <div class="form-group"><label>SKU / Product code</label><input type="text" name="sku" maxlength="80" placeholder="e.g. TN-LAMP-001"></div>
                </div>
                <div class="form-row">
                  <div class="form-group"><label>Selling price (৳) *</label><input type="number" name="price" required min="0.01" step="0.01" placeholder="950"></div>
                  <div class="form-group"><label>Regular price (৳)</label><input type="number" name="regular_price" min="0" step="0.01" placeholder="1250"></div>
                </div>
                <div class="form-row">
                  <div class="form-group"><label>Buying / cost price (৳)</label><input type="number" name="cost_price" min="0" step="0.01" value="0"></div>
                  <div class="form-group"><label>Opening stock *</label><input type="number" name="stock_quantity" min="0" step="1" value="0" required></div>
                </div>
                <div class="form-row">
                  <div class="form-group"><label>Low-stock alert at</label><input type="number" name="low_stock_threshold" min="0" step="1" value="5"></div>
                  <div class="form-group"><label>Variants (comma separated)</label><input type="text" name="variant_options" placeholder="Cream, Black, Wood"></div>
                </div>
                <div class="upload-box">
                  <label>Product image (JPG, PNG, WebP or GIF; max 5 MB)</label>
                  <input type="file" name="image_file" accept="image/jpeg,image/png,image/webp,image/gif" data-image-preview-input="newProductPreview">
                  <img id="newProductPreview" class="admin-image-preview" alt="Product image preview" hidden>
                  <small>Or paste a public image URL</small><input type="url" name="image" placeholder="https://example.com/product.jpg">
                </div>
                <div class="form-group"><label>Description</label><textarea name="description" rows="4" maxlength="12000" placeholder="Product description and key details"></textarea></div>
                <label class="admin-check-label"><input type="checkbox" name="is_active" checked> Publish this product on the storefront</label>
                <button type="submit" class="add-product-btn">＋ Save product</button>
              </form>
            </section>

            <section class="admin-section admin-inventory-card">
              <div class="admin-section-heading"><div><span class="admin-eyebrow">STOCK CONTROL</span><h3>Product inventory <span class="admin-count-pill"><%= products.length %></span></h3><p>Search, filter, export and manage products.</p></div><div class="admin-inline-actions"><a class="admin-secondary-action" href="/secret-admin-panel-2026/products/export.csv">↓ Export CSV</a></div></div>
              <div class="admin-inventory-toolbar">
                <input type="search" id="inventorySearch" placeholder="Search title, SKU or category…" aria-label="Search inventory">
                <select id="inventoryCategoryFilter" aria-label="Filter category"><option value="">All categories</option><% categories.forEach(cat => { %><option value="<%= cat.toLowerCase() %>"><%= cat %></option><% }) %></select>
                <select id="inventorySort" aria-label="Sort products"><option value="newest">Newest first</option><option value="title">Name A–Z</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="stock-low">Stock: low to high</option></select>
              </div>
              <div class="admin-import-export-row">
                <form action="/secret-admin-panel-2026/products/import-csv" method="POST" enctype="multipart/form-data" class="admin-csv-import-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label for="productCsvFile">Import products CSV</label><input id="productCsvFile" type="file" name="csv_file" accept=".csv,text/csv" required><button type="submit" class="admin-small-action">Import CSV</button>
                </form>
                <small>CSV columns: title, category, sku, price, regular_price, cost_price, stock_quantity, low_stock_threshold, variant_options, image, description, is_active</small>
              </div>
              <form action="/secret-admin-panel-2026/products/bulk-action" method="POST" id="productBulkForm" class="admin-bulk-tools"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="bulk_action" id="productBulkAction" required><option value="">Bulk action…</option><option value="activate">Publish selected</option><option value="deactivate">Unpublish selected</option><option value="set_stock">Set stock quantity</option><option value="add_stock">Add stock quantity</option><option value="remove_stock">Remove stock quantity</option><option value="set_category">Change category</option><option value="delete">Delete selected</option></select>
                <input type="number" name="stock_amount" id="bulkStockAmount" min="0" step="1" placeholder="Qty" hidden>
                <input type="text" name="bulk_category" id="bulkCategory" maxlength="80" placeholder="New category" hidden>
                <button type="submit" class="admin-small-action">Apply to selected</button><span class="admin-muted" id="selectedProductCount">0 selected</span>
              </form>
              <div class="table-responsive admin-products-table-wrap">
                <table class="data-table admin-products-table" id="productsTable">
                  <thead><tr><th><input type="checkbox" id="selectAllProducts" aria-label="Select all products"></th><th>Product</th><th>SKU / Category</th><th>Pricing</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead>
                  <tbody id="productsTableBody">
                    <% products.forEach(p => { const stockKnown=!!p.stock_known; const stock=stockKnown?Number(p.stock_quantity):null; const threshold=Number(p.low_stock_threshold ?? settings.low_stock_threshold ?? 5); const low=stockKnown && stock<=threshold; %>
                      <tr class="inventory-row" data-id="<%= p.id %>" data-title="<%= (p.title||'').toLowerCase() %>" data-sku="<%= (p.sku||'').toLowerCase() %>" data-category="<%= (p.category||'').toLowerCase() %>" data-price="<%= Number(p.price)||0 %>" data-stock="<%= stockKnown?stock:-1 %>" data-created="<%= p.created_at||'' %>">
                        <td><input type="checkbox" class="product-row-check" name="selected_products" value="<%= p.id %>" form="productBulkForm" aria-label="Select <%= p.title %>"></td>
                        <td><div class="admin-product-cell"><% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } else { %><span class="admin-product-placeholder">TN</span><% } %><span><strong><%= p.title %></strong><small>#<%= p.id %></small></span></div></td>
                        <td><strong><%= p.sku || '—' %></strong><small class="admin-cell-sub"><%= p.category || 'Uncategorized' %></small></td>
                        <td><strong>৳ <%= Number(p.price||0).toLocaleString('en-BD') %></strong><% if (Number(p.regular_price)>Number(p.price)) { %><small class="admin-cell-sub"><s>৳ <%= Number(p.regular_price).toLocaleString('en-BD') %></s></small><% } %><small class="admin-cell-sub">Cost: ৳ <%= Number(p.cost_price||0).toLocaleString('en-BD') %></small></td>
                        <td><span class="admin-stock-pill <%= !stockKnown?'unknown':stock===0?'out':low?'low':'ok' %>"><%= stockKnown?stock:'Not set' %> <%= stockKnown?'units':'' %></span><small class="admin-cell-sub">Alert at <%= threshold %></small></td>
                        <td><span class="admin-state-pill <%= p.is_active?'published':'draft' %>"><%= p.is_active?'Published':'Draft' %></span></td>
                        <td><div class="admin-row-actions"><button type="button" class="edit-btn" onclick="openEditProductById('<%= p.id %>')">Edit</button><button type="button" class="admin-small-action" onclick="openStockAdjustModal('<%= p.id %>')">Stock</button><form action="/secret-admin-panel-2026/products/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete this product? This cannot be undone.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="delete-btn">Delete</button></form></div></td>
                      </tr>
                    <% }) %>
                    <% if (!products.length) { %><tr><td colspan="7"><div class="admin-empty-state">No products yet. Add your first product using the form.</div></td></tr><% } %>
                  </tbody>
                </table>
              </div>
            </section>
          </div>
        </section>

        <section class="admin-section admin-panel-view" id="editSection" data-admin-panel="products" hidden>
          <div class="admin-section-heading"><div><span class="admin-eyebrow">PRODUCT EDITOR</span><h3>Edit product <span id="editProductIdTitle"></span></h3><p>Update product data without changing its order history.</p></div></div>
          <form id="editProductForm" method="POST" enctype="multipart/form-data" class="admin-product-form"><input type="hidden" name="is_active_present" value="1"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row"><div class="form-group"><label>Product title *</label><input type="text" id="editTitle" name="title" required maxlength="180"></div><div class="form-group"><label>Category *</label><input type="text" id="editCategory" name="category" list="trendzzCategoryOptions" required maxlength="80"></div></div>
            <div class="form-row"><div class="form-group"><label>SKU</label><input type="text" id="editSku" name="sku" maxlength="80"></div><div class="form-group"><label>Selling price (৳) *</label><input type="number" id="editPrice" name="price" min="0.01" step="0.01" required></div><div class="form-group"><label>Regular price (৳)</label><input type="number" id="editRegularPrice" name="regular_price" min="0" step="0.01"></div></div>
            <div class="form-row"><div class="form-group"><label>Cost price (৳)</label><input type="number" id="editCostPrice" name="cost_price" min="0" step="0.01"></div><div class="form-group"><label>Stock quantity</label><input type="number" id="editStockQty" name="stock_quantity" min="0" step="1"></div><div class="form-group"><label>Low-stock threshold</label><input type="number" id="editLowStock" name="low_stock_threshold" min="0" step="1"></div></div>
            <div class="upload-box"><label>Upload a replacement image (optional)</label><input type="file" name="image_file" accept="image/jpeg,image/png,image/webp,image/gif" data-image-preview-input="editProductPreview"><img id="editProductPreview" class="admin-image-preview" alt="New product image preview" hidden><label>Image URL</label><input type="url" id="editImage" name="image"></div>
            <div class="form-group"><label>Variants (comma separated)</label><input type="text" id="editVariants" name="variant_options"></div><div class="form-group"><label>Description</label><textarea id="editDesc" name="description" rows="4" maxlength="12000"></textarea></div>
            <label class="admin-check-label"><input type="checkbox" id="editIsActive" name="is_active" checked> Published on storefront</label>
            <div class="admin-inline-actions"><button type="submit" class="save-settings-btn">Save product changes</button><button type="button" class="admin-secondary-action" onclick="document.getElementById('editSection').hidden=true">Cancel</button></div>
          </form>
        </section>

        <dialog id="stockAdjustDialog" class="admin-dialog">
          <form id="stockAdjustForm" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="admin-section-heading"><div><span class="admin-eyebrow">INVENTORY CONTROL</span><h3>Adjust stock</h3><p id="stockAdjustProductName"></p></div><button type="button" class="admin-dialog-close" onclick="document.getElementById('stockAdjustDialog').close()" aria-label="Close">×</button></div>
            <label>Adjustment type<select name="adjustment_type" required><option value="add">Add stock</option><option value="remove">Remove stock</option><option value="set">Set exact quantity</option></select></label>
            <label>Quantity<input type="number" name="quantity" min="0" step="1" required value="1"></label>
            <label>Reason<input type="text" name="reason" maxlength="500" placeholder="Restock, damage, correction…"></label>
            <button class="save-settings-btn" type="submit">Save stock adjustment</button>
          </form>
        </dialog>

        <section class="admin-section admin-panel-view" id="adminCategoriesPanel" data-admin-panel="categories">
          <div class="admin-section-heading"><div><span class="admin-eyebrow">CATALOG STRUCTURE</span><h3>Product categories</h3><p>Manage category names used by product listings. Existing products are kept when categories are renamed or reassigned.</p></div></div>
          <form action="/secret-admin-panel-2026/categories/add" method="POST" class="admin-inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="text" name="category" maxlength="80" required placeholder="New category name"><button class="admin-small-action" type="submit">＋ Add category</button></form>
          <div class="table-responsive"><table class="data-table"><thead><tr><th>Category</th><th>Products</th><th>Rename</th><th>Remove / Reassign</th></tr></thead><tbody>
            <% categories.forEach(cat => { const count=products.filter(p => String(p.category||'Uncategorized')===cat).length; %>
              <tr><td><strong><%= cat %></strong></td><td><%= count %></td><td><form action="/secret-admin-panel-2026/categories/rename" method="POST" class="admin-inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="old_category" value="<%= cat %>"><input type="text" name="new_category" maxlength="80" required placeholder="New name"><button type="submit" class="admin-small-action">Rename</button></form></td><td><form action="/secret-admin-panel-2026/categories/reassign-delete" method="POST" class="admin-inline-form" onsubmit="return confirm('Move all products to the replacement category?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category" value="<%= cat %>"><input type="text" name="replacement_category" maxlength="80" value="Uncategorized" required><button class="delete-btn" type="submit">Reassign</button></form></td></tr>
            <% }) %>
          </tbody></table></div>
        </section>

        <section class="admin-section admin-panel-view" id="adminCustomersPanel" data-admin-panel="customers">
          <div class="admin-section-heading"><div><span class="admin-eyebrow">CUSTOMER RELATIONSHIPS</span><h3>Customers <span class="admin-count-pill"><%= customers.length %></span></h3><p>Customer information is grouped from order records; phone and address details stay inside the protected admin area.</p></div><button type="button" class="export-btn" onclick="exportCustomersCSV()">↓ Export customers CSV</button></div>
          <div class="admin-table-tools"><input type="search" id="customerSearch" placeholder="Search customer name, phone or email…"><span class="admin-muted">Unique phone numbers with orders</span></div>
          <div class="table-responsive"><table class="data-table" id="customersTable"><thead><tr><th>Customer</th><th>Phone</th><th>Email</th><th>Orders</th><th>Non-cancelled order value</th><th>Last order</th></tr></thead><tbody>
            <% customers.forEach(c => { %><tr class="customer-row"><td><strong><%= c.name || 'Customer' %></strong></td><td><a href="tel:<%= c.phone %>"><%= c.phone %></a></td><td><%= c.email || '—' %></td><td><%= c.orderCount %></td><td>৳ <%= Number(c.totalSpend||0).toLocaleString('en-BD') %></td><td><%= c.lastOrderAt ? new Date(c.lastOrderAt).toLocaleString() : '—' %></td></tr><% }) %>
