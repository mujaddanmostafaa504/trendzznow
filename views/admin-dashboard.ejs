                </section>

                <!-- 6. COMMERCE & COURIER SETTINGS PANE -->
                <section id="pane-commerce" class="admin-pane">
                    <div class="pane-header-bar">
                        <div>
                            <h2>Commerce, Delivery, Payment & Courier Configuration</h2>
                            <p>Configure delivery charges, COD rules, bKash/Nagad numbers, promo coupons, and courier API keys</p>
                        </div>
                    </div>

                    <form action="/secret-admin-panel-2026/settings/update" method="POST" class="saas-card tracked-form">
