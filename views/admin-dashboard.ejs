<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - TrendzzNow</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .action-btn-group { display: flex; gap: 6px; flex-wrap: wrap; }
        .print-btn { background-color: #0984e3; color: #fff; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .print-btn:hover { background-color: #0769b5; }
        .copy-btn { background-color: #00b894; color: #fff; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .copy-btn:hover { background-color: #00997b; }
        .edit-btn { background-color: #fdcb6e; color: #222; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; text-decoration: none; display: inline-block; }
        .edit-btn:hover { background-color: #e1b12c; }
        .export-btn { background-color: #6c5ce7; color: #fff; border: none; padding: 8px 14px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600; text-decoration: none; }
        .export-btn:hover { background-color: #5849d4; }
    </style>
</head>
<body class="admin-body">
    <header class="admin-header">
        <div class="admin-brand">
            <h2>⚡ TrendzzNow Master Dashboard</h2>
            <span class="live-badge">● Live Connected</span>
        </div>
        <div class="admin-header-actions">
            <a href="/" target="_blank" class="view-site-btn">🌐 View Website</a>
            <a href="/admin/logout" class="logout-btn">Logout</a>
        </div>
    </header>

    <div class="admin-container">
        <% if (msg) { %>
            <div class="success-banner">
                <span>✅ <%= msg %></span>
                <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;color:#155724;font-weight:bold;cursor:pointer;">&times;</button>
            </div>
        <% } %>

        <%
            let totalRevenue = 0;
            let pendingCount = 0;
            orders.forEach(o => {
                if (o.status !== 'Cancelled') {
                    totalRevenue += (parseFloat(o.price) || 0);
                }
                if (!o.status || o.status === 'Pending') {
                    pendingCount++;
                }
            });
        %>

        <!-- Quick Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-title">Total Orders (Pending)</span>
                <span class="stat-num"><%= orders.length %> <small style="font-size:14px; color:#e17055;">(<%= pendingCount %> pending)</small></span>
            </div>
            <div class="stat-card">
                <span class="stat-title">Total Sales Value</span>
                <span class="stat-num" style="color:#00b894;">৳ <%= totalRevenue %></span>
            </div>
            <div class="stat-card">
                <span class="stat-title">Total Products</span>
                <span class="stat-num"><%= products.length %></span>
            </div>
            <div class="stat-card">
                <span class="stat-title">WhatsApp Hotline</span>
                <span class="stat-num" style="font-size: 18px;"><%= settings.whatsapp_number || '01731763504' %></span>
            </div>
        </div>

        <!-- 1. Customer Orders Management -->
        <section class="admin-section">
            <div class="sec-head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:10px;">
                <h3 style="margin:0; border:none;">📦 Customer Orders (<%= orders.length %>)</h3>
                <div style="display:flex; gap:10px;">
                    <button onclick="exportOrdersCSV()" class="export-btn">📥 Export CSV (Excel)</button>
                    <button onclick="window.print()" class="print-btn" style="padding: 8px 14px; font-size: 13px;">🖨️ Print Order List</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="data-table" id="ordersTable">
                    <thead>
                        <tr>
                            <th>ID & Date</th>
                            <th>Customer & Phone</th>
                            <th>Product</th>
                            <th>Total</th>
                            <th>Address & Payment Details</th>
                            <th>Status Update</th>
                            <th>Print / Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length > 0) { %>
                            <% orders.forEach(o => { 
                                const dateFormatted = o.created_at ? new Date(o.created_at).toLocaleDateString() : '-';
                            %>
                                <tr>
                                    <td>
                                        <strong>#<%= o.id %></strong><br>
                                        <small style="color:#666;"><%= dateFormatted %></small>
                                    </td>
                                    <td>
                                        <strong><%= o.customer_name %></strong><br>
                                        <a href="tel:<%= o.phone %>" style="color:#9c1448;text-decoration:none;font-weight:600;"><%= o.phone %></a>
                                        <br>
                                        <a href="https://wa.me/88<%= (o.phone || '').replace(/^\+?88/, '') %>" target="_blank" style="font-size:12px;color:#25D366;font-weight:bold;">💬 WhatsApp</a>
                                    </td>
                                    <td><strong><%= o.product_title %></strong></td>
                                    <td><span class="price-pill">৳ <%= o.price %></span></td>
                                    <td style="max-width: 250px; font-size: 13px; line-height: 1.4;"><%= o.address %></td>
                                    <td>
                                        <form action="/admin/orders/status/<%= o.id %>" method="POST" style="display:flex; gap:5px; align-items:center;">
                                            <select name="status" class="status-select">
                                                <option value="Pending" <%= o.status === 'Pending' ? 'selected' : '' %>>⏳ Pending</option>
                                                <option value="Confirmed" <%= o.status === 'Confirmed' ? 'selected' : '' %>>✅ Confirmed</option>
                                                <option value="Sent to SteadFast" <%= o.status === 'Sent to SteadFast' ? 'selected' : '' %>>🚚 Sent to SteadFast</option>
                                                <option value="Sent to Pathao" <%= o.status === 'Sent to Pathao' ? 'selected' : '' %>>🛵 Sent to Pathao</option>
                                                <option value="Delivered" <%= o.status === 'Delivered' ? 'selected' : '' %>>🎉 Delivered</option>
                                                <option value="Cancelled" <%= o.status === 'Cancelled' ? 'selected' : '' %>>❌ Cancelled</option>
                                            </select>
                                            <button type="submit" class="mini-save-btn">Save</button>
                                        </form>
                                    </td>
                                    <td>
                                        <div class="action-btn-group">
                                            <button type="button" class="print-btn" 
                                                data-id="<%= o.id %>"
                                                data-name="<%= o.customer_name || '' %>"
                                                data-phone="<%= o.phone || '' %>"
                                                data-address="<%= o.address || '' %>"
                                                data-product="<%= o.product_title || '' %>"
                                                data-price="<%= o.price %>"
                                                data-status="<%= o.status || 'Pending' %>"
                                                data-date="<%= dateFormatted %>"
                                                onclick="printInvoiceBtn(this)">
                                                🖨️ Print Slip
                                            </button>

                                            <button type="button" class="copy-btn" 
                                                data-name="<%= o.customer_name || '' %>"
                                                data-phone="<%= o.phone || '' %>"
                                                data-address="<%= o.address || '' %>"
                                                data-product="<%= o.product_title || '' %>"
                                                data-price="<%= o.price %>"
                                                onclick="copyCustomerBtn(this)">
                                                📋 Copy
                                            </button>

                                            <form action="/admin/orders/delete/<%= o.id %>" method="POST" onsubmit="return confirm('Delete this order?');" style="display:inline;">
                                                <button type="submit" class="delete-btn">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="7" style="text-align: center; padding: 25px; color:#777;">No orders yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 2. Add & Manage Products -->
        <div class="two-col-grid">
            <section class="admin-section">
                <h3>➕ Add New Product</h3>
                <form action="/admin/products/add" method="POST">
                    <div class="form-group">
                        <label>Product Title *</label>
                        <input type="text" name="title" required placeholder="e.g. Dynamic Leaf Table Lamp">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Selling Price (BDT) *</label>
                            <input type="number" name="price" required placeholder="950">
                        </div>
                        <div class="form-group">
                            <label>Regular Price (Strike-through)</label>
                            <input type="number" name="regular_price" placeholder="1250">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Image Direct URL</label>
                        <input type="text" name="image" placeholder="https://...">
                    </div>
                    <div class="form-group">
                        <label>Variants (comma separated, e.g. Cream, Black, Wood)</label>
                        <input type="text" name="variant_options" placeholder="Cream, Black, Wood">
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="description" rows="3" placeholder="Product details..."></textarea>
                    </div>
                    <button type="submit" class="add-product-btn">➕ Add Product to Store</button>
                </form>
            </section>

            <section class="admin-section">
                <h3>🛍️ Existing Products (<%= products.length %>)</h3>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Name & Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (products.length > 0) { %>
                                <% products.forEach(p => { %>
                                    <tr>
                                        <td>
                                            <% if (p.image) { %>
                                                <img src="<%= p.image %>" width="40" height="40" style="object-fit:cover; border-radius:4px;">
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                        <td>
                                            <strong><%= p.title %></strong><br>
                                            <span class="price-pill">৳ <%= p.price %></span>
                                            <br><a href="/product/<%= p.id %>" target="_blank" style="font-size:11px; color:#0984e3;">View SEO Page ↗</a>
                                        </td>
                                        <td>
                                            <div style="display:flex; gap:5px;">
                                                <button type="button" class="edit-btn"
                                                    data-id="<%= p.id %>"
                                                    data-title="<%= p.title || '' %>"
                                                    data-price="<%= p.price %>"
                                                    data-regprice="<%= p.regular_price || '' %>"
                                                    data-image="<%= p.image || '' %>"
                                                    data-variants="<%= p.variant_options || '' %>"
                                                    data-desc="<%= p.description || '' %>"
                                                    onclick="populateEditBtn(this)">Edit</button>
                                                
                                                <form action="/admin/products/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete product?');">
                                                    <button type="submit" class="delete-btn">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="3" style="text-align:center;color:#888;">No products</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <!-- Edit Product Hidden Section -->
        <section class="admin-section" id="editSection" style="display:none; background:#fff8e5; border:1px solid #ffd166;">
            <h3>✏️ Edit Product (<span id="editProductIdTitle"></span>)</h3>
            <form id="editProductForm" method="POST">
                <div class="form-group">
                    <label>Product Title *</label>
                    <input type="text" id="editTitle" name="title" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Selling Price (BDT) *</label>
                        <input type="number" id="editPrice" name="price" required>
                    </div>
                    <div class="form-group">
                        <label>Regular Price</label>
                        <input type="number" id="editRegularPrice" name="regular_price">
                    </div>
                </div>
                <div class="form-group">
                    <label>Image URL</label>
                    <input type="text" id="editImage" name="image">
                </div>
                <div class="form-group">
                    <label>Variants (comma separated)</label>
                    <input type="text" id="editVariants" name="variant_options">
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea id="editDesc" name="description" rows="3"></textarea>
                </div>
                <div style="display:flex; gap:10px;">
                    <button type="submit" class="save-settings-btn" style="flex:1;">💾 Save Changes</button>
                    <button type="button" onclick="cancelEdit()" style="background:#666; color:#fff; border:none; padding:10px 18px; border-radius:6px; cursor:pointer;">Cancel</button>
                </div>
            </form>
        </section>

        <!-- 3. Store Settings, Promo Code & Facebook Pixel -->
        <section class="admin-section">
            <h3>⚙️ Store, Payment, Courier, Promo Code & Pixel Settings</h3>
            <form action="/admin/settings/update" method="POST">
                <div class="form-row">
                    <div class="form-group">
                        <label>📞 Official WhatsApp Number</label>
                        <input type="text" name="whatsapp_number" value="<%= settings.whatsapp_number || '01731763504' %>">
                    </div>
                    <div class="form-group">
                        <label>📲 bKash Number (Send Money)</label>
                        <input type="text" name="bkash_number" value="<%= settings.bkash_number || '01731763504' %>">
                    </div>
                    <div class="form-group">
                        <label>📲 Nagad Number (Send Money)</label>
                        <input type="text" name="nagad_number" value="<%= settings.nagad_number || '01731763504' %>">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>🚚 Inside Dhaka Delivery Charge (৳)</label>
                        <input type="number" name="delivery_inside_dhaka" value="<%= settings.delivery_inside_dhaka || '70' %>">
                    </div>
                    <div class="form-group">
                        <label>🚚 Outside Dhaka Delivery Charge (৳)</label>
                        <input type="number" name="delivery_outside_dhaka" value="<%= settings.delivery_outside_dhaka || '130' %>">
                    </div>
                    <div class="form-group">
                        <label>📦 Courier Partners</label>
                        <input type="text" name="courier_partners" value="<%= settings.courier_partners || 'SteadFast Courier, Pathao, RedX' %>">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>🎟️ Active Promo Code</label>
                        <input type="text" name="promo_code" value="<%= settings.promo_code || 'TREND50' %>" placeholder="TREND50">
                    </div>
                    <div class="form-group">
                        <label>💰 Promo Discount Amount (৳)</label>
                        <input type="number" name="promo_discount" value="<%= settings.promo_discount || '50' %>" placeholder="50">
                    </div>
                    <div class="form-group">
                        <label>📊 Facebook Pixel ID</label>
                        <input type="text" name="facebook_pixel" value="<%= settings.facebook_pixel || '' %>" placeholder="Optional">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>🖼️ Logo URL</label>
                        <input type="text" name="logo_light" value="<%= settings.logo_light || '' %>">
                    </div>
                    <div class="form-group">
                        <label>✨ Hero Section Title (English)</label>
                        <input type="text" name="hero_title_en" value="<%= settings.hero_title_en || 'Premium Lifestyle & Home Decor Collection' %>">
                    </div>
                </div>

                <button type="submit" class="save-settings-btn">💾 Save All Settings</button>
            </form>
        </section>

        <!-- 4. Anytime Admin Password Change -->
        <section class="admin-section password-box">
            <h3>🔐 Change Admin Password Anytime</h3>
            <p style="font-size: 13px; color: #555; margin-top: -5px; margin-bottom: 15px;">
                Changes are saved directly in Supabase. No need to redeploy Render!
            </p>
            <form action="/admin/password/change" method="POST">
                <div class="form-row">
                    <div class="form-group">
                        <label>New Password *</label>
                        <input type="password" name="new_password" required placeholder="Min 4 characters">
                    </div>
                    <div class="form-group">
                        <label>Confirm New Password *</label>
                        <input type="password" name="confirm_password" required placeholder="Retype new password">
                    </div>
                </div>
                <button type="submit" class="change-pass-btn">🔑 Update Admin Password</button>
            </form>
        </section>
    </div>

    <!-- Clean Safe Scripts using dataset -->
    <script>
        function populateEditBtn(btn) {
            const d = btn.dataset;
            document.getElementById('editSection').style.display = 'block';
            document.getElementById('editProductForm').action = '/admin/products/edit/' + d.id;
            document.getElementById('editProductIdTitle').innerText = '#' + d.id;
            document.getElementById('editTitle').value = d.title || '';
            document.getElementById('editPrice').value = d.price || '';
            document.getElementById('editRegularPrice').value = d.regprice || '';
            document.getElementById('editImage').value = d.image || '';
            document.getElementById('editVariants').value = d.variants || '';
            document.getElementById('editDesc').value = d.desc || '';
            window.scrollTo({ top: document.getElementById('editSection').offsetTop - 50, behavior: 'smooth' });
        }

        function cancelEdit() {
            document.getElementById('editSection').style.display = 'none';
        }

        function printInvoiceBtn(btn) {
            const d = btn.dataset;
            const storePhone = "<%= settings.whatsapp_number || '01731763504' %>";
            const printWindow = window.open('', '_blank', 'width=700,height=650');
            const htmlContent = `
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="UTF-8">
                    <title>Invoice #${d.id} - TrendzzNow</title>
                    <style>
                        body { font-family: 'Segoe UI', Arial, sans-serif; padding: 25px; color: #111; }
                        .slip-box { border: 2px dashed #222; padding: 25px; max-width: 550px; margin: 0 auto; border-radius: 8px; }
                        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #222; padding-bottom: 12px; margin-bottom: 15px; }
                        .brand { font-size: 26px; font-weight: 800; color: #9c1448; }
                        .sub { font-size: 13px; color: #444; }
                        .section-title { font-size: 13px; text-transform: uppercase; color: #555; font-weight: bold; margin-bottom: 4px; }
                        .customer-box { background: #f8f9fa; padding: 14px; border: 1px solid #ddd; border-radius: 6px; margin-bottom: 15px; }
                        .customer-box p { margin: 5px 0; font-size: 15px; }
                        .order-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
                        .order-table th, .order-table td { border: 1px solid #ccc; padding: 10px; text-align: left; font-size: 14px; }
                        .cod-banner { text-align: center; border: 2px solid #111; padding: 12px; font-size: 20px; font-weight: bold; margin-top: 10px; background: #eee; }
                        .footer { text-align: center; font-size: 12px; color: #555; margin-top: 15px; }
                        @media print { .no-print { display: none; } body { padding: 0; } }
                    </style>
                </head>
                <body>
                    <div class="no-print" style="text-align:center; margin-bottom:15px;">
                        <button onclick="window.print()" style="background:#9c1448;color:#fff;border:none;padding:10px 20px;font-size:15px;font-weight:bold;border-radius:6px;cursor:pointer;">🖨️ Print / Save as PDF</button>
                    </div>
                    <div class="slip-box">
                        <div class="header">
                            <div>
                                <div class="brand">TrendzzNow</div>
                                <div class="sub">🌐 www.trendzznow.com | 📞 ${storePhone}</div>
                            </div>
                            <div style="text-align: right;">
                                <strong>INVOICE #${d.id}</strong><br>
                                <span style="font-size:13px;">Date: ${d.date}</span><br>
                                <span style="font-size:12px;">Status: ${d.status}</span>
                            </div>
                        </div>

                        <div class="section-title">📦 Customer Details (Delivery To):</div>
                        <div class="customer-box">
                            <p><strong>Name:</strong> ${d.name}</p>
                            <p><strong>Phone:</strong> <span style="font-size:17px;font-weight:bold;">${d.phone}</span></p>
                            <p><strong>Address & Info:</strong> ${d.address}</p>
                        </div>

                        <table class="order-table">
                            <thead>
                                <tr>
                                    <th>Product Details</th>
                                    <th style="text-align:right;">Total Bill</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>${d.product}</strong></td>
                                    <td style="text-align:right; font-weight:bold; font-size:16px;">৳ ${d.price}</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="cod-banner">
                            Total Payable (COD): ৳ ${d.price} /=
                        </div>

                        <div class="footer">
                            Thank you for shopping with TrendzzNow!
                        </div>
                    </div>
                </body>
                </html>
            `;
            printWindow.document.open();
            printWindow.document.write(htmlContent);
            printWindow.document.close();
        }

        function copyCustomerBtn(btn) {
            const d = btn.dataset;
            const text = `Name: ${d.name}\nPhone: ${d.phone}\nAddress: ${d.address}\nProduct: ${d.product}\nTotal: ৳${d.price}`;
            navigator.clipboard.writeText(text).then(() => {
                alert('✅ Customer info copied to clipboard!');
            });
        }

        function exportOrdersCSV() {
            const table = document.getElementById('ordersTable');
            let csv = [];
            for (let i = 0; i < table.rows.length; i++) {
                let row = [], cols = table.rows[i].querySelectorAll('td, th');
                for (let j = 0; j < cols.length - 1; j++) {
                    let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/"/g, '""');
                    row.push('"' + data + '"');
                }
                csv.push(row.join(','));
            }
            let csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: 'text/csv;charset=utf-8;' });
            let downloadLink = document.createElement('a');
            downloadLink.download = 'trendzznow_orders.csv';
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = 'none';
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
</body>
</html>
