                                <input type="url" id="ogInspectUrl" placeholder="https://trendzznow.com/product/1" style="flex:1; padding:10px; border:1px solid #cbd5e1; border-radius:8px;">
                                <button type="button" class="btn-primary-sm" onclick="extractOgMetadata()">Extract OG</button>
