    <script>
        const allProductsMap = <%- JSON.stringify(products.reduce((acc, item) => { acc[item.id] = item; return acc; }, {})).replace(/</g, '\\u003c') %>;
        const allOrdersMap = <%- JSON.stringify(orders.reduce((acc, item) => { acc[item.id] = item; return acc; }, {})).replace(/</g, '\\u003c') %>;


        const adminViewMeta = {
            overview: { title: 'Overview', heading: 'Store overview', description: 'A live view of your orders, sales and product inventory.' },
            orders: { title: 'Orders', heading: 'Customer orders', description: 'Review customer details, manage fulfilment and update delivery status.' },
            products: { title: 'Products & Stock', heading: 'Products & inventory', description: 'Manage products, pricing, variants, stock and CSV operations.' },
            categories: { title: 'Categories', heading: 'Product categories', description: 'Organise category names and safely reassign products.' },
            customers: { title: 'Customers', heading: 'Customer directory', description: 'Review customer order history summaries and export customer records.' },
            analytics: { title: 'Analytics', heading: 'Store performance', description: 'Review delivered revenue, order trends and inventory value.' },
            history: { title: 'Stock & Audit History', heading: 'Operational history', description: 'Review stock movements and administrator actions.' },
            settings: { title: 'Storefront & Policies', heading: 'Storefront settings', description: 'Manage homepage content, brand identity, delivery details and existing FAQ entries.' },
            security: { title: 'Security', heading: 'Admin security', description: 'Review session protection and manage deployment secrets safely.' }
        };
        function showAdminView(view) {
            const selected = adminViewMeta[view] ? view : 'overview';
            document.querySelectorAll('[data-admin-panel]').forEach(panel => {
                panel.hidden = panel.dataset.adminPanel !== selected;
            });
            document.querySelectorAll('[data-admin-view]').forEach(button => {
                const active = button.dataset.adminView === selected;
                button.classList.toggle('active', active);
                button.setAttribute('aria-current', active ? 'page' : 'false');
            });
            const meta = adminViewMeta[selected];
            document.getElementById('adminHeaderTitle').textContent = meta.title;
            document.getElementById('adminPageTitle').textContent = meta.heading;
            document.getElementById('adminPageDescription').textContent = meta.description;
            const editSection = document.getElementById('editSection');
            if (editSection && selected !== 'products') editSection.hidden = true;
            document.getElementById('adminSidebar').classList.remove('is-open');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            history.replaceState(null, '', `#${selected}`);
        }
        document.querySelectorAll('[data-admin-view]').forEach(button => button.addEventListener('click', () => showAdminView(button.dataset.adminView)));
        document.querySelectorAll('[data-admin-jump]').forEach(button => button.addEventListener('click', () => showAdminView(button.dataset.adminJump)));
        document.getElementById('adminMobileMenu')?.addEventListener('click', () => document.getElementById('adminSidebar').classList.toggle('is-open'));
        const initialAdminView = location.hash.replace('#', '');
        showAdminView(adminViewMeta[initialAdminView] ? initialAdminView : 'overview');

        document.getElementById('orderSearch')?.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            document.querySelectorAll('.order-row').forEach(row => {
                row.dataset.searchMatch = row.innerText.toLowerCase().includes(query) ? 'yes' : 'no';
                const activeTab = document.querySelector('.tab-btn.active')?.dataset.filterCategory || 'all';
                const statusMatch = activeTab === 'all' || row.dataset.status === activeTab;
                row.style.display = (!query || row.dataset.searchMatch === 'yes') && statusMatch ? '' : 'none';
            });
        });
        function toggleSelectAll(master) {
            const checkboxes = document.querySelectorAll('.order-chk');
            checkboxes.forEach(chk => {
                const row = chk.closest('tr');
                if (row.style.display !== 'none') {
                    chk.checked = master.checked;
                }
            });
        }

        function filterOrderTab(category, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.tab-btn').forEach(b => { b.dataset.filterCategory = b === btn ? category : (b.dataset.filterCategory || ''); });

            const rows = document.querySelectorAll('.order-row');
            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                const query = (document.getElementById('orderSearch')?.value || '').trim().toLowerCase();
                const searchMatch = !query || row.innerText.toLowerCase().includes(query);
                row.style.display = (category === 'all' || status === category) && searchMatch ? '' : 'none';
            });
        }

        function openEditProductById(id) {
            const p = allProductsMap[id];
            if (!p) return alert('Product data not found!');
            document.getElementById('editSection').hidden = false;
            document.getElementById('editProductForm').action = '/secret-admin-panel-2026/products/edit/' + p.id;
            document.getElementById('editProductIdTitle').innerText = '#' + p.id + ' - ' + (p.title || '');
            document.getElementById('editTitle').value = p.title || '';
            document.getElementById('editCategory').value = p.category || 'Trending';
            document.getElementById('editPrice').value = p.price || '';
            document.getElementById('editRegularPrice').value = p.regular_price || '';
            document.getElementById('editCostPrice').value = p.cost_price || '';
            document.getElementById('editStockQty').value = p.stock_known ? p.stock_quantity : '';
            document.getElementById('editImage').value = p.image || '';
            document.getElementById('editVariants').value = p.variant_options || '';
            document.getElementById('editDesc').value = p.description || '';
            document.getElementById('editSku').value = p.sku || '';
            document.getElementById('editLowStock').value = p.low_stock_threshold ?? 5;
            document.getElementById('editIsActive').checked = p.is_active !== false;
            if (p.image) { document.getElementById('editProductPreview').src = p.image; document.getElementById('editProductPreview').hidden = false; }
            document.getElementById('editSection').hidden = false;
            document.getElementById('editSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function openStockAdjustModal(id) {
            const product = allProductsMap[id];
            if (!product) return;
            document.getElementById('stockAdjustForm').action = '/secret-admin-panel-2026/inventory/adjust/' + encodeURIComponent(id);
            document.getElementById('stockAdjustProductName').textContent = (product.title || 'Product') + ' · Current stock: ' + (product.stock_known ? product.stock_quantity : 'Not set');
            document.getElementById('stockAdjustDialog').showModal();
        }

        function updateSelectedProductsCount() {
            const count = document.querySelectorAll('.product-row-check:checked').length;
            const label = document.getElementById('selectedProductCount');
            if (label) label.textContent = count + ' selected';
        }
        document.getElementById('selectAllProducts')?.addEventListener('change', function () {
            document.querySelectorAll('.product-row-check').forEach(box => { if (box.closest('tr').style.display !== 'none') box.checked = this.checked; });
            updateSelectedProductsCount();
        });
        document.querySelectorAll('.product-row-check').forEach(box => box.addEventListener('change', updateSelectedProductsCount));
        document.getElementById('productBulkAction')?.addEventListener('change', function () {
            document.getElementById('bulkStockAmount').hidden = !['set_stock','add_stock','remove_stock'].includes(this.value);
            document.getElementById('bulkCategory').hidden = this.value !== 'set_category';
        });
        document.getElementById('productBulkForm')?.addEventListener('submit', function (event) {
            const count = document.querySelectorAll('.product-row-check:checked').length;
            if (!count) { event.preventDefault(); alert('Select at least one product.'); return; }
            if (this.bulk_action.value === 'delete' && !confirm('Delete ' + count + ' selected product(s)? This cannot be undone.')) event.preventDefault();
        });
        function applyInventoryFilters() {
            const query = (document.getElementById('inventorySearch')?.value || '').trim().toLowerCase();
            const category = (document.getElementById('inventoryCategoryFilter')?.value || '').toLowerCase();
            const rows = [...document.querySelectorAll('.inventory-row')];
            rows.forEach(row => {
                const matchesQuery = !query || [row.dataset.title,row.dataset.sku,row.dataset.category].join(' ').includes(query);
                const matchesCategory = !category || row.dataset.category === category;
                row.style.display = matchesQuery && matchesCategory ? '' : 'none';
            });
            const sort = document.getElementById('inventorySort')?.value || 'newest';
            const tbody = document.getElementById('productsTableBody');
            rows.sort((a,b) => {
                if (sort === 'title') return a.dataset.title.localeCompare(b.dataset.title);
                if (sort === 'price-low') return Number(a.dataset.price)-Number(b.dataset.price);
                if (sort === 'price-high') return Number(b.dataset.price)-Number(a.dataset.price);
                if (sort === 'stock-low') return Number(a.dataset.stock)-Number(b.dataset.stock);
                return new Date(b.dataset.created || 0)-new Date(a.dataset.created || 0);
            }).forEach(row => tbody.appendChild(row));
        }
        ['inventorySearch','inventoryCategoryFilter','inventorySort'].forEach(id => document.getElementById(id)?.addEventListener(id==='inventorySearch'?'input':'change', applyInventoryFilters));
        document.getElementById('customerSearch')?.addEventListener('input', function () {
            const query=this.value.trim().toLowerCase();
            document.querySelectorAll('.customer-row').forEach(row => row.style.display=row.innerText.toLowerCase().includes(query)?'':'none');
        });
        document.querySelectorAll('[data-image-preview-input]').forEach(input => input.addEventListener('change', function () {
            const target=document.getElementById(this.dataset.imagePreviewInput); const file=this.files&&this.files[0];
            if (!target || !file) { if(target) target.hidden=true; return; }
            if (!/^image\/(jpeg|png|webp|gif)$/.test(file.type) || file.size>5*1024*1024) { alert('Choose a JPG, PNG, WebP or GIF image under 5 MB.'); this.value=''; target.hidden=true; return; }
            target.src=URL.createObjectURL(file); target.hidden=false;
        }));
        function exportCustomersCSV() {
            const table=document.getElementById('customersTable'); if(!table)return;
            const rows=[...table.querySelectorAll('tr')].map(row=>[...row.querySelectorAll('th,td')].map(cell=>{let v=cell.innerText.replace(/[\r\n]+/g,' ');if(/^[=+@\-\t\r]/.test(v))v='\''+v;return '"'+v.replace(/"/g,'""')+'"';}).join(','));
            const link=document.createElement('a'); link.download='trendzznow-customers.csv'; link.href=URL.createObjectURL(new Blob(['\uFEFF'+rows.join('\r\n')],{type:'text/csv;charset=utf-8'})); link.click(); URL.revokeObjectURL(link.href);
        }

        function escapePrintText(value) {
            return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
        }
        function printShippingLabel(id) {
            const d = allOrdersMap[id];
            if (!d) return;
            const win = window.open('', '_blank', 'width=500,height=600');
            if (!win) return alert('Allow pop-ups to print this label.');
            win.document.write(`<html><body style="font-family:Arial;padding:25px;border:3px solid #000;"><h2 style="text-align:center;margin-top:0;">SHIPPING LABEL</h2><hr><p><strong>Order ID:</strong> #${escapePrintText(d.id)}</p><p><strong>Customer Name:</strong> ${escapePrintText(d.customer_name)}</p><p><strong>Phone:</strong> ${escapePrintText(d.phone)}</p><p><strong>Delivery Address:</strong> ${escapePrintText(d.address)}</p><hr><p><strong>Product:</strong> ${escapePrintText(d.product_title)}</p><h3>COD Amount: ৳${escapePrintText(d.price)}</h3><p style="text-align:center;font-size:12px;margin-top:30px;">TrendzzNow Courier Dispatch Label</p><script>window.print();<\/script></body></html>`);
            win.document.close();
        }

        function printInvoiceById(id) {
            const d = allOrdersMap[id];
            if (!d) return;
            const win = window.open('', '_blank', 'width=650,height=600');
            if (!win) return alert('Allow pop-ups to print this invoice.');
            win.document.write(`<html><body style="font-family:Arial;padding:20px;"><div style="border:2px dashed #222;padding:20px;"><h2>TrendzzNow Invoice #${escapePrintText(d.id)}</h2><p><strong>Name:</strong> ${escapePrintText(d.customer_name)}</p><p><strong>Phone:</strong> ${escapePrintText(d.phone)}</p><p><strong>Address:</strong> ${escapePrintText(d.address)}</p><p><strong>Product:</strong> ${escapePrintText(d.product_title)}</p><h3>Total COD: ৳${escapePrintText(d.price)}</h3></div><script>window.print();<\/script></body></html>`);
            win.document.close();
        }

        function copyCustomerById(id) {
            const d = allOrdersMap[id];
            if (!d) return;
            navigator.clipboard.writeText(`Name: ${d.customer_name}\nPhone: ${d.phone}\nAddress: ${d.address}\nProduct: ${d.product_title}\nTotal: ৳${d.price}`).then(() => alert('Copied!'));
        }

        function exportOrdersCSV() {
            const table = document.getElementById('ordersTable');
            let csv = [];
            for (let i = 0; i < table.rows.length; i++) {
                let row = [], cols = table.rows[i].querySelectorAll('td, th');
                for (let j = 0; j < cols.length - 1; j++) {
                    let value = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, ' ');
                    if (/^[=+@\-\t\r]/.test(value)) value = "'" + value;
                    row.push('"' + value.replace(/"/g, '""') + '"');
                }
                csv.push(row.join(','));
            }
            let link = document.createElement('a');
            link.download = 'trendzznow_enterprise_orders.csv';
            link.href = window.URL.createObjectURL(new Blob(["\uFEFF" + csv.join("\n")], { type: 'text/csv;charset=utf-8;' }));
            link.click();
        }
    </script>
    <script src="/admin-upgrade.js" defer></script>
</body>
</html>
