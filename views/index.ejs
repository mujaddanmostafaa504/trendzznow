<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.site_title || 'TrendzzNow - Stay on trend. Stay in style.' %></title>
    <link rel="canonical" href="https://trendzznow.com/">
    
    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:title" content="<%= settings.site_title || 'TrendzzNow - Stay on trend. Stay in style.' %>">
    <meta property="og:description" content="<%= settings.hero_subtitle_en || 'Discover trending gadgets, lamps, and everyday essentials with cash on delivery.' %>">
    <meta property="og:image" content="<%= settings.logo_light || 'https://trendzznow.com/images/banner.jpg' %>">
    <meta property="og:url" content="https://trendzznow.com">
    <meta property="og:type" content="website">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= settings.site_title || 'TrendzzNow - Stay on trend. Stay in style.' %>">
    <meta name="twitter:description" content="<%= settings.hero_subtitle_en || 'Discover trending gadgets, lamps, and everyday essentials with cash on delivery.' %>">
    <meta name="twitter:image" content="<%= settings.logo_light || 'https://trendzznow.com/images/banner.jpg' %>">

    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <% if (settings.facebook_pixel) { %>
    <!-- Fixed Official Facebook Pixel Code -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(t);t.async=!0;
      t.src=v;s=b.getElementsByTagName(t)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '<%= settings.facebook_pixel %>');
      fbq('track', 'PageView');
    </script>
    <% } %>
</head>
<body>
    <!-- Top Notice Banner -->
    <div class="banner-notice">
        <span class="en-text"><%= settings.banner_text || '🚚 Free Home Delivery on Featured Items | Cash on Delivery Available' %></span>
        <span class="bn-text" style="display:none;"><%= settings.banner_text_bn || '🚚 সারা বাংলাদেশে ক্যাশ অন ডেলিভারি ও দ্রুত হোম ডেলিভারি!' %></span>
    </div>

    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-container">
            <a href="/" class="logo-area">
                <% if (settings.logo_light) { %>
                    <img src="<%= settings.logo_light %>" alt="TrendzzNow" class="brand-logo">
                <% } else { %>
                    <div class="brand-badge">
                        <span class="brand-name">Trendzz<span class="accent">Now</span></span>
                        <small class="brand-sub">
                            <span class="en-text"><%= settings.tagline_en || 'Stay on trend. Stay in style.' %></span>
                            <span class="bn-text" style="display:none;"><%= settings.tagline_bn || 'ট্রেন্ডে থাকুন, স্টাইলে থাকুন' %></span>
                        </small>
                    </div>
                <% } %>
            </a>

            <!-- Search Bar -->
            <div class="search-bar-wrap">
                <input type="text" id="searchInput" placeholder="Search products..." onkeyup="filterProducts()">
                <span class="search-icon">🔍</span>
            </div>

            <nav class="nav-links">
                <a href="/" class="en-text">Home</a><a href="/" class="bn-text" style="display:none;">হোম</a>
                <a href="#products" class="en-text">Products</a><a href="#products" class="bn-text" style="display:none;">প্রোডাক্টস</a>
                <a href="#" onclick="openTrackingModal(); return false;" class="en-text">📦 Track Order</a><a href="#" onclick="openTrackingModal(); return false;" class="bn-text" style="display:none;">📦 অর্ডার ট্র্যাক</a>
                
                <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>" target="_blank" class="wa-nav-btn">
                    💬 WhatsApp
                </a>

                <!-- Language Switcher -->
                <button class="lang-toggle-btn" onclick="toggleLanguage()">
                    <span id="langLabel">বাংলা</span>
                </button>

                <a href="/admin" class="admin-link">Admin</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-inner">
            <span class="hero-pill">✨ Official Store — trendzznow.com</span>
            <h1 class="en-text"><%= settings.hero_title_en || 'Premium Lifestyle & Home Decor Collection' %></h1>
            <h1 class="bn-text" style="display:none;"><%= settings.hero_title_bn || 'প্রিমিয়াম হোম ডেকোর ও লাইফস্টাইল কালেকশন ২০২৬' %></h1>
            <p class="en-text"><%= settings.hero_subtitle_en || 'Discover trending gadgets, lamps, and everyday essentials with cash on delivery.' %></p>
            <p class="bn-text" style="display:none;"><%= settings.hero_subtitle_bn || 'আধুনিক গ্যাজেট, ল্যাম্প এবং লাইফস্টাইল পণ্য — ক্যাশ অন ডেলিভারিতে অর্ডার করুন।' %></p>
            <div class="hero-badges">
                <div class="h-badge">🚚 Courier: <%= settings.courier_partners || 'SteadFast / Pathao' %></div>
                <div class="h-badge">💳 Payment: COD / bKash / Nagad</div>
                <div class="h-badge">📞 Hotline: <%= settings.whatsapp_number || '01731763504' %></div>
            </div>
            <a href="#products" class="cta-btn en-text">Shop Collection &darr;</a>
            <a href="#products" class="cta-btn bn-text" style="display:none;">কালেকশন দেখুন &darr;</a>
        </div>
    </section>

    <!-- Products Section -->
    <main class="container" id="products">
        <div class="section-header">
            <h2 class="en-text">Featured Products</h2>
            <h2 class="bn-text" style="display:none;">আমাদের জনপ্রিয় পণ্যসমূহ</h2>
            <p class="en-text">Click "Order Now" for instant checkout or "Details" for full product specifications</p>
            <p class="bn-text" style="display:none;">সরাসরি অর্ডার করতে "অর্ডার করুন" অথবা বিস্তারিত দেখতে ছবির ওপর ক্লিক করুন</p>
        </div>

        <div class="product-grid" id="productGrid">
            <% if (products.length > 0) { %>
                <% products.forEach(p => { 
                    const hasDiscount = p.regular_price && p.regular_price > p.price;
                    const discountPct = hasDiscount ? Math.round(((p.regular_price - p.price) / p.regular_price) * 100) : 0;
                %>
                    <div class="product-card" data-title="<%= (p.title || '').toLowerCase() %>">
                        <a href="/product/<%= p.id %>" class="product-img-wrap" style="display:block; text-decoration:none;">
                            <% if (p.image) { %>
                                <img src="<%= p.image %>" alt="<%= p.title %>" class="product-img" loading="lazy">
                            <% } else { %>
                                <div class="no-img">No Image</div>
                            <% } %>
                            <span class="cod-tag">Cash on Delivery</span>
                            <% if (discountPct > 0) { %>
                                <span class="discount-badge">🔥 -<%= discountPct %>%</span>
                            <% } %>
                        </a>
                        <div class="product-info">
                            <a href="/product/<%= p.id %>" style="text-decoration:none;">
                                <h3 class="product-title"><%= p.title %></h3>
                            </a>
                            <p class="product-desc"><%= p.description ? p.description.substring(0, 75) + (p.description.length > 75 ? '...' : '') : 'Premium quality lifestyle product.' %></p>
                            
                            <% if (p.variant_options) { %>
                                <div class="variant-display">
                                    <small>🎨 Variants: <%= p.variant_options %></small>
                                </div>
                            <% } %>

                            <div class="price-action">
                                <div>
                                    <% if (hasDiscount) { %>
                                        <span class="reg-price">৳ <%= p.regular_price %></span>
                                    <% } %>
                                    <span class="price">৳ <%= p.price %></span>
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <a href="/product/<%= p.id %>" class="details-btn" title="View Full Page">
                                        <span class="en-text">Details</span><span class="bn-text" style="display:none;">বিস্তারিত</span>
                                    </a>
                                    <button type="button" class="buy-btn" 
                                        data-title="<%= p.title %>" 
                                        data-price="<%= p.price %>" 
                                        data-variants="<%= p.variant_options || '' %>"
                                        onclick="openCheckoutFromBtn(this)">
                                        🛒 <span class="en-text">Order Now</span><span class="bn-text" style="display:none;">অর্ডার করুন</span>
                                    </button>
                                </div>
                            </div>
                            <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>?text=<%= encodeURIComponent('Hello TrendzzNow, I want to order: ' + p.title + ' (Price: ৳' + p.price + ') - https://trendzznow.com/product/' + p.id) %>" target="_blank" class="wa-card-btn">
                                📱 <span class="en-text">Order via WhatsApp</span><span class="bn-text" style="display:none;">WhatsApp-এ অর্ডার করুন</span>
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <h3 class="en-text">No products available right now</h3>
                    <h3 class="bn-text" style="display:none;">বর্তমানে কোনো প্রোডাক্ট তালিকাভুক্ত নেই</h3>
                    <p class="en-text">Please check back later or contact us on WhatsApp.</p>
                    <p class="bn-text" style="display:none;">অ্যাডমিন প্যানেল থেকে নতুন প্রোডাক্ট যোগ করুন অথবা আমাদের WhatsApp-এ যোগাযোগ করুন।</p>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Customer Reviews & Trust Badges Section -->
    <section class="info-strip">
        <div class="container">
            <div class="section-header" style="margin-bottom: 22px;">
                <h2 class="en-text" style="font-size:24px;">Why Shop With TrendzzNow?</h2>
                <h2 class="bn-text" style="display:none; font-size:24px;">কেন TrendzzNow থেকে কেনাকাটা করবেন?</h2>
            </div>
            <div class="info-grid">
                <div class="info-box">
                    <h4 class="en-text">🚚 Fast Courier Delivery</h4>
                    <h4 class="bn-text" style="display:none;">🚚 দ্রুত কুরিয়ার ডেলিভারি</h4>
                    <p class="en-text">Reliable home delivery across Bangladesh via <%= settings.courier_partners || 'SteadFast & Pathao' %>.</p>
                    <p class="bn-text" style="display:none;"><%= settings.courier_partners || 'SteadFast ও Pathao' %>-এর মাধ্যমে সারা বাংলাদেশে নিরাপদ হোম ডেলিভারি।</p>
                </div>
                <div class="info-box">
                    <h4 class="en-text">💳 Pay After Checking</h4>
                    <h4 class="bn-text" style="display:none;">💳 পণ্য দেখে পেমেন্ট</h4>
                    <p class="en-text">100% Cash on Delivery upon inspection, or instant bKash & Nagad payment.</p>
                    <p class="bn-text" style="display:none;">পণ্য হাতে পেয়ে দেখে ক্যাশ অন ডেলিভারি অথবা bKash ও Nagad পেমেন্টের সুবিধা।</p>
                </div>
                <div class="info-box">
                    <h4 class="en-text">⭐ Verified Quality & Support</h4>
                    <h4 class="bn-text" style="display:none;">⭐ শতভাগ মানসম্মত পণ্য ও সাপোর্ট</h4>
                    <p class="en-text">Every item is tested before dispatch. Direct hotline: <strong><%= settings.whatsapp_number || '01731763504' %></strong></p>
                    <p class="bn-text" style="display:none;">প্রতিটি পণ্য চেক করে পাঠানো হয়। সরাসরি হটলাইন: <strong><%= settings.whatsapp_number || '01731763504' %></strong></p>
                </div>
            </div>
        </div>
    </section>

    <!-- Instant Checkout Modal (Works Directly from Home Page!) -->
    <div id="checkoutModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeCheckout()">&times;</span>
            <div class="modal-header">
                <h2 class="en-text">Confirm Your Order</h2>
                <h2 class="bn-text" style="display:none;">অর্ডার কনফার্ম করুন</h2>
                <p id="modalProductTitle" class="selected-product-banner"></p>
            </div>
            <form id="orderForm" onsubmit="submitOrder(event)">
                <input type="hidden" id="orderProductTitle" name="product_title">
                <input type="hidden" id="orderProductPrice" name="price">
                <input type="hidden" id="orderDeliveryCharge" name="delivery_charge" value="<%= settings.delivery_inside_dhaka || 70 %>">
                <input type="hidden" id="orderDiscountApplied" name="discount_applied" value="0">

                <div id="variantGroup" class="form-group" style="display:none;">
                    <label><span class="en-text">Select Variant / Color *</span><span class="bn-text" style="display:none;">কালার বা ভ্যারিয়েন্ট নির্বাচন করুন *</span></label>
                    <select id="orderVariant" name="variant"></select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label><span class="en-text">Your Name *</span><span class="bn-text" style="display:none;">আপনার নাম *</span></label>
                        <input type="text" name="customer_name" required placeholder="Full Name / পূর্ণ নাম">
                    </div>
                    <div class="form-group">
                        <label><span class="en-text">Mobile Number (11 digits) *</span><span class="bn-text" style="display:none;">মোবাইল নাম্বার (১১ ডিজিট) *</span></label>
                        <input type="tel" id="phoneInput" name="phone" required placeholder="017xxxxxxxx" pattern="01[3-9][0-9]{8}" title="Enter valid 11-digit BD mobile number (e.g. 017xxxxxxxx)">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label><span class="en-text">Quantity</span><span class="bn-text" style="display:none;">পরিমাণ</span></label>
                        <input type="number" id="orderQty" name="quantity" value="1" min="1" max="50" onchange="updateTotal()">
                    </div>
                    <div class="form-group">
                        <label><span class="en-text">Delivery Area *</span><span class="bn-text" style="display:none;">ডেলিভারি এরিয়া *</span></label>
                        <select id="deliveryArea" name="delivery_area" onchange="updateTotal()">
                            <option value="Inside Dhaka" data-charge="<%= settings.delivery_inside_dhaka || 70 %>">Inside Dhaka / ঢাকার ভেতরে (৳ <%= settings.delivery_inside_dhaka || 70 %>)</option>
                            <option value="Outside Dhaka" data-charge="<%= settings.delivery_outside_dhaka || 130 %>">Outside Dhaka / ঢাকার বাইরে (৳ <%= settings.delivery_outside_dhaka || 130 %>)</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label><span class="en-text">Preferred Courier</span><span class="bn-text" style="display:none;">পছন্দের কুরিয়ার</span></label>
                        <select name="courier_choice">
                            <option value="SteadFast Courier">SteadFast Courier (Home Delivery)</option>
                            <option value="Pathao Courier">Pathao Courier</option>
                            <option value="RedX Courier">RedX Courier</option>
                            <option value="Sundarban Courier">Sundarban Courier</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label><span class="en-text">Payment Method *</span><span class="bn-text" style="display:none;">পেমেন্ট মেথড *</span></label>
                        <select id="paymentMethod" name="payment_method" onchange="togglePaymentDetails()">
                            <option value="Cash on Delivery (COD)">Cash on Delivery (পণ্য হাতে পেয়ে পেমেন্ট)</option>
                            <option value="bKash">bKash (বিকাশ পেমেন্ট / সেন্ড মানি)</option>
                            <option value="Nagad">Nagad (নগদ পেমেন্ট / সেন্ড মানি)</option>
                        </select>
                    </div>
                </div>

                <!-- Digital Payment Box -->
                <div id="digitalPaymentBox" class="payment-info-box" style="display: none;">
                    <p id="paymentInstructionText" style="margin: 0 0 8px 0; font-size: 13px;"></p>
                    <input type="text" id="trxIdInput" name="trx_id" placeholder="Enter Transaction ID or last 4 digits">
                </div>

                <!-- Promo Code Box -->
                <div class="form-group">
                    <label><span class="en-text">Promo / Coupon Code (Optional)</span><span class="bn-text" style="display:none;">প্রোমো / ডিসকাউন্ট কোড (যদি থাকে)</span></label>
                    <div style="display:flex; gap:8px;">
                        <input type="text" id="promoInput" placeholder="e.g. TREND50" style="flex:1;">
                        <button type="button" onclick="applyPromoCode()" style="background:#1F1B5C; color:#fff; border:none; padding:0 16px; border-radius:7px; cursor:pointer; font-weight:600;">Apply</button>
                    </div>
                    <small id="promoMessage" style="display:none; margin-top:4px; font-weight:600;"></small>
                </div>

                <div class="form-group">
                    <label><span class="en-text">Complete Delivery Address *</span><span class="bn-text" style="display:none;">সম্পূর্ণ ডেলিভারি ঠিকানা *</span></label>
                    <textarea name="address" rows="2" required placeholder="House/Holding, Road, Area, Thana & District / বাসা, রোড, এলাকা, থানা ও জেলা"></textarea>
                </div>

                <div class="order-summary-box">
                    <div class="summary-line"><span><span class="en-text">Product Total:</span><span class="bn-text" style="display:none;">পণ্যের মূল্য:</span></span> <span id="sumProductPrice">৳ 0</span></div>
                    <div class="summary-line"><span><span class="en-text">Delivery Charge:</span><span class="bn-text" style="display:none;">ডেলিভারি চার্জ:</span></span> <span id="sumDeliveryCharge">৳ <%= settings.delivery_inside_dhaka || 70 %></span></div>
                    <div class="summary-line" id="discountRow" style="display:none; color:#00b894; font-weight:600;"><span>Discount:</span> <span id="sumDiscount">-৳ 0</span></div>
                    <div class="summary-line total-line"><span><span class="en-text">Total Payable:</span><span class="bn-text" style="display:none;">সর্বমোট বিল:</span></span> <span id="sumTotalBill">৳ 0</span></div>
                </div>

                <button type="submit" id="submitBtn" class="submit-order-btn">
                    ✅ <span class="en-text">Confirm Order</span><span class="bn-text" style="display:none;">অর্ডার কনফার্ম করুন</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Order Tracking Modal -->
    <div id="trackingModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeTrackingModal()">&times;</span>
            <h2>📦 <span class="en-text">Track Your Order</span><span class="bn-text" style="display:none;">আপনার অর্ডার ট্র্যাক করুন</span></h2>
            <p style="font-size: 13px; color: #666; margin-bottom: 15px;">
                <span class="en-text">Enter your mobile number to check live order status:</span>
                <span class="bn-text" style="display:none;">অর্ডারের বর্তমান অবস্থা জানতে আপনার মোবাইল নাম্বার দিন:</span>
            </p>
            <div class="form-group">
                <input type="tel" id="trackPhone" placeholder="017xxxxxxxx" style="margin-bottom: 10px;">
                <button type="button" class="submit-order-btn" onclick="fetchOrdersByPhone()">🔍 <span class="en-text">Search Orders</span><span class="bn-text" style="display:none;">অর্ডার খুঁজুন</span></button>
            </div>
            <div id="trackingResultContainer" style="margin-top: 15px; max-height: 250px; overflow-y: auto;"></div>
        </div>
    </div>

    <!-- Floating WhatsApp Desktop -->
    <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>?text=<%= encodeURIComponent('Hello TrendzzNow, I am contacting you from your website.') %>" target="_blank" class="floating-wa">
        <span>💬 WhatsApp Chat</span>
    </a>

    <!-- Sticky Mobile Bottom Bar -->
    <div class="mobile-bottom-bar">
        <a href="#products" class="m-bar-btn m-shop">🛍️ <span class="en-text">Products</span><span class="bn-text" style="display:none;">প্রোডাক্টস</span></a>
        <a href="#" onclick="openTrackingModal(); return false;" class="m-bar-btn m-track">📦 <span class="en-text">Track</span><span class="bn-text" style="display:none;">ট্র্যাকিং</span></a>
        <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>" target="_blank" class="m-bar-btn m-wa">💬 WhatsApp</a>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <h3>TrendzzNow</h3>
                <p class="en-text"><%= settings.tagline_en || 'Stay on trend. Stay in style.' %></p>
                <p class="bn-text" style="display:none;"><%= settings.tagline_bn || 'ট্রেন্ডে থাকুন, স্টাইলে থাকুন' %></p>
                <p>🌐 www.trendzznow.com</p>
            </div>
            <div>
                <h4 class="en-text">Support & Payment</h4><h4 class="bn-text" style="display:none;">সাপোর্ট ও পেমেন্ট</h4>
                <p>📞 WhatsApp / Call: <strong><%= settings.whatsapp_number || '01731763504' %></strong></p>
                <p>💳 bKash / Nagad: <%= settings.bkash_number || '01731763504' %></p>
                <p>🚚 Courier: <%= settings.courier_partners || 'SteadFast, Pathao, RedX' %></p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 TrendzzNow (trendzznow.com). All rights reserved.</p>
        </div>
    </footer>

    <script>
        let currentBasePrice = 0;
        let currentDiscount = 0;
        let currentLang = localStorage.getItem('trendzz_lang') || 'en';
        const bkashNum = "<%= settings.bkash_number || '01731763504' %>";
        const nagadNum = "<%= settings.nagad_number || '01731763504' %>";
        const validPromoCode = ("<%= settings.promo_code || 'TREND50' %>").trim().toUpperCase();
        const validPromoDiscount = parseFloat("<%= settings.promo_discount || '50' %>") || 0;

        function applyLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('trendzz_lang', lang);
            document.getElementById('htmlRoot').setAttribute('lang', lang);
            document.getElementById('langLabel').innerText = lang === 'en' ? 'বাংলা' : 'English';

            const enEls = document.querySelectorAll('.en-text');
            const bnEls = document.querySelectorAll('.bn-text');

            if (lang === 'bn') {
                enEls.forEach(el => el.style.display = 'none');
                bnEls.forEach(el => el.style.display = 'inline-block');
            } else {
                enEls.forEach(el => el.style.display = 'inline-block');
                bnEls.forEach(el => el.style.display = 'none');
            }
        }

        function toggleLanguage() {
            applyLanguage(currentLang === 'en' ? 'bn' : 'en');
        }

        // Initialize language on load
        applyLanguage(currentLang);

        function filterProducts() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.product-card');
            cards.forEach(card => {
                const title = card.getAttribute('data-title');
                card.style.display = title.includes(query) ? 'flex' : 'none';
            });
        }

        function openCheckoutFromBtn(btn) {
            const title = btn.getAttribute('data-title');
            const price = btn.getAttribute('data-price');
            const variants = btn.getAttribute('data-variants');
            openCheckout(title, price, variants);
        }

        function openCheckout(title, price, variants) {
            currentBasePrice = parseFloat(price) || 0;
            currentDiscount = 0;
            document.getElementById('orderDiscountApplied').value = 0;
            document.getElementById('promoInput').value = '';
            document.getElementById('promoMessage').style.display = 'none';
            document.getElementById('discountRow').style.display = 'none';

            document.getElementById('modalProductTitle').innerText = (currentLang === 'en' ? 'Product: ' : 'পণ্য: ') + title + ' (৳ ' + currentBasePrice + ')';
            document.getElementById('orderProductTitle').value = title;
            document.getElementById('orderProductPrice').value = currentBasePrice;
            document.getElementById('orderQty').value = 1;

            const variantGroup = document.getElementById('variantGroup');
            const variantSelect = document.getElementById('orderVariant');
            variantSelect.innerHTML = '';
            if (variants && variants.trim() !== '') {
                variants.split(',').forEach(v => {
                    if (v.trim()) {
                        const opt = document.createElement('option');
                        opt.value = v.trim();
                        opt.innerText = v.trim();
                        variantSelect.appendChild(opt);
                    }
                });
                variantGroup.style.display = 'block';
            } else {
                variantGroup.style.display = 'none';
            }

            updateTotal();
            document.getElementById('checkoutModal').style.display = 'block';
        }

        function closeCheckout() {
            document.getElementById('checkoutModal').style.display = 'none';
        }

        function applyPromoCode() {
            const input = document.getElementById('promoInput').value.trim().toUpperCase();
            const msgEl = document.getElementById('promoMessage');
            if (input && input === validPromoCode) {
                currentDiscount = validPromoDiscount;
                document.getElementById('orderDiscountApplied').value = currentDiscount;
                document.getElementById('discountRow').style.display = 'flex';
                document.getElementById('sumDiscount').innerText = '-৳ ' + currentDiscount;
                msgEl.style.display = 'block';
                msgEl.style.color = '#00b894';
                msgEl.innerText = '🎉 Promo applied! ৳' + currentDiscount + ' discount added.';
                updateTotal();
            } else {
                currentDiscount = 0;
                document.getElementById('orderDiscountApplied').value = 0;
                document.getElementById('discountRow').style.display = 'none';
                msgEl.style.display = 'block';
                msgEl.style.color = '#d63031';
                msgEl.innerText = '❌ Invalid promo code.';
                updateTotal();
            }
        }

        function updateTotal() {
            const qty = parseInt(document.getElementById('orderQty').value) || 1;
            const areaSelect = document.getElementById('deliveryArea');
            const selectedOption = areaSelect.options[areaSelect.selectedIndex];
            const deliveryCharge = parseFloat(selectedOption.getAttribute('data-charge')) || 0;

            const productTotal = currentBasePrice * qty;
            const grandTotal = Math.max(0, productTotal + deliveryCharge - currentDiscount);

            document.getElementById('orderDeliveryCharge').value = deliveryCharge;
            document.getElementById('sumProductPrice').innerText = '৳ ' + productTotal;
            document.getElementById('sumDeliveryCharge').innerText = '৳ ' + deliveryCharge;
            document.getElementById('sumTotalBill').innerText = '৳ ' + grandTotal;
        }

        function togglePaymentDetails() {
            const method = document.getElementById('paymentMethod').value;
            const box = document.getElementById('digitalPaymentBox');
            const text = document.getElementById('paymentInstructionText');
            const trxInput = document.getElementById('trxIdInput');

            if (method === 'bKash') {
                box.style.display = 'block';
                text.innerHTML = '📲 Send Money to our <strong>bKash Number: ' + bkashNum + '</strong> and enter Transaction ID or last 4 digits below:';
                trxInput.required = true;
            } else if (method === 'Nagad') {
                box.style.display = 'block';
                text.innerHTML = '📲 Send Money to our <strong>Nagad Number: ' + nagadNum + '</strong> and enter Transaction ID or last 4 digits below:';
                trxInput.required = true;
            } else {
                box.style.display = 'none';
                trxInput.required = false;
                trxInput.value = '';
            }
        }

        async function submitOrder(e) {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = 'Processing Order...';

            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/order/place', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.success) {
                    if (typeof fbq === 'function') {
                        fbq('track', 'Purchase', { value: currentBasePrice, currency: 'BDT' });
                    }
                    alert(currentLang === 'bn' ? '🎉 ধন্যবাদ! আপনার অর্ডারটি সফলভাবে গৃহীত হয়েছে। আমরা শীঘ্রই কল করে কনফার্ম করব।' : '🎉 Thank you! Your order has been placed successfully. We will call you soon to confirm.');
                    closeCheckout();
                    e.target.reset();
                    togglePaymentDetails();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (err) {
                alert('Failed to place order. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerText = currentLang === 'bn' ? '✅ অর্ডার কনফার্ম করুন' : '✅ Confirm Order';
            }
        }

        function openTrackingModal() {
            document.getElementById('trackingModal').style.display = 'block';
        }

        function closeTrackingModal() {
            document.getElementById('trackingModal').style.display = 'none';
        }

        async function fetchOrdersByPhone() {
            const phone = document.getElementById('trackPhone').value.trim();
            const container = document.getElementById('trackingResultContainer');
            if (!phone) {
                alert('Please enter a phone number.');
                return;
            }
            container.innerHTML = '<p>Searching orders...</p>';
            try {
                const res = await fetch('/order/track?phone=' + encodeURIComponent(phone));
                const data = await res.json();
                if (data.success && data.orders.length > 0) {
                    let html = '<table style="width:100%; border-collapse:collapse; font-size:13px;">';
                    html += '<tr style="background:#f1f3f5;"><th style="padding:6px;border:1px solid #ddd;">Date</th><th style="padding:6px;border:1px solid #ddd;">Product</th><th style="padding:6px;border:1px solid #ddd;">Status</th></tr>';
                    data.orders.forEach(o => {
                        const dateStr = o.created_at ? new Date(o.created_at).toLocaleDateString() : '-';
                        html += `<tr><td style="padding:6px;border:1px solid #ddd;">${dateStr}</td><td style="padding:6px;border:1px solid #ddd;">${o.product_title}<br><strong>৳${o.price}</strong></td><td style="padding:6px;border:1px solid #ddd;"><strong>${o.status || 'Pending'}</strong></td></tr>`;
                    });
                    html += '</table>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p style="color:#d63031;">No orders found for this phone number.</p>';
                }
            } catch (err) {
                container.innerHTML = '<p style="color:#d63031;">Error fetching order status.</p>';
            }
        }

        window.onclick = function(event) {
            const modal = document.getElementById('checkoutModal');
            const trackingModal = document.getElementById('trackingModal');
            if (event.target === modal) closeCheckout();
            if (event.target === trackingModal) closeTrackingModal();
        }
    </script>
</body>
</html>
