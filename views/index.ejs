<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.site_title || 'TrendzzNow - Stay on trend. Stay in style.' %></title>
    <meta name="description" content="<%= (settings.meta_description || settings.hero_subtitle_en || 'Stay on trend. Stay in style. Just trending products delivered to your door.').slice(0, 160) %>">
    <meta name="twitter:card" content="summary_large_image">
    <%- include('partials/seo-extra', { settings: settings }) %>
    <script type="application/ld+json"><%- safeJson({ '@context': 'https://schema.org', '@graph': [
        { '@type': 'Organization', name: (settings.brand_name_first || 'Trendzz') + (settings.brand_name_second || 'Now'), url: 'https://trendzznow.com/', logo: settings.logo_light || undefined, sameAs: [settings.social_facebook, settings.social_instagram, settings.social_tiktok].filter(Boolean) },
        { '@type': 'WebSite', name: (settings.brand_name_first || 'Trendzz') + (settings.brand_name_second || 'Now'), url: 'https://trendzznow.com/' }
    ] }) %></script>
    <link rel="canonical" href="https://trendzznow.com/">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#1F1B5C">
    <meta property="og:title" content="<%= settings.site_title || 'TrendzzNow - Stay on trend. Stay in style.' %>">
    <meta property="og:description" content="<%= settings.hero_subtitle_en || 'Stay on trend. Stay in style. Just trending products delivered to your door.' %>">
    <meta property="og:image" content="<%= settings.hero_image || settings.logo_light || 'https://trendzznow.com/images/banner.jpg' %>">
    <meta property="og:url" content="https://trendzznow.com">
    <meta property="og:type" content="website">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/theme.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <% if (settings.facebook_pixel) { %>
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(t);t.async=!0;
      t.src=v;s=b.getElementsByTagName(t)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '<%= settings.facebook_pixel %>');
      fbq('track', 'PageView');
    </script>
    <% } %>
</head>
<body>
    <div class="banner-notice">
        <span class="en-text"><%= settings.banner_text || '⚡ Only Viral & Trending Products | 100% Cash on Delivery Across Bangladesh' %></span>
        <span class="bn-text" style="display:none;"><%= settings.banner_text_bn || '⚡ শুধুমাত্র সেরা ট্রেন্ডিং প্রোডাক্ট | সারা বাংলাদেশে ক্যাশ অন ডেলিভারি!' %></span>
    </div>

    <% 
        let categories = ['All'];
        const subCategoryMap = {};
        products.forEach(p => {
            const c = p.category || 'Trending';
            if (!categories.includes(c)) categories.push(c);
            if (p.subcategory) {
                if (!subCategoryMap[c]) subCategoryMap[c] = [];
                if (!subCategoryMap[c].includes(p.subcategory)) subCategoryMap[c].push(p.subcategory);
            }
        });
    %>

    <!-- Professional Sticky Header (No Admin Links Exposed) -->
    <header class="navbar glass-nav">
        <div class="nav-container">
            <div class="nav-left-group">
                <button type="button" class="menu-drawer-btn" onclick="toggleMenuDrawer()" aria-label="Open Navigation Menu">
                    <span></span><span></span><span></span>
                </button>

                <a href="/" class="logo-area">
                    <% if (settings.logo_light) { %>
                        <img src="<%= settings.logo_light %>" alt="<%= (settings.brand_name_first || 'Trendzz') + (settings.brand_name_second || 'Now') %>" class="brand-logo">
                    <% } else { %>
                        <div class="brand-logo-icon">⚡</div>
                    <% } %>
                    <div class="brand-badge">
                        <span class="brand-name"><%= settings.brand_name_first || 'Trendzz' %><span class="accent"><%= settings.brand_name_second || 'Now' %></span></span>
                        <small class="brand-sub">
                            <span class="en-text"><%= settings.tagline_en || 'Stay on trend. Stay in style.' %></span>
                            <span class="bn-text" style="display:none;"><%= settings.tagline_bn || 'ট্রেন্ডে থাকুন, স্টাইলে থাকুন' %></span>
                        </small>
                    </div>
                </a>
            </div>

            <div class="search-bar-wrap">
                <input type="text" id="searchInput" placeholder="Search products, SKU, or category..." oninput="applyCatalogFilters()" aria-label="Search Products">
                <span class="search-icon">🔍</span>
            </div>

            <nav class="nav-links">
                <a href="#products" class="desktop-only-link en-text">Shop</a>
                <a href="#products" class="desktop-only-link bn-text" style="display:none;">শপ</a>
                <a href="#faq" class="desktop-only-link en-text">FAQ</a>
                <a href="#faq" class="desktop-only-link bn-text" style="display:none;">প্রশ্নোত্তর</a>
                <button type="button" class="track-header-btn" onclick="openTrackingModal()">
                    📦 <span class="en-text">Track</span><span class="bn-text" style="display:none;">ট্র্যাক</span>
                </button>
                <button type="button" class="cart-trigger-btn" onclick="toggleCartDrawer()" aria-label="Shopping Cart">
                    🛒 <span class="cart-badge-count" id="cartCountBadge">0</span>
                </button>
                <button type="button" class="lang-toggle-btn" onclick="toggleLanguage()"><span id="langLabel">বাংলা</span></button>
            </nav>
        </div>
    </header>

    <!-- Slide-out Navigation Drawer (Top-Left) -->
    <div id="menuDrawerOverlay" class="drawer-overlay" onclick="toggleMenuDrawer()"></div>
    <aside id="menuDrawer" class="menu-drawer" aria-label="Mobile Navigation">
        <div class="drawer-header">
            <span class="brand-name" style="font-size:21px;"><%= settings.brand_name_first || 'Trendzz' %><span class="accent"><%= settings.brand_name_second || 'Now' %></span></span>
            <button type="button" class="drawer-close" onclick="toggleMenuDrawer()" aria-label="Close Menu">&times;</button>
        </div>
        <div class="drawer-body">
            <div class="drawer-section-title">Store Navigation</div>
            <a href="/" onclick="toggleMenuDrawer()">🏠 Home / হোম</a>
            <a href="#products" onclick="toggleMenuDrawer()">🔥 All Products / সকল পণ্য</a>
            <a href="#" onclick="openTrackingModal(); toggleMenuDrawer(); return false;">📦 Track Your Order / অর্ডার ট্র্যাক</a>
            <a href="#" onclick="toggleCartDrawer(); toggleMenuDrawer(); return false;">🛒 View Cart / শপিং কার্ট</a>

            <div class="drawer-section-title" style="margin-top:18px;">Product Categories</div>
            <% categories.forEach(cat => { %>
                <a href="#products" onclick="selectCategoryFromDrawer('<%= cat %>'); return false;">📂 <%= cat %></a>
            <% }) %>

            <div class="drawer-section-title" style="margin-top:18px;">Customer Support & Policies</div>
            <a href="#faq" onclick="toggleMenuDrawer()">❓ FAQ / সাধারণ জিজ্ঞাসা</a>
            <a href="#" onclick="openPolicyModal('privacy'); toggleMenuDrawer(); return false;">🔒 Privacy Policy</a>
            <a href="#" onclick="openPolicyModal('return'); toggleMenuDrawer(); return false;">🔄 Return & Replacement Policy</a>
            <a href="#" onclick="openPolicyModal('terms'); toggleMenuDrawer(); return false;">📜 Terms & Conditions</a>
            <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>" target="_blank" onclick="toggleMenuDrawer()" style="color:#128C7E;">💬 WhatsApp Hotline (<%= settings.whatsapp_number || '01731763504' %>)</a>
        </div>
    </aside>

    <!-- Slide-out Shopping Cart Drawer (Right) -->
    <div id="cartDrawerOverlay" class="drawer-overlay" onclick="toggleCartDrawer()"></div>
    <aside id="cartDrawer" class="cart-drawer" aria-label="Shopping Cart">
        <div class="drawer-header">
            <h3 style="margin:0; font-size:18px; color:#1F1B5C;">🛒 Your Shopping Cart</h3>
            <button type="button" class="drawer-close" onclick="toggleCartDrawer()" aria-label="Close Cart">&times;</button>
        </div>
        <div id="cartItemsContainer" class="cart-items-list"></div>
        <div class="cart-drawer-footer">
            <div class="cart-subtotal-row">
                <span>Subtotal:</span>
                <strong id="cartDrawerSubtotal">৳ 0</strong>
            </div>
            <button type="button" class="submit-order-btn shimmer-btn" onclick="proceedCartToCheckout()">⚡ Proceed to Checkout</button>
            <button type="button" class="clear-cart-btn" onclick="clearCart()">Clear Cart</button>
        </div>
    </aside>

    <!-- Aurora Mesh Split Hero Section (Stacks Vertically on Mobile) -->
    <section class="hero-aurora">
        <div class="aurora-orb orb-1"></div>
        <div class="aurora-orb orb-2"></div>
        <div class="hero-split-container">
            <div class="hero-left">
                <div class="glass-pill">✨ <%= settings.tagline_en || 'Stay on trend. Stay in style.' %></div>
                <h1 class="en-text"><%= settings.hero_title_en || 'Just Trending Products — Curated for You' %></h1>
                <h1 class="bn-text" style="display:none;"><%= settings.hero_title_bn || 'শুধুমাত্র সেরা ট্রেন্ডিং প্রোডাক্ট কালেকশন' %></h1>
                <p class="en-text"><%= settings.hero_subtitle_en || 'Stay on trend. Stay in style. Handpicked viral gadgets & modern essentials delivered straight to your doorstep.' %></p>
                <p class="bn-text" style="display:none;"><%= settings.hero_subtitle_bn || 'ট্রেন্ডে থাকুন, স্টাইলে থাকুন। বাছাইকৃত সেরা ভাইরাল গ্যাজেট ও আধুনিক পণ্য পান ক্যাশ অন ডেলিভারিতে।' %></p>
                
                <div class="hero-cta-row">
                    <a href="#products" class="glow-cta-btn en-text">🔥 Explore Collection &darr;</a>
                    <a href="#products" class="glow-cta-btn bn-text" style="display:none;">🔥 কালেকশন দেখুন &darr;</a>
                    <button type="button" onclick="openTrackingModal()" class="glass-sec-btn en-text">📦 Track Order</button>
                    <button type="button" onclick="openTrackingModal()" class="glass-sec-btn bn-text" style="display:none;">📦 অর্ডার ট্র্যাক</button>
                </div>

                <div class="hero-glass-stats">
                    <div class="g-stat"><strong>100%</strong><span>Open-Box COD</span></div>
                    <div class="g-stat"><strong>24–48h</strong><span>Fast Dispatch</span></div>
                    <div class="g-stat"><strong>৳<%= settings.delivery_inside_dhaka || 70 %></strong><span>Inside Dhaka</span></div>
                </div>
            </div>

            <div class="hero-right">
                <% 
                    const spotlightImg = settings.hero_image || (products.length > 0 && products[0].image ? products[0].image : '');
                    const spotlightTitle = settings.hero_featured_title || (products.length > 0 ? products[0].title : 'Trending Spotlight');
                    const spotlightPrice = settings.hero_featured_price || (products.length > 0 ? '৳ ' + products[0].price : 'Hot Deal');
                    const spotlightUrl = settings.hero_featured_link || (products.length > 0 ? products[0].url : '#products');
                %>
                <div class="hero-3d-showcase tilt-card" data-tilt-max="12">
                    <div class="tilt-glare"></div>
                    <span class="spotlight-tag"><%= settings.hero_badge_text || '🔥 Trending Spotlight' %></span>
                    <a href="<%= spotlightUrl %>" class="spotlight-img-box">
                        <% if (spotlightImg) { %>
                            <img src="<%= spotlightImg %>" alt="<%= spotlightTitle %>" class="spotlight-img">
                        <% } else { %>
                            <div class="spotlight-placeholder">
                                <span style="font-size:48px;">⚡</span>
                                <p>TrendzzNow Featured</p>
                            </div>
                        <% } %>
                    </a>
                    <div class="spotlight-footer">
                        <div>
                            <h4><%= spotlightTitle %></h4>
                            <span class="spotlight-price"><%= spotlightPrice %></span>
                        </div>
                        <a href="<%= spotlightUrl %>" class="spotlight-buy-pill">View &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="trust-strip" aria-label="Why shop with us">
        <div class="trust-strip-inner">
            <div class="trust-item"><div class="trust-ico">💵</div><div><strong><span class="en-text">Cash on Delivery</span><span class="bn-text">ক্যাশ অন ডেলিভারি</span></strong><span class="t-sub"><span class="en-text">Open the parcel before you pay</span><span class="bn-text">পার্সেল দেখে টাকা দিন</span></span></div></div>
            <div class="trust-item"><div class="trust-ico">🚚</div><div><strong><span class="en-text">Fast Delivery</span><span class="bn-text">দ্রুত ডেলিভারি</span></strong><span class="t-sub"><span class="en-text">24 to 48 hours inside Dhaka</span><span class="bn-text">ঢাকায় ২৪ থেকে ৪৮ ঘণ্টা</span></span></div></div>
            <div class="trust-item"><div class="trust-ico">🔄</div><div><strong><span class="en-text">7 Day Replacement</span><span class="bn-text">৭ দিনে রিপ্লেসমেন্ট</span></strong><span class="t-sub"><span class="en-text">Damaged or wrong item? We fix it</span><span class="bn-text">ভুল বা নষ্ট পণ্য বদলে দিই</span></span></div></div>
            <div class="trust-item"><div class="trust-ico">💬</div><div><strong><span class="en-text">WhatsApp Support</span><span class="bn-text">হোয়াটসঅ্যাপ সাপোর্ট</span></strong><span class="t-sub"><span class="en-text">Real people, quick replies</span><span class="bn-text">দ্রুত উত্তর পাবেন</span></span></div></div>
        </div>
    </section>

    <!-- Main Product Discovery & Responsive Catalog -->
    <main class="container" id="products">
        <div class="section-header">
            <span class="sub-pill">🛍️ VERIFIED CATALOG</span>
            <h2 class="en-text">Trending & Popular Products</h2>
            <h2 class="bn-text" style="display:none;">আমাদের ট্রেন্ডিং ও জনপ্রিয় পণ্যসমূহ</h2>
            <p class="en-text">Filter by category, price range, or sort order • Add to Cart or Order Now with Cash on Delivery</p>
            <p class="bn-text" style="display:none;">ক্যাটাগরি বা দাম অনুযায়ী ফিল্টার করুন • কার্টে যোগ করুন অথবা সরাসরি ক্যাশ অন ডেলিভারিতে অর্ডার করুন</p>
        </div>

        <!-- Category & Subcategory Filter Bar + Sort & Max Price Controls -->
        <div class="discovery-toolbar">
            <div class="category-tabs-bar" id="categoryTabs">
                <% categories.forEach((cat, idx) => { %>
                    <button type="button" class="cat-tab-btn <%= idx === 0 ? 'active' : '' %>" data-cat="<%= cat %>" onclick="filterByCategory('<%= cat %>', this)"><%= cat %></button>
                <% }) %>
            </div>

            <div class="filter-controls-row">
                <div class="filter-item">
                    <label for="sortSelect" class="en-text">Sort By:</label>
                    <label for="sortSelect" class="bn-text" style="display:none;">সাজান:</label>
                    <select id="sortSelect" onchange="applyCatalogFilters()">
                        <option value="newest">Newest Arrivals</option>
                        <option value="popular">Most Popular (Real Sales)</option>
                        <option value="price_asc">Price: Low to High</option>
                        <option value="price_desc">Price: High to Low</option>
                    </select>
                </div>

                <div class="filter-item">
                    <label for="priceRangeInput">Max Price: <strong id="priceRangeLabel">All</strong></label>
                    <input type="range" id="priceRangeInput" min="100" max="10000" step="50" value="10000" oninput="updatePriceFilterLabel(this.value)">
                </div>

                <div class="filter-item">
                    <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                        <input type="checkbox" id="inStockOnlyChk" onchange="applyCatalogFilters()">
                        <span class="en-text">In Stock Only</span>
                        <span class="bn-text" style="display:none;">শুধু স্টকে থাকা পণ্য</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Responsive Product Grid (1 col mobile, 2 col tablet, 3-4 col desktop) -->
        <div class="product-grid" id="productGrid">
            <% if (products.length > 0) { %>
                <% products.forEach((p, idx) => { 
                    const hasDiscount = p.regular_price && p.regular_price > p.price;
                    const discountPct = hasDiscount ? Math.round(((p.regular_price - p.price) / p.regular_price) * 100) : 0;
                    const prodCat = p.category || 'Trending';
                    const realOrdersCount = productSalesCount[p.title] || 0;
                    const inStock = p.stock_quantity > 0;
                %>
                    <article class="product-card tilt-card" 
                        data-tilt-max="8" 
                        data-id="<%= p.id %>"
                        data-category="<%= prodCat %>" 
                        data-subcategory="<%= p.subcategory || '' %>"
                        data-title="<%= (p.title || '').toLowerCase() %>"
                        data-sku="<%= (p.sku || '').toLowerCase() %>"
                        data-price="<%= p.price %>"
                        data-sales="<%= realOrdersCount %>"
                        data-stock="<%= p.stock_quantity %>">
                        <div class="tilt-glare"></div>

                        <div class="product-img-wrap">
                            <a href="<%= p.url %>" style="display:block; width:100%; height:100%;">
                                <% if (p.image) { %>
                                    <img src="<%= p.image %>" alt="<%= p.title %>" class="product-img" loading="lazy">
                                <% } else { %>
                                    <div class="no-img">No Image</div>
                                <% } %>
                            </a>
                            <span class="cod-tag glass-badge">🛡️ COD</span>
                            <% if (discountPct > 0) { %>
                                <span class="discount-badge">🔥 -<%= discountPct %>%</span>
                            <% } %>
                            <% if (realOrdersCount > 0) { %>
                                <span class="trending-sales-pill">⚡ <%= realOrdersCount %> Sold</span>
                            <% } %>
                            <button type="button" class="card-wish-btn" data-wish="<%= p.id %>" onclick="toggleWish(<%= p.id %>, this)" title="Save to wishlist" aria-label="Save to wishlist">♡</button>
                            <button type="button" class="card-share-btn" onclick="shareProduct('<%= p.id %>', '<%= (p.title || '').replace(/'/g, '') %>')" title="Share or Copy Link" aria-label="Share Product">🔗</button>
                        </div>

                        <div class="product-info">
                            <div class="card-meta-top">
                                <span class="cat-pill-mini"><%= prodCat %><%= p.subcategory ? ' • ' + p.subcategory : '' %></span>
                                <span class="stock-pill-mini <%= inStock ? 'in-stk' : 'out-stk' %>">
                                    <%= inStock ? `✓ In Stock (${p.stock_quantity})` : 'Out of Stock' %>
                                </span>
                            </div>

                            <a href="<%= p.url %>" style="text-decoration:none;">
                                <h3 class="product-title"><%= p.title %></h3>
                            </a>
                            <% const rs = (typeof ratingStats !== 'undefined' && ratingStats) ? ratingStats[String(p.id)] : null; %>
                            <% if (rs) { %><a href="<%= p.url %>#reviews" class="card-rating" style="text-decoration:none;">★ <%= rs.avg.toFixed(1) %> <small>(<%= rs.count %>)</small></a><% } %>

                            <p class="product-desc"><%= p.description ? p.description.substring(0, 80) + (p.description.length > 80 ? '...' : '') : 'Authentic quality product available with Cash on Delivery.' %></p>

                            <% if (p.variant_options) { %>
                                <div class="variant-display"><small>🎨 Options: <%= p.variant_options %></small></div>
                            <% } %>

                            <div class="price-row-block">
                                <div>
                                    <% if (hasDiscount) { %>
                                        <span class="reg-price">৳ <%= p.regular_price %></span>
                                    <% } %>
                                    <span class="price">৳ <%= p.price %></span>
                                </div>
                                <small class="sku-label">SKU: <%= p.sku %></small>
                            </div>

                            <div class="card-actions-grid">
                                <a href="<%= p.url %>" class="details-btn">
                                    <span class="en-text">Details</span><span class="bn-text" style="display:none;">বিস্তারিত</span>
                                </a>
                                <button type="button" class="add-cart-btn" <%= !inStock ? 'disabled' : '' %> onclick="addToCart('<%= p.id %>')">
                                    + <span class="en-text">Cart</span><span class="bn-text" style="display:none;">কার্ট</span>
                                </button>
                                <button type="button" class="buy-btn shimmer-btn" <%= !inStock ? 'disabled' : '' %> onclick="openCheckoutById('<%= p.id %>')">
                                    🛒 <span class="en-text">Order Now</span><span class="bn-text" style="display:none;">অর্ডার</span>
                                </button>
                            </div>

                            <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>?text=<%= encodeURIComponent('Hello TrendzzNow, I want to order: ' + p.title + ' (SKU: ' + p.sku + ', Price: ৳' + p.price + ') - https://trendzznow.com/product/' + p.id) %>" target="_blank" class="wa-card-btn">
                                💬 <span class="en-text">Order via WhatsApp</span><span class="bn-text" style="display:none;">WhatsApp-এ অর্ডার</span>
                            </a>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <h3 class="en-text">No products currently listed</h3>
                    <h3 class="bn-text" style="display:none;">বর্তমানে কোনো প্রোডাক্ট তালিকাভুক্ত নেই</h3>
                    <p class="en-text">Please check back shortly for our new arrivals.</p>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Single Preserved FAQ Section Immediately Above the Footer -->
    <section class="faq-section" id="faq">
        <div class="container" style="max-width: 860px;">
            <div class="section-header">
                <h2 class="en-text">Frequently Asked Questions (FAQ)</h2>
                <h2 class="bn-text" style="display:none;">সাধারণ জিজ্ঞাসা (FAQ)</h2>
                <p class="en-text">Everything you need to know about ordering, delivery & returns</p>
