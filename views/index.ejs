    <div id="toastNotice" class="toast-notice"></div>

    <script>
        function esc(s) { return String(s === undefined || s === null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }
        const storeProductsMap = <%- safeJson(products.reduce((acc, item) => { acc[item.id] = { id: item.id, title: item.title, price: item.price, image: item.image, sku: item.sku, stock: item.stock_quantity, category: item.category || 'Trending', variant_options: item.variant_options || '', free_delivery: !!item.free_delivery }; return acc; }, {})) %>;
        let currentBasePrice = 0;
        let currentDiscount = 0;
        let activeCategory = 'All';
        let isCartCheckout = false;
        let currentFreeDelivery = false;
        const FREE_SHIP_MIN = parseFloat("<%= settings.free_shipping_threshold || 0 %>") || 0;
        let cart = JSON.parse(localStorage.getItem('trendzz_cart_v22') || '[]');
        let currentLang = localStorage.getItem('trendzz_lang') || 'en';
        const bkashNum = "<%= settings.bkash_number || '01731763504' %>";
        const nagadNum = "<%= settings.nagad_number || '01731763504' %>";
        const validPromoCode = ("<%= settings.promo_code || 'TREND50' %>").trim().toUpperCase();
        const validPromoDiscount = parseFloat("<%= settings.promo_discount || '50' %>") || 0;

        function showToast(msg) {
            const t = document.getElementById('toastNotice');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2800);
        }

        function toggleMenuDrawer() {
            document.getElementById('menuDrawer').classList.toggle('open');
            document.getElementById('menuDrawerOverlay').classList.toggle('open');
        }

        function toggleCartDrawer() {
            document.getElementById('cartDrawer').classList.toggle('open');
            document.getElementById('cartDrawerOverlay').classList.toggle('open');
            renderCart();
        }

        function saveCart() {
            localStorage.setItem('trendzz_cart_v22', JSON.stringify(cart));
            const count = cart.reduce((sum, i) => sum + i.quantity, 0);
            document.getElementById('cartCountBadge').innerText = count;
            const mCount = document.getElementById('mobileCartCount');
            if (mCount) mCount.innerText = count;
        }

        function addToCart(id) {
            const p = storeProductsMap[id];
            if (!p) return;
            const existing = cart.find(i => String(i.id) === String(id));
            if (existing) {
                if (existing.quantity < p.stock) existing.quantity += 1;
            } else {
                cart.push({ id: p.id, title: p.title, price: p.price, image: p.image, quantity: 1, variant: p.variant_options ? p.variant_options.split(',')[0].trim() : '' });
            }
            saveCart();
            renderCart();
            showToast(`🛒 "${p.title}" added to cart!`);
        }

        function updateCartQty(idx, delta) {
            if (!cart[idx]) return;
            cart[idx].quantity += delta;
            if (cart[idx].quantity <= 0) cart.splice(idx, 1);
            saveCart();
            renderCart();
        }

        function clearCart() {
            cart = [];
            saveCart();
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cartItemsContainer');
            const subEl = document.getElementById('cartDrawerSubtotal');
            if (cart.length === 0) {
                container.innerHTML = '<p style="text-align:center; color:#666; padding:30px 10px;">Your cart is empty.</p>';
                subEl.innerText = '৳ 0';
                return;
            }
            let subtotal = 0;
            let html = '';
            cart.forEach((item, idx) => {
                const lineTotal = item.price * item.quantity;
                subtotal += lineTotal;
                html += `
                    <div class="cart-item-row">
                        <div class="cart-item-info">
                            <strong>${esc(item.title)}</strong>
                            <small>৳ ${item.price} × ${item.quantity} = <strong>৳ ${lineTotal}</strong></small>
                        </div>
                        <div class="cart-qty-controls">
                            <button type="button" onclick="updateCartQty(${idx}, -1)">-</button>
                            <span>${item.quantity}</span>
                            <button type="button" onclick="updateCartQty(${idx}, 1)">+</button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
            subEl.innerText = '৳ ' + subtotal;
        }
        saveCart();

        function proceedCartToCheckout() {
            if (cart.length === 0) return alert('Your cart is empty!');
            toggleCartDrawer();
            isCartCheckout = true;
            const subtotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
            currentFreeDelivery = cart.every(i => storeProductsMap[i.id] && storeProductsMap[i.id].free_delivery);
            currentBasePrice = subtotal;
            currentDiscount = 0; appliedCoupon = null;
            document.getElementById('orderPromoCode').value = '';
            document.getElementById('promoInput').value = '';
            document.getElementById('promoMessage').style.display = 'none';
            document.getElementById('discountRow').style.display = 'none';

            const summaryTitle = cart.map(i => `${i.title} (x${i.quantity})`).join(', ');
            document.getElementById('modalProductTitle').innerText = `Cart Items (${cart.length}): ${summaryTitle}`;
            document.getElementById('orderProductId').value = '';
            document.getElementById('orderProductTitle').value = summaryTitle;
            document.getElementById('orderProductPrice').value = subtotal;
            document.getElementById('orderCartItems').value = JSON.stringify(cart);
            document.getElementById('singleQtyGroup').style.display = 'none';
            document.getElementById('variantGroup').style.display = 'none';
            updateTotal();
            document.getElementById('checkoutModal').style.display = 'block';
        }

        function selectCategoryFromDrawer(cat) {
            toggleMenuDrawer();
            const btn = document.querySelector(`.cat-tab-btn[data-cat="${cat}"]`);
            if (btn) filterByCategory(cat, btn);
        }

        function filterByCategory(cat, btn) {
            activeCategory = cat;
            document.querySelectorAll('.cat-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            applyCatalogFilters();
        }

        function updatePriceFilterLabel(val) {
            document.getElementById('priceRangeLabel').innerText = Number(val) >= 10000 ? 'All' : '৳ ' + val;
            applyCatalogFilters();
        }

        function applyCatalogFilters() {
            const query = (document.getElementById('searchInput').value || '').toLowerCase().trim();
            const maxPrice = parseFloat(document.getElementById('priceRangeInput').value) || 10000;
            const inStockOnly = document.getElementById('inStockOnlyChk').checked;
            const sortMode = document.getElementById('sortSelect').value;

            const grid = document.getElementById('productGrid');
            const cards = Array.from(grid.querySelectorAll('.product-card'));

            cards.forEach(card => {
                const cCat = card.getAttribute('data-category');
                const cTitle = card.getAttribute('data-title') || '';
                const cSku = card.getAttribute('data-sku') || '';
                const cPrice = parseFloat(card.getAttribute('data-price')) || 0;
                const cStock = parseInt(card.getAttribute('data-stock'), 10) || 0;

                const matchCat = (activeCategory === 'All' || cCat === activeCategory);
                const matchQuery = !query || cTitle.includes(query) || cSku.includes(query) || cCat.toLowerCase().includes(query);
                const matchPrice = maxPrice >= 10000 || cPrice <= maxPrice;
                const matchStock = !inStockOnly || cStock > 0;

                card.style.display = (matchCat && matchQuery && matchPrice && matchStock) ? 'flex' : 'none';
            });

            cards.sort((a, b) => {
                const pa = parseFloat(a.getAttribute('data-price')) || 0;
                const pb = parseFloat(b.getAttribute('data-price')) || 0;
                const sa = parseInt(a.getAttribute('data-sales'), 10) || 0;
                const sb = parseInt(b.getAttribute('data-sales'), 10) || 0;
                const ida = parseInt(a.getAttribute('data-id'), 10) || 0;
                const idb = parseInt(b.getAttribute('data-id'), 10) || 0;
                if (sortMode === 'price_asc') return pa - pb;
                if (sortMode === 'price_desc') return pb - pa;
                if (sortMode === 'popular') return sb - sa;
                return idb - ida;
            });

            cards.forEach(c => grid.appendChild(c));
        }

        async function shareProduct(id, title) {
            const shareUrl = `https://trendzznow.com/product/${id}`;
            fetch('/api/share-track', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ product_id: id, platform: navigator.share ? 'web_share' : 'copy_link' })
            }).catch(() => {});

            if (navigator.share) {
                try {
                    await navigator.share({ title: `${title} | TrendzzNow`, url: shareUrl });
                    return;
                } catch (e) {}
            }
            navigator.clipboard.writeText(shareUrl).then(() => {
                showToast('🔗 Product link copied to clipboard!');
            });
        }

        function init3DTilt() {
            if (window.innerWidth < 768) return;
            const cards = document.querySelectorAll('.tilt-card');
            cards.forEach(card => {
                const maxTilt = parseFloat(card.getAttribute('data-tilt-max')) || 8;
                const glare = card.querySelector('.tilt-glare');

                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const centerX = rect.width / 2;
                    const centerY = rect.height / 2;

                    const rotateX = ((y - centerY) / centerY) * -maxTilt;
                    const rotateY = ((x - centerX) / centerX) * maxTilt;

                    card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;

                    if (glare) {
                        const glareX = (x / rect.width) * 100;
                        const glareY = (y / rect.height) * 100;
                        glare.style.opacity = '1';
                        glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255,255,255,0.28), transparent 65%)`;
                    }
                });

                card.addEventListener('mouseleave', () => {
                    card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
                    if (glare) glare.style.opacity = '0';
                });
            });
        }
        init3DTilt();

        const policiesData = {
            privacy: { title: "🔒 Privacy Policy", body: <%- safeJson(settings.privacy_policy || '') %> },
            return: { title: "🔄 Return & Replacement Policy", body: <%- safeJson(settings.return_policy || '') %> },
            terms: { title: "📜 Terms & Conditions", body: <%- safeJson(settings.terms_conditions || '') %> }
        };

        function openPolicyModal(type) {
            const p = policiesData[type];
            if (!p) return;
            document.getElementById('policyModalTitle').innerText = p.title;
            document.getElementById('policyModalBody').innerText = p.body;
            document.getElementById('policyModal').style.display = 'block';
        }
        function closePolicyModal() { document.getElementById('policyModal').style.display = 'none'; }

        function toggleFaq(btn) { btn.parentElement.classList.toggle('active'); }

        function applyLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('trendzz_lang', lang);
            document.getElementById('htmlRoot').setAttribute('lang', lang);
            document.getElementById('langLabel').innerText = lang === 'en' ? 'বাংলা' : 'English';
            const enEls = document.querySelectorAll('.en-text');
            const bnEls = document.querySelectorAll('.bn-text');
            if (lang === 'bn') {
                enEls.forEach(el => el.style.display = 'none');
                bnEls.forEach(el => el.style.display = 'inline-block');
            } else {
                enEls.forEach(el => el.style.display = 'inline-block');
                bnEls.forEach(el => el.style.display = 'none');
            }
        }
        function toggleLanguage() { applyLanguage(currentLang === 'en' ? 'bn' : 'en'); }
        applyLanguage(currentLang);

        function openCheckoutById(id) {
            const prod = storeProductsMap[id];
            if (!prod) return;
            isCartCheckout = false;
            currentFreeDelivery = !!prod.free_delivery;
            document.getElementById('orderCartItems').value = '';
            document.getElementById('orderProductId').value = prod.id;
            document.getElementById('singleQtyGroup').style.display = 'block';
            openCheckout(prod.title, prod.price, prod.variant_options);
        }

        function openCheckout(title, price, variants) {
            currentBasePrice = parseFloat(price) || 0;
            currentDiscount = 0; appliedCoupon = null;
            document.getElementById('orderPromoCode').value = '';
            document.getElementById('promoInput').value = '';
            document.getElementById('promoMessage').style.display = 'none';
            document.getElementById('discountRow').style.display = 'none';
            document.getElementById('modalProductTitle').innerText = 'Product: ' + title + ' (৳ ' + currentBasePrice + ')';
            document.getElementById('orderProductTitle').value = title;
            document.getElementById('orderProductPrice').value = currentBasePrice;
            document.getElementById('orderQty').value = 1;

            const variantGroup = document.getElementById('variantGroup');
            const variantSelect = document.getElementById('orderVariant');
            variantSelect.innerHTML = '';
            if (variants && variants.trim() !== '') {
                variants.split(',').forEach(v => {
                    if (v.trim()) {
                        const opt = document.createElement('option');
                        opt.value = v.trim();
                        opt.innerText = v.trim();
                        variantSelect.appendChild(opt);
                    }
                });
                variantGroup.style.display = 'block';
            } else {
                variantGroup.style.display = 'none';
            }
            updateTotal();
            document.getElementById('checkoutModal').style.display = 'block';
        }

        function closeCheckout() { document.getElementById('checkoutModal').style.display = 'none'; }

        let appliedCoupon = null;
        function couponAmount(sub) {
            if (!appliedCoupon || sub < appliedCoupon.min_order) return 0;
            const raw = appliedCoupon.type === 'percent' ? Math.round(sub * appliedCoupon.value / 100) : appliedCoupon.value;
            return Math.min(Math.max(0, raw), sub);
        }
        async function applyPromoCode() {
            const input = document.getElementById('promoInput').value.trim().toUpperCase();
            const msgEl = document.getElementById('promoMessage');
            const qty = isCartCheckout ? 1 : (parseInt(document.getElementById('orderQty').value, 10) || 1);
            msgEl.style.display = 'block';
            msgEl.style.color = '#64748b';
            msgEl.innerText = 'Checking...';
            let r = { valid: false, message: 'Could not check the coupon. Try again.' };
            try {
                const res = await fetch('/api/coupon/validate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: input, subtotal: currentBasePrice * qty }) });
                r = await res.json();
            } catch (e) {}
            if (r.valid) {
                appliedCoupon = r;
                document.getElementById('orderPromoCode').value = r.code;
                document.getElementById('discountRow').style.display = 'flex';
                msgEl.style.color = '#00b894';
                msgEl.innerText = 'Coupon applied: ' + (r.type === 'percent' ? r.value + '% off' : '৳' + r.value + ' off');
            } else {
                appliedCoupon = null;
                currentDiscount = 0; appliedCoupon = null;
                document.getElementById('orderPromoCode').value = '';
                document.getElementById('discountRow').style.display = 'none';
                msgEl.style.color = '#d63031';
                msgEl.innerText = r.message || 'Invalid coupon code.';
            }
            updateTotal();
        }

        function updateTotal() {
            const qty = isCartCheckout ? 1 : (parseInt(document.getElementById('orderQty').value, 10) || 1);
            const areaSelect = document.getElementById('deliveryArea');
            const productTotal = currentBasePrice * qty;
            let deliveryCharge = parseFloat(areaSelect.options[areaSelect.selectedIndex].getAttribute('data-charge')) || 0;
            if (currentFreeDelivery || (FREE_SHIP_MIN > 0 && productTotal >= FREE_SHIP_MIN)) deliveryCharge = 0;
            currentDiscount = couponAmount(productTotal);
            document.getElementById('sumDiscount').innerText = '-৳ ' + currentDiscount;
            const grandTotal = Math.max(0, productTotal + deliveryCharge - currentDiscount);
            document.getElementById('sumProductPrice').innerText = '৳ ' + productTotal;
            document.getElementById('sumDeliveryCharge').innerText = '৳ ' + deliveryCharge;
            document.getElementById('sumTotalBill').innerText = '৳ ' + grandTotal;
        }

        function togglePaymentDetails() {
            const method = document.getElementById('paymentMethod').value;
            const box = document.getElementById('digitalPaymentBox');
            const text = document.getElementById('paymentInstructionText');
            const trxInput = document.getElementById('trxIdInput');
            if (method === 'bKash') {
                box.style.display = 'block';
                text.innerHTML = '📲 Send Money to <strong>bKash: ' + bkashNum + '</strong> & enter TrxID/Last 4 digits:';
                trxInput.required = true;
            } else if (method === 'Nagad') {
                box.style.display = 'block';
                text.innerHTML = '📲 Send Money to <strong>Nagad: ' + nagadNum + '</strong> & enter TrxID/Last 4 digits:';
                trxInput.required = true;
            } else {
                box.style.display = 'none';
                trxInput.required = false;
                trxInput.value = '';
            }
        }

        async function submitOrder(e) {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = 'Processing...';
            const data = Object.fromEntries(new FormData(e.target).entries());
            try {
                const res = await fetch('/order/place', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.success) {
                    if (isCartCheckout) clearCart();
                    alert('🎉 Thank you! Order #' + result.orderId + ' (৳' + result.totalAmount + ') placed successfully!');
                    closeCheckout();
                    e.target.reset();
                    togglePaymentDetails();
                } else {
                    alert('Order Error: ' + result.message);
                }
            } catch (err) {
                alert('Network error while placing order. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerText = '✅ Confirm Order';
            }
        }

        function openTrackingModal() { document.getElementById('trackingModal').style.display = 'block'; }
        function closeTrackingModal() { document.getElementById('trackingModal').style.display = 'none'; }

        async function fetchOrdersByPhone() {
            const phone = document.getElementById('trackPhone').value.trim();
            const orderId = document.getElementById('trackOrderId').value.trim();
            const container = document.getElementById('trackingResultContainer');
            if (!phone) return alert('Please enter your mobile number');
            container.innerHTML = '<p>Verifying & searching orders...</p>';
            try {
                const res = await fetch(`/order/track?phone=${encodeURIComponent(phone)}&order_id=${encodeURIComponent(orderId)}`);
                const data = await res.json();
                if (data.success && data.orders.length > 0) {
                    let html = '<table style="width:100%; border-collapse:collapse; font-size:13px;"><tr style="background:#f1f3f5;"><th style="padding:8px;border:1px solid #ddd;">Order ID</th><th style="padding:8px;border:1px solid #ddd;">Product</th><th style="padding:8px;border:1px solid #ddd;">Status & Tracking</th></tr>';
                    data.orders.forEach(o => {
                        const cId = o.consignment_id ? `<br><small style="color:#0984e3;">Tracking: ${esc(o.consignment_id)}</small>` : '';
                        html += `<tr><td style="padding:8px;border:1px solid #ddd;"><strong>#${o.id}</strong><br><small>${o.created_at ? new Date(o.created_at).toLocaleDateString() : '-'}</small></td><td style="padding:8px;border:1px solid #ddd;">${esc(o.product_title)}<br><strong>৳${o.price}</strong></td><td style="padding:8px;border:1px solid #ddd;"><span style="background:#eef2ff;color:#1F1B5C;padding:3px 8px;border-radius:12px;font-weight:700;">${esc(o.status || 'Pending')}</span>${cId}</td></tr>`;
                    });
                    html += '</table>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p style="color:#d63031;">No matching orders found for this mobile number.</p>';
                }
            } catch (err) {
                container.innerHTML = '<p style="color:#d63031;">Error fetching orders.</p>';
            }
        }

        function toggleAiChat() {
            const box = document.getElementById('aiChatBox');
            if (!box) return;
            box.style.display = box.style.display === 'none' ? 'flex' : 'none';
        }

        async function sendAiMessage(e) {
            e.preventDefault();
            const input = document.getElementById('aiInputText');
            const msg = input.value.trim();
            if (!msg) return;
            const list = document.getElementById('aiChatMessages');
            list.innerHTML += `<div class="ai-msg user">${esc(msg)}</div>`;
            input.value = '';
            list.scrollTop = list.scrollHeight;
            try {
                const res = await fetch('/api/ai-support', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg, lang: currentLang })
                });
                const data = await res.json();
                list.innerHTML += `<div class="ai-msg bot">${esc(data.reply)}</div>`;
                list.scrollTop = list.scrollHeight;
            } catch (err) {
                list.innerHTML += `<div class="ai-msg bot">Please contact our WhatsApp support at 01731763504.</div>`;
            }
        }

        const urlParams = new URLSearchParams(window.location.search);
        const autoTrackPhone = urlParams.get('track');
        if (autoTrackPhone) {
            document.getElementById('trackPhone').value = autoTrackPhone;
            openTrackingModal();
            fetchOrdersByPhone();
        }

        window.onclick = function(e) {
            if (e.target === document.getElementById('checkoutModal')) closeCheckout();
            if (e.target === document.getElementById('trackingModal')) closeTrackingModal();
            if (e.target === document.getElementById('policyModal')) closePolicyModal();
        }
    </script>
    <button type="button" id="wishFab" class="wish-fab" onclick="toggleWishFilter()" style="display:none;">♥ Wishlist <span id="wishCount">0</span></button>
    <script>
        (function () {
            var KEY = 'trendzz_wishlist';
            function load() { try { var a = JSON.parse(localStorage.getItem(KEY) || '[]'); return Array.isArray(a) ? a.map(String) : []; } catch (e) { return []; } }
            function save(a) { try { localStorage.setItem(KEY, JSON.stringify(a)); } catch (e) {} }
            var onlyWish = false;
            function paint() {
                var list = load();
                document.querySelectorAll('.card-wish-btn').forEach(function (b) {
                    var on = list.indexOf(String(b.getAttribute('data-wish'))) > -1;
                    b.textContent = on ? '♥' : '♡';
                    b.classList.toggle('active', on);
                });
                document.querySelectorAll('.product-card').forEach(function (c) {
                    var hide = onlyWish && list.indexOf(String(c.getAttribute('data-id'))) === -1;
                    c.classList.toggle('wish-hidden', hide);
                });
                var fab = document.getElementById('wishFab');
                if (fab) {
                    document.getElementById('wishCount').textContent = list.length;
                    fab.style.display = list.length || onlyWish ? 'flex' : 'none';
                    fab.classList.toggle('active', onlyWish);
                }
            }
            window.toggleWish = function (id, btn) {
                var list = load(); var k = String(id); var i = list.indexOf(k);
                if (i > -1) list.splice(i, 1); else list.push(k);
                save(list);
                if (!list.length) onlyWish = false;
                paint();
            };
            window.toggleWishFilter = function () { onlyWish = !onlyWish; paint(); };
            document.addEventListener('DOMContentLoaded', paint);
        })();
    </script>
</body>
</html>
