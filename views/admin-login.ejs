<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - TrendzzNow</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="login-body">
    <div class="login-card">
        <div class="login-header">
            <span class="brand-name" style="color:#9c1448; font-size:28px;">Trendzz<span style="color:#1F1B5C;">Now</span></span>
            <h3>Admin Panel Login</h3>
            <p>Enter your password to access the control panel</p>
        </div>

        <% if (error) { %>
            <div class="error-msg">⚠️ <%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label>Admin Password</label>
                <input type="password" name="password" placeholder="Enter admin123" required autofocus>
            </div>
            <button type="submit" class="login-btn">🔐 Login</button>
        </form>

        <div class="login-hint">
            💡 <strong>Password:</strong> Use <code>admin123</code> to log in immediately.
        </div>

        <p style="text-align: center; margin-top: 18px;">
            <a href="/" style="color: #9c1448; font-weight: 600; text-decoration: none;">&larr; Return to Website</a>
        </p>
    </div>
</body>
</html>
