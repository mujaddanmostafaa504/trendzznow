<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> | TrendzzNow</title>
    <link rel="canonical" href="https://trendzznow.com/product/<%= product.id %>">
    
    <!-- Dynamic Open Graph Meta Tags for Specific Product -->
    <meta property="og:title" content="<%= product.title %> - ৳<%= product.price %> | TrendzzNow">
    <meta property="og:description" content="<%= product.description || 'Order premium lifestyle product with cash on delivery across Bangladesh.' %>">
    <meta property="og:image" content="<%= product.image || settings.logo_light || 'https://trendzznow.com/images/banner.jpg' %>">
    <meta property="og:url" content="https://trendzznow.com/product/<%= product.id %>">
    <meta property="og:type" content="product">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= product.title %> - TrendzzNow">
    <meta name="twitter:description" content="<%= product.description || 'Order premium lifestyle product with cash on delivery.' %>">
    <meta name="twitter:image" content="<%= product.image || settings.logo_light || 'https://trendzznow.com/images/banner.jpg' %>">

    <!-- Safe Product Schema Markup (JSON-LD) for Google Rich Snippets -->
    <script type="application/ld+json">
    <%- JSON.stringify({
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": product.title || "Product",
      "image": product.image ? [product.image] : [],
      "description": product.description || "Premium quality product from TrendzzNow.",
      "brand": {
        "@type": "Brand",
        "name": "TrendzzNow"
      },
      "offers": {
        "@type": "Offer",
        "url": "https://trendzznow.com/product/" + product.id,
        "priceCurrency": "BDT",
        "price": String(product.price || 0),
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/InStock"
      }
    }) %>
    </script>

    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">

    <% if (settings.facebook_pixel) { %>
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(t);t.async=!0;
      t.src=v;s=b.getElementsByTagName(t)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '<%= settings.facebook_pixel %>');
      fbq('track', 'PageView');
      fbq('track', 'ViewContent', {
        content_name: "<%= (product.title || '').replace(/"/g, '\\"') %>",
        content_ids: ["<%= product.id %>"],
        content_type: 'product',
        value: <%= parseFloat(product.price) || 0 %>,
        currency: 'BDT'
      });
    </script>
    <% } %>
</head>
<body>
    <!-- Top Notice Banner -->
    <div class="banner-notice">
        <span class="en-text">🚚 Cash on Delivery Available across Bangladesh | Hotline: <%= settings.whatsapp_number || '01731763504' %></span>
        <span class="bn-text" style="display:none;">🚚 সারা বাংলাদেশে ক্যাশ অন ডেলিভারি | হটলাইন: <%= settings.whatsapp_number || '01731763504' %></span>
    </div>

    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-container">
            <a href="/" class="logo-area">
                <% if (settings.logo_light) { %>
                    <img src="<%= settings.logo_light %>" alt="TrendzzNow" class="brand-logo">
                <% } else { %>
                    <div class="brand-badge">
                        <span class="brand-name">Trendzz<span class="accent">Now</span></span>
                        <small class="brand-sub">Official Store</small>
                    </div>
                <% } %>
            </a>
            <nav class="nav-links">
                <a href="/"><span class="en-text">Home</span><span class="bn-text" style="display:none;">হোম</span></a>
                <a href="/#products"><span class="en-text">All Products</span><span class="bn-text" style="display:none;">সকল প্রোডাক্ট</span></a>
                <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>" target="_blank" class="wa-nav-btn">
                    💬 WhatsApp
                </a>
                <button class="lang-toggle-btn" onclick="toggleLanguage()">
                    <span id="langLabel">বাংলা</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Breadcrumb -->
    <div class="breadcrumb-bar">
        <div class="container" style="margin: 0 auto; padding: 10px 20px; font-size: 13px; color: #555;">
            <a href="/" style="color:#9c1448; text-decoration:none;"><span class="en-text">Home</span><span class="bn-text" style="display:none;">হোম</span></a> &gt; 
            <a href="/#products" style="color:#9c1448; text-decoration:none;"><span class="en-text">Products</span><span class="bn-text" style="display:none;">প্রোডাক্টস</span></a> &gt; 
            <span><%= product.title %></span>
        </div>
    </div>

    <!-- Product Detail Section -->
    <main class="container product-detail-container">
        <div class="product-detail-grid">
            <!-- Left: Image -->
            <div class="product-detail-img-wrap">
                <% if (product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.title %>" class="detail-main-img">
                <% } else { %>
                    <div class="no-img" style="height: 400px;">No Image Available</div>
                <% } %>
                <span class="cod-badge-large">
                    🛡️ <span class="en-text">100% Cash on Delivery — Check Before Paying</span>
                    <span class="bn-text" style="display:none;">১০০% ক্যাশ অন ডেলিভারি — পণ্য হাতে পেয়ে মূল্য পরিশোধ করুন</span>
                </span>
            </div>

            <!-- Right: Info & Checkout Form -->
            <div class="product-detail-info">
                <h1 class="detail-title"><%= product.title %></h1>
                
                <div class="detail-price-box">
                    <% if (product.regular_price && product.regular_price > product.price) { %>
                        <span class="detail-reg-price">৳ <%= product.regular_price %></span>
                    <% } %>
                    <span class="detail-price">৳ <%= product.price %></span>
                    <span class="stock-badge">✓ In Stock</span>
                </div>

                <div class="detail-desc-box">
                    <h3 class="en-text">Product Description:</h3>
                    <h3 class="bn-text" style="display:none;">পণ্যের বিবরণ:</h3>
                    <p style="white-space: pre-line;"><%= product.description || 'Premium quality lifestyle product sourced directly for TrendzzNow customers.' %></p>
                </div>

                <!-- Quick Order Form Box -->
                <div class="quick-order-box">
                    <h3>
                        ⚡ <span class="en-text">Place Your Order Now (Cash on Delivery)</span>
                        <span class="bn-text" style="display:none;">এখনই অর্ডার কনফার্ম করুন (ক্যাশ অন ডেলিভারি)</span>
                    </h3>
                    <form id="directOrderForm" onsubmit="submitDirectOrder(event)">
                        <input type="hidden" name="product_title" value="<%= product.title %>">
                        <input type="hidden" name="price" value="<%= product.price %>">
                        <input type="hidden" id="detailDeliveryCharge" name="delivery_charge" value="<%= settings.delivery_inside_dhaka || 70 %>">
                        <input type="hidden" id="detailDiscountApplied" name="discount_applied" value="0">

                        <% if (product.variant_options) { %>
                            <div class="form-group">
                                <label><span class="en-text">Select Variant / Color *</span><span class="bn-text" style="display:none;">কালার / ভ্যারিয়েন্ট নির্বাচন করুন *</span></label>
                                <select name="variant" required>
                                    <% product.variant_options.split(',').forEach(v => { if(v.trim()) { %>
                                        <option value="<%= v.trim() %>"><%= v.trim() %></option>
                                    <% } }) %>
                                </select>
                            </div>
                        <% } %>

                        <div class="form-row">
                            <div class="form-group">
                                <label><span class="en-text">Your Name *</span><span class="bn-text" style="display:none;">আপনার নাম *</span></label>
                                <input type="text" name="customer_name" required placeholder="Full Name / পূর্ণ নাম">
                            </div>
                            <div class="form-group">
                                <label><span class="en-text">Mobile Number (11 digits) *</span><span class="bn-text" style="display:none;">মোবাইল নাম্বার (১১ ডিজিট) *</span></label>
                                <input type="tel" name="phone" required placeholder="017xxxxxxxx" pattern="01[3-9][0-9]{8}" title="Please enter a valid 11-digit BD mobile number">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label><span class="en-text">Quantity</span><span class="bn-text" style="display:none;">পরিমাণ</span></label>
                                <input type="number" id="detailQty" name="quantity" value="1" min="1" max="50" onchange="updateDetailTotal()">
                            </div>
                            <div class="form-group">
                                <label><span class="en-text">Delivery Area *</span><span class="bn-text" style="display:none;">ডেলিভারি এরিয়া *</span></label>
                                <select id="detailDeliveryArea" name="delivery_area" onchange="updateDetailTotal()">
                                    <option value="Inside Dhaka" data-charge="<%= settings.delivery_inside_dhaka || 70 %>">Inside Dhaka / ঢাকার ভেতরে (৳ <%= settings.delivery_inside_dhaka || 70 %>)</option>
                                    <option value="Outside Dhaka" data-charge="<%= settings.delivery_outside_dhaka || 130 %>">Outside Dhaka / ঢাকার বাইরে (৳ <%= settings.delivery_outside_dhaka || 130 %>)</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label><span class="en-text">Preferred Courier</span><span class="bn-text" style="display:none;">পছন্দের কুরিয়ার</span></label>
                                <select name="courier_choice">
                                    <option value="SteadFast Courier">SteadFast Courier (Home Delivery)</option>
                                    <option value="Pathao Courier">Pathao Courier</option>
                                    <option value="RedX Courier">RedX Courier</option>
                                    <option value="Sundarban Courier">Sundarban Courier</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label><span class="en-text">Payment Method *</span><span class="bn-text" style="display:none;">পেমেন্ট মেথড *</span></label>
                                <select id="detailPaymentMethod" name="payment_method" onchange="toggleDetailPayment()">
                                    <option value="Cash on Delivery (COD)">Cash on Delivery (COD)</option>
                                    <option value="bKash">bKash (Send Money)</option>
                                    <option value="Nagad">Nagad (Send Money)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Digital Payment Box -->
                        <div id="detailDigitalBox" class="payment-info-box" style="display: none;">
                            <p style="margin: 0 0 6px 0; font-size: 13px;">📲 Send Money to <strong id="detailPayNum">01731763504</strong> and enter TrxID / Last 4 digits:</p>
                            <input type="text" id="detailTrxInput" name="trx_id" placeholder="Transaction ID / Last 4 digits">
                        </div>

                        <!-- Promo Code -->
                        <div class="form-group">
                            <label><span class="en-text">Promo Code (Optional)</span><span class="bn-text" style="display:none;">প্রোমো কোড (যদি থাকে)</span></label>
                            <div style="display:flex; gap:8px;">
                                <input type="text" id="detailPromoInput" placeholder="e.g. TREND50" style="flex:1;">
                                <button type="button" onclick="applyDetailPromo()" style="background:#1F1B5C; color:#fff; border:none; padding:0 16px; border-radius:7px; cursor:pointer; font-weight:600;">Apply</button>
                            </div>
                            <small id="detailPromoMsg" style="display:none; margin-top:4px; font-weight:600;"></small>
                        </div>

                        <div class="form-group">
                            <label><span class="en-text">Complete Delivery Address *</span><span class="bn-text" style="display:none;">সম্পূর্ণ ডেলিভারি ঠিকানা *</span></label>
                            <textarea name="address" rows="2" required placeholder="House, Road, Area, Thana & District / বাসা, রোড, এলাকা, থানা ও জেলা"></textarea>
                        </div>

                        <div class="order-summary-box">
                            <div class="summary-line"><span><span class="en-text">Product Total:</span><span class="bn-text" style="display:none;">পণ্যের মূল্য:</span></span> <span id="detailSumProduct">৳ <%= product.price %></span></div>
                            <div class="summary-line"><span><span class="en-text">Delivery Charge:</span><span class="bn-text" style="display:none;">ডেলিভারি চার্জ:</span></span> <span id="detailSumDelivery">৳ <%= settings.delivery_inside_dhaka || 70 %></span></div>
                            <div class="summary-line" id="detailDiscountRow" style="display:none; color:#00b894; font-weight:600;"><span>Discount:</span> <span id="detailSumDiscount">-৳ 0</span></div>
                            <div class="summary-line total-line"><span><span class="en-text">Total Payable:</span><span class="bn-text" style="display:none;">সর্বমোট বিল:</span></span> <span id="detailSumTotal">৳ <%= (parseFloat(product.price) || 0) + (parseFloat(settings.delivery_inside_dhaka) || 70) %></span></div>
                        </div>

                        <button type="submit" id="detailSubmitBtn" class="submit-order-btn">
                            ✅ <span class="en-text">Confirm Order (Cash on Delivery)</span><span class="bn-text" style="display:none;">অর্ডার কনফার্ম করুন</span>
                        </button>
                    </form>

                    <div style="margin-top: 15px; text-align: center;">
                        <a href="https://wa.me/88<%= (settings.whatsapp_number || '01731763504').replace(/^\+?88/, '') %>?text=<%= encodeURIComponent('Hello, I want to order: ' + product.title + ' (https://trendzznow.com/product/' + product.id + ')') %>" target="_blank" class="wa-card-btn" style="padding: 10px; font-size: 14px;">
                            📱 <span class="en-text">Order via WhatsApp Now</span><span class="bn-text" style="display:none;">WhatsApp-এ অর্ডার করুন</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <% if (relatedProducts && relatedProducts.length > 0) { %>
            <div class="related-section" style="margin-top: 60px;">
                <h3 style="color: #1F1B5C; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                    <span class="en-text">You May Also Like</span><span class="bn-text" style="display:none;">অন্যান্য জনপ্রিয় পণ্য</span>
                </h3>
                <div class="product-grid">
                    <% relatedProducts.forEach(rp => { %>
                        <div class="product-card" onclick="location.href='/product/<%= rp.id %>'" style="cursor: pointer;">
                            <div class="product-img-wrap">
                                <% if (rp.image) { %>
                                    <img src="<%= rp.image %>" alt="<%= rp.title %>" class="product-img" loading="lazy">
                                <% } else { %>
                                    <div class="no-img">No Image</div>
                                <% } %>
                                <span class="cod-tag">COD</span>
                            </div>
                            <div class="product-info">
                                <h3 class="product-title"><%= rp.title %></h3>
                                <div class="price-action">
                                    <span class="price">৳ <%= rp.price %></span>
                                    <span class="buy-btn" style="padding: 6px 12px; font-size: 12px;">View</span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <h3>TrendzzNow</h3>
                <p>Stay on trend. Stay in style.</p>
                <p>🌐 www.trendzznow.com</p>
            </div>
            <div>
                <h4>Support & Hotline</h4>
                <p>📞 WhatsApp / Call: <strong><%= settings.whatsapp_number || '01731763504' %></strong></p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 TrendzzNow. All rights reserved.</p>
        </div>
    </footer>

    <script>
        const unitPrice = parseFloat('<%= product.price %>') || 0;
        let detailDiscount = 0;
        let currentLang = localStorage.getItem('trendzz_lang') || 'en';
        const bkashNum = "<%= settings.bkash_number || '01731763504' %>";
        const nagadNum = "<%= settings.nagad_number || '01731763504' %>";
        const validPromoCode = ("<%= settings.promo_code || 'TREND50' %>").trim().toUpperCase();
        const validPromoDiscount = parseFloat("<%= settings.promo_discount || '50' %>") || 0;

        function applyLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('trendzz_lang', lang);
            document.getElementById('htmlRoot').setAttribute('lang', lang);
            document.getElementById('langLabel').innerText = lang === 'en' ? 'বাংলা' : 'English';

            const enEls = document.querySelectorAll('.en-text');
            const bnEls = document.querySelectorAll('.bn-text');

            if (lang === 'bn') {
                enEls.forEach(el => el.style.display = 'none');
                bnEls.forEach(el => el.style.display = 'inline-block');
            } else {
                enEls.forEach(el => el.style.display = 'inline-block');
                bnEls.forEach(el => el.style.display = 'none');
            }
        }

        function toggleLanguage() {
            applyLanguage(currentLang === 'en' ? 'bn' : 'en');
        }

        applyLanguage(currentLang);

        function applyDetailPromo() {
            const input = document.getElementById('detailPromoInput').value.trim().toUpperCase();
            const msgEl = document.getElementById('detailPromoMsg');
            if (input && input === validPromoCode) {
                detailDiscount = validPromoDiscount;
                document.getElementById('detailDiscountApplied').value = detailDiscount;
                document.getElementById('detailDiscountRow').style.display = 'flex';
                document.getElementById('detailSumDiscount').innerText = '-৳ ' + detailDiscount;
                msgEl.style.display = 'block';
                msgEl.style.color = '#00b894';
                msgEl.innerText = '🎉 Promo applied! ৳' + detailDiscount + ' discount added.';
                updateDetailTotal();
            } else {
                detailDiscount = 0;
                document.getElementById('detailDiscountApplied').value = 0;
                document.getElementById('detailDiscountRow').style.display = 'none';
                msgEl.style.display = 'block';
                msgEl.style.color = '#d63031';
                msgEl.innerText = '❌ Invalid promo code.';
                updateDetailTotal();
            }
        }

        function updateDetailTotal() {
            const qty = parseInt(document.getElementById('detailQty').value) || 1;
            const areaSelect = document.getElementById('detailDeliveryArea');
            const selectedOpt = areaSelect.options[areaSelect.selectedIndex];
            const dCharge = parseFloat(selectedOpt.getAttribute('data-charge')) || 0;

            const prodTotal = unitPrice * qty;
            const grandTotal = Math.max(0, prodTotal + dCharge - detailDiscount);

            document.getElementById('detailDeliveryCharge').value = dCharge;
            document.getElementById('detailSumProduct').innerText = '৳ ' + prodTotal;
            document.getElementById('detailSumDelivery').innerText = '৳ ' + dCharge;
            document.getElementById('detailSumTotal').innerText = '৳ ' + grandTotal;
        }

        function toggleDetailPayment() {
            const method = document.getElementById('detailPaymentMethod').value;
            const box = document.getElementById('detailDigitalBox');
            const payNumSpan = document.getElementById('detailPayNum');
            const trxInput = document.getElementById('detailTrxInput');

            if (method === 'bKash') {
                box.style.display = 'block';
                payNumSpan.innerText = bkashNum;
                trxInput.required = true;
            } else if (method === 'Nagad') {
                box.style.display = 'block';
                payNumSpan.innerText = nagadNum;
                trxInput.required = true;
            } else {
                box.style.display = 'none';
                trxInput.required = false;
                trxInput.value = '';
            }
        }

        async function submitDirectOrder(e) {
            e.preventDefault();
            const btn = document.getElementById('detailSubmitBtn');
            btn.disabled = true;
            btn.innerText = 'Processing Order...';

            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/order/place', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.success) {
                    if (typeof fbq === 'function') {
                        fbq('track', 'Purchase', { value: unitPrice, currency: 'BDT' });
                    }
                    alert(currentLang === 'bn' ? '🎉 ধন্যবাদ! আপনার অর্ডারটি সফলভাবে গৃহীত হয়েছে।' : '🎉 Thank you! Your order has been placed successfully. We will call you soon to confirm.');
                    e.target.reset();
                    detailDiscount = 0;
                    document.getElementById('detailDiscountRow').style.display = 'none';
                    document.getElementById('detailPromoMsg').style.display = 'none';
                    toggleDetailPayment();
                    updateDetailTotal();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (err) {
                alert('Failed to place order. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerText = currentLang === 'bn' ? '✅ অর্ডার কনফার্ম করুন' : '✅ Confirm Order (Cash on Delivery)';
            }
        }
    </script>
</body>
</html>
